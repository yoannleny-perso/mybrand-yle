---
// Full-width animated schematic of the "AI-enabled operating system":
// data foundation → semantic contract → agentic execution → decisions.
// Strokes draw in on reveal; dashed flow lines carry a slow pulse.
interface Props {
  labels?: {
    data: string;
    semantic: string;
    agents: string;
    decisions: string;
    caption: string;
  };
}

const { labels = {
  data: "DATA FOUNDATION",
  semantic: "SEMANTIC CONTRACT",
  agents: "AGENTIC EXECUTION",
  decisions: "DECISIONS",
  caption: "ONE SYSTEM · FOUR LAYERS · EVERY LAYER GOVERNED",
} } = Astro.props;
---

<div class="diagram-draw w-full" aria-hidden="true">
  <svg viewBox="0 0 1200 340" fill="none" class="w-full h-auto" preserveAspectRatio="xMidYMid meet">
    <!-- Layer 1: data foundation — grid of source nodes -->
    <g class="drift">
      <rect x="80" y="252" width="1040" height="56" rx="12" stroke="var(--ink-300)" stroke-width="1" pathLength="1" data-draw style="--draw-index: 0" />
      <g stroke="var(--ink-300)" stroke-width="1">
        <circle cx="160" cy="280" r="7" pathLength="1" data-draw style="--draw-index: 1" />
        <circle cx="230" cy="280" r="7" pathLength="1" data-draw style="--draw-index: 1" />
        <circle cx="300" cy="280" r="7" pathLength="1" data-draw style="--draw-index: 1" />
        <circle cx="370" cy="280" r="7" pathLength="1" data-draw style="--draw-index: 1" />
        <path d="M167 280 H223 M237 280 H293 M307 280 H363" pathLength="1" data-draw style="--draw-index: 2" />
      </g>
      <text x="1096" y="284" text-anchor="end" class="bp-label">{labels.data}</text>
    </g>

    <!-- Flow: data → semantic -->
    <path d="M300 252 V216" stroke="var(--signal)" stroke-width="1.25" class="flow-line" />
    <path d="M700 252 V216" stroke="var(--signal)" stroke-width="1.25" class="flow-line" />

    <!-- Layer 2: semantic contract — a thin governed bar -->
    <g class="drift-late">
      <rect x="140" y="188" width="920" height="28" rx="14" stroke="var(--signal)" stroke-width="1.25" pathLength="1" data-draw style="--draw-index: 2" />
      <text x="600" y="207" text-anchor="middle" class="bp-label bp-label--signal">{labels.semantic}</text>
    </g>

    <!-- Flow: semantic → agents -->
    <path d="M420 188 V150" stroke="var(--signal)" stroke-width="1.25" class="flow-line" />
    <path d="M780 188 V150" stroke="var(--signal)" stroke-width="1.25" class="flow-line" />

    <!-- Layer 3: agentic execution — orchestrator + agents inside a guardrail boundary -->
    <g>
      <rect x="260" y="66" width="680" height="84" rx="14" stroke="var(--ink-300)" stroke-width="1" stroke-dasharray="5 6" />
      <g stroke="var(--ink-500)" stroke-width="1" class="drift">
        <rect x="560" y="80" width="80" height="24" rx="8" pathLength="1" data-draw style="--draw-index: 4" />
        <circle cx="420" cy="126" r="9" pathLength="1" data-draw style="--draw-index: 5" />
        <circle cx="600" cy="126" r="9" pathLength="1" data-draw style="--draw-index: 5" />
        <circle cx="780" cy="126" r="9" pathLength="1" data-draw style="--draw-index: 5" />
        <path d="M578 104 L426 119 M600 104 V117 M622 104 L774 119" pathLength="1" data-draw style="--draw-index: 5" />
      </g>
      <text x="288" y="98" class="bp-label">{labels.agents}</text>
    </g>

    <!-- Flow: agents → decisions -->
    <path d="M600 66 V38" stroke="var(--signal)" stroke-width="1.25" class="flow-line" />

    <!-- Layer 4: decisions -->
    <g class="drift-late">
      <rect x="500" y="8" width="200" height="30" rx="15" stroke="var(--ink-900)" stroke-width="1.25" pathLength="1" data-draw style="--draw-index: 6" />
      <text x="600" y="28" text-anchor="middle" class="bp-label bp-label--ink">{labels.decisions}</text>
    </g>
  </svg>

  <div class="text-center mt-4">
    <span class="font-mono text-[10px] uppercase tracking-[0.14em] text-ink-500">{labels.caption}</span>
  </div>
</div>

<style>
  .bp-label {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.1em;
    fill: var(--ink-500);
  }
  .bp-label--signal { fill: var(--signal); }
  .bp-label--ink { fill: var(--ink-900); font-weight: 600; }
</style>
