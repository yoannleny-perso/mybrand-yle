---
import type { Achievement } from '../../data/achievements';
import type { AchievementLabels } from '../../data/localized-site';

interface Props { achievement: Achievement; labels: AchievementLabels; index: number; }
const { achievement, labels, index } = Astro.props;
const indexLabel = String(index + 1).padStart(2, '0');
const Tag = achievement.href ? 'a' : 'article';
const tagProps = achievement.href ? { href: achievement.href } : {};
---

<Tag {...tagProps} class="mission-row">
  <header class="mission-row__header">
    <p>{labels.evidence} / {indexLabel}</p>
    <span>{achievement.status}</span>
  </header>
  <div class="mission-row__body">
    <div>
      <p class="mission-row__type">{achievement.projectType}</p>
      <h3>{achievement.name}</h3>
    </div>
    <p class="mission-row__summary">{achievement.summary}</p>
  </div>
  <footer class="mission-row__evidence">
    <dl>
      <div><dt>{labels.sector}</dt><dd>{achievement.industry}</dd></div>
      <div><dt>{labels.context}</dt><dd>{achievement.location}</dd></div>
    </dl>
    <ul aria-label={labels.capabilities}>
      {achievement.capabilities.map((capability) => <li>{capability}</li>)}
    </ul>
  </footer>
</Tag>

<style>
  .mission-row {
    display: block;
    padding-block: clamp(1.5rem, 4vw, 3rem);
    border-top: 1px solid var(--ink-300);
    color: var(--ink-1000);
    text-decoration: none;
  }
  a.mission-row { transition: background-color var(--dur-hover) var(--ease-cinematic), padding-inline var(--dur-hover) var(--ease-cinematic); }
  a.mission-row:hover, a.mission-row:focus-visible { padding-inline: clamp(1rem, 2vw, 2rem); background: var(--paper-50); }
  .mission-row__header { display: flex; flex-wrap: wrap; gap: .75rem 2rem; justify-content: space-between; }
  .mission-row__header p, .mission-row__header span, .mission-row__type, .mission-row__evidence dt, .mission-row__evidence li {
    margin: 0;
    color: var(--ink-500);
    font-family: var(--font-mono);
    font-size: var(--t-meta-size);
    font-weight: var(--t-meta-weight);
    letter-spacing: var(--t-meta-letter);
    line-height: var(--t-meta-line);
    text-transform: uppercase;
  }
  .mission-row__body { display: grid; gap: 1.5rem; margin-top: clamp(2rem, 5vw, 4rem); }
  .mission-row__type { margin-bottom: .75rem; }
  h3 { max-width: 16ch; margin: 0; font-family: var(--font-display); font-size: var(--t-display-m-size); font-weight: var(--t-display-m-weight); letter-spacing: var(--t-display-m-letter); line-height: var(--t-display-m-line); text-wrap: balance; }
  .mission-row__summary { max-width: 40rem; margin: 0; color: var(--ink-700); font-size: var(--t-body-size); line-height: var(--t-body-line); text-wrap: pretty; }
  .mission-row__evidence { display: grid; gap: 1.5rem; margin-top: clamp(2rem, 4vw, 3rem); }
  .mission-row__evidence dl { display: flex; flex-wrap: wrap; gap: 1rem clamp(2rem, 6vw, 5rem); margin: 0; }
  .mission-row__evidence dd { margin: .35rem 0 0; color: var(--ink-900); font-size: var(--t-body-s-size); line-height: var(--t-body-s-line); }
  .mission-row__evidence ul { display: flex; flex-wrap: wrap; gap: .5rem; margin: 0; padding: 0; list-style: none; }
  .mission-row__evidence li { padding: .45rem .7rem; border: 1px solid var(--ink-100); color: var(--ink-700); }
  @media (min-width: 48rem) {
    .mission-row__body { grid-template-columns: minmax(14rem, .85fr) minmax(18rem, 1.15fr); column-gap: clamp(2rem, 7vw, 7rem); }
    .mission-row__evidence { grid-template-columns: minmax(14rem, .85fr) minmax(18rem, 1.15fr); column-gap: clamp(2rem, 7vw, 7rem); }
  }
  @media (prefers-reduced-motion: reduce) { a.mission-row { transition: none; } }
</style>
