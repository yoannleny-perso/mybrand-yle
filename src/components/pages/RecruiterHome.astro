---
import Layout from '../../layouts/Layout.astro';
import Container from '../layout/Container.astro';
import DecisionTrace from '../brand/DecisionTrace.astro';
import EvidencePanel from '../brand/EvidencePanel.astro';
import MissionRow from '../brand/MissionRow.astro';
import SceneHeading from '../brand/SceneHeading.astro';
import RecruiterHero from '../sections/RecruiterHero.astro';
import { getAchievements } from '../../data/achievements';
import { localizedPath, localizedSite, type Locale } from '../../data/localized-site';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const copy = localizedSite[locale];
const achievements = getAchievements(locale);
const pathFor = (path: string) => localizedPath(locale, path);
const achievementHeading = {
  eyebrow: copy.home.achievements.eyebrow,
  title: copy.home.achievements.heading,
  summary: copy.home.achievements.summary,
};
const proofSignals = ['change', 'intelligence', 'outcome'] as const;
const proofMetrics = copy.home.proof.metrics.map((metric, index) => ({
  ...metric,
  signal: proofSignals[index] || 'intelligence',
}));
---

<Layout title={copy.home.title} description={copy.home.description}>
  <div data-page-section="hero">
    <RecruiterHero copy={copy.home.hero} primaryHref={pathFor('/hire')} secondaryHref={pathFor('/work')} />
  </div>

  <div data-page-section="decision-trace" class="scene scene--trace">
    <Container size="wide">
      <DecisionTrace {...copy.home.hero.decisionTrace} />
    </Container>
  </div>

  <section data-page-section="achievements" id="selected-achievements" class="scene scene--paper">
    <Container>
      <SceneHeading {...achievementHeading} accent="change" />
      <div class="mission-register">
        {achievements.map((achievement, index) => (
          <MissionRow achievement={achievement} labels={copy.achievementLabels} index={index} />
        ))}
      </div>
      <a href={pathFor('/work')} class="scene-link">
        {copy.home.achievements.linkLabel}<span aria-hidden="true">→</span>
      </a>
    </Container>
  </section>

  <div data-page-section="proof" class="scene scene--proof">
    <Container size="wide">
      <EvidencePanel label={copy.home.proof.title} note={copy.home.proof.note} metrics={proofMetrics} />
    </Container>
  </div>

  <section data-page-section="capabilities" id="capabilities" class="scene scene--paper">
    <Container>
      <SceneHeading
        eyebrow={copy.home.capabilities.eyebrow}
        title={copy.home.capabilities.heading}
        summary={copy.home.capabilities.summary}
      />
      <div class="cinematic-list capability-list">
        {copy.home.capabilities.items.map((item, index) => (
          <article class="cinematic-row capability-row">
            <span class="row-index">{String(index + 1).padStart(2, '0')}</span>
            <h3>{item.mandate}</h3>
            <div>
              <p>{item.practice}</p>
              <p class="row-evidence">{copy.home.capabilities.evidenceLabel}: {item.evidence.join(' · ')}</p>
            </div>
          </article>
        ))}
      </div>
      <a href={pathFor('/capabilities')} class="scene-link">
        {copy.home.capabilities.linkLabel}<span aria-hidden="true">→</span>
      </a>
    </Container>
  </section>

  <section data-page-section="recruiter-fit" class="scene scene-dark">
    <Container>
      <SceneHeading
        eyebrow={copy.home.fit.eyebrow}
        title={copy.home.fit.heading}
        summary={copy.home.fit.summary}
        accent="outcome"
        tone="dark"
      />
      <div class="fit-grid">
        <ol>
          {copy.home.fit.items.map((item, index) => (
            <li><span>{String(index + 1).padStart(2, '0')}</span><p>{item}</p></li>
          ))}
        </ol>
        <div class="fit-actions">
          <a href={pathFor('/hire')} class="fit-action fit-action--primary">{copy.home.fit.primaryLabel}<span aria-hidden="true">↗</span></a>
          <a href={pathFor('/about')} class="fit-action">{copy.home.fit.secondaryLabel}<span aria-hidden="true">→</span></a>
        </div>
      </div>
    </Container>
  </section>

  <section data-page-section="thinking" id="thinking" class="scene scene--paper">
    <Container>
      <SceneHeading eyebrow={copy.home.thinking.eyebrow} title={copy.home.thinking.heading} />
      <div class="cinematic-list thinking-list">
        {copy.home.thinking.items.map((item, index) => (
          <a class="cinematic-row thinking-row" href={pathFor(`/insights/${item.slug}`)}>
            <span class="row-index">{String(index + 1).padStart(2, '0')}</span>
            <span class="thinking-label">{item.label}</span>
            <h3>{item.title}</h3>
            <span class="thinking-read">{copy.home.thinking.readLabel}<i aria-hidden="true">↗</i></span>
          </a>
        ))}
      </div>
      <a href={pathFor('/insights')} class="scene-link">
        {copy.home.thinking.linkLabel}<span aria-hidden="true">→</span>
      </a>
    </Container>
  </section>

  <section data-page-section="contact-close" class="scene scene--close">
    <Container>
      <div class="close-grid">
        <SceneHeading eyebrow={copy.home.close.eyebrow} title={copy.home.close.heading} accent="change" />
        <a href={pathFor('/hire')} class="close-action">{copy.home.close.cta}<span aria-hidden="true">↗</span></a>
      </div>
    </Container>
  </section>
</Layout>

<style>
  .scene { padding-block: var(--space-section); }
  .scene--trace { background: var(--paper-50); }
  .scene--paper { border-top: 1px solid var(--ink-100); background: var(--paper-0); }
  .scene--proof { padding-top: 0; background: var(--paper-0); }
  .scene-dark { overflow: clip; background: var(--ink-1000); color: var(--paper-0); }
  .mission-register, .cinematic-list { margin-top: clamp(3rem, 7vw, 6rem); }
  .scene-link {
    display: inline-flex;
    gap: 1rem;
    align-items: center;
    min-height: 2.75rem;
    margin-top: clamp(2rem, 5vw, 4rem);
    border-bottom: 1px solid currentColor;
    color: var(--ink-900);
    font-family: var(--font-mono);
    font-size: var(--t-meta-size);
    font-weight: 700;
    letter-spacing: var(--t-meta-letter);
    line-height: 1.3;
    text-decoration: none;
    text-transform: uppercase;
  }
  .scene-link:hover, .scene-link:focus-visible { color: var(--ink-1000); }
  .cinematic-list { border-top: 1px solid var(--ink-300); }
  .cinematic-row {
    min-width: 0;
    border-bottom: 1px solid var(--ink-300);
  }
  .row-index, .row-evidence, .thinking-label, .thinking-read {
    font-family: var(--font-mono);
    font-size: var(--t-meta-size);
    font-weight: var(--t-meta-weight);
    letter-spacing: var(--t-meta-letter);
    line-height: var(--t-meta-line);
    text-transform: uppercase;
  }
  .row-index { color: var(--ink-700); }
  .capability-row {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 1.25rem;
    padding-block: clamp(1.75rem, 4vw, 3rem);
  }
  .capability-row h3, .thinking-row h3 {
    max-width: 21ch;
    margin: 0;
    overflow-wrap: break-word;
    color: var(--ink-1000);
    font-family: var(--font-display);
    font-size: var(--t-headline-size);
    font-weight: 700;
    letter-spacing: var(--t-headline-letter);
    line-height: var(--t-headline-line);
    text-wrap: balance;
  }
  .capability-row p { max-width: 46rem; margin: 0; color: var(--ink-700); line-height: var(--t-body-line); }
  .capability-row .row-evidence { margin-top: 1rem; color: var(--ink-500); }
  .fit-grid { display: grid; gap: clamp(2rem, 6vw, 5rem); margin-top: clamp(3rem, 7vw, 6rem); }
  .fit-grid ol { margin: 0; padding: 0; border-top: 1px solid var(--ink-700); list-style: none; }
  .fit-grid li { display: grid; grid-template-columns: 2.5rem minmax(0, 1fr); gap: 1rem; padding-block: 1.25rem; border-bottom: 1px solid var(--ink-700); }
  .fit-grid li span { color: var(--signal-outcome); font-family: var(--font-mono); font-size: var(--t-meta-size); }
  .fit-grid li p { max-width: 42rem; margin: 0; color: var(--paper-50); font-size: var(--t-body-size); line-height: var(--t-body-line); }
  .fit-actions { display: flex; flex-wrap: wrap; gap: .75rem; align-content: start; }
  .fit-action, .close-action {
    display: inline-flex;
    gap: 1rem;
    align-items: center;
    justify-content: center;
    min-height: 3rem;
    max-width: 100%;
    padding: .8rem 1.35rem;
    border: 1px solid var(--ink-700);
    color: var(--paper-0);
    font-family: var(--font-mono);
    font-size: var(--t-meta-size);
    font-weight: 700;
    letter-spacing: var(--t-meta-letter);
    line-height: 1.3;
    text-align: center;
    text-decoration: none;
    text-transform: uppercase;
  }
  .fit-action--primary { border-color: var(--paper-0); background: var(--paper-0); color: var(--ink-1000); }
  .thinking-row {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 1rem;
    padding-block: clamp(1.75rem, 4vw, 3rem);
    color: inherit;
    text-decoration: none;
  }
  .thinking-label { color: var(--ink-500); }
  .thinking-read { display: inline-flex; gap: .75rem; align-items: center; color: var(--ink-700); }
  .thinking-read i { font-style: normal; }
  .thinking-row:hover h3, .thinking-row:focus-visible h3 { color: var(--signal-intelligence); }
  .scene--close { border-top: 1px solid var(--ink-300); background: var(--paper-50); }
  .close-grid { display: grid; gap: 2.5rem; }
  .close-action { width: fit-content; border-color: var(--ink-1000); background: var(--ink-1000); }
  @media (min-width: 44rem) {
    .capability-row { grid-template-columns: 3rem minmax(12rem, .8fr) minmax(16rem, 1.2fr); gap: clamp(1.5rem, 4vw, 4rem); }
    .thinking-row { grid-template-columns: 3rem minmax(8rem, .65fr) minmax(15rem, 1.35fr) auto; gap: clamp(1.25rem, 3vw, 3rem); align-items: start; }
    .thinking-read { justify-self: end; }
  }
  @media (min-width: 56rem) {
    .fit-grid { grid-template-columns: minmax(0, 1.35fr) minmax(15rem, .65fr); }
    .close-grid { grid-template-columns: minmax(0, 1fr) auto; align-items: end; }
    .close-action { margin-bottom: .35rem; }
  }
  @media (max-width: 32rem) {
    .fit-action, .close-action { width: 100%; }
  }
</style>
