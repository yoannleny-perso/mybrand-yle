---
import Layout from '../../layouts/Layout.astro';
import Container from '../layout/Container.astro';
import CinematicIntro from '../brand/CinematicIntro.astro';
import MissionRow from '../brand/MissionRow.astro';
import SceneHeading from '../brand/SceneHeading.astro';
import { getAchievements } from '../../data/achievements';
import { localizedPath, localizedSite, type Locale } from '../../data/localized-site';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const copy = localizedSite[locale];
const achievements = getAchievements(locale);
const pathFor = (path: string) => localizedPath(locale, path);
---

<Layout title={copy.work.title} description={copy.work.description}>
  <section data-page-section="work-intro" class="work-intro">
    <Container size="wide">
      <CinematicIntro
        eyebrow={copy.work.intro.eyebrow}
        title={copy.work.intro.heading}
        summary={copy.work.intro.summary}
        accent="change"
      />
    </Container>
  </section>

  <section data-page-section="achievement-register" id="achievement-register" class="work-scene work-scene--register">
    <Container>
      <SceneHeading
        eyebrow={copy.work.register.eyebrow}
        title={copy.work.register.heading}
        summary={copy.work.register.summary}
        accent="change"
      />
      <div class="mission-register">
        {achievements.map((achievement, index) => (
          <MissionRow achievement={achievement} labels={copy.achievementLabels} index={index} />
        ))}
      </div>
    </Container>
  </section>

  <section data-page-section="supporting-cases" id="supporting-cases" class="work-scene work-scene--supporting">
    <Container>
      <SceneHeading
        eyebrow={copy.achievementLabels.evidence}
        title={copy.work.supporting.heading}
        summary={copy.work.supporting.summary}
        accent="intelligence"
      />
      <div class="supporting-register">
        {copy.work.supporting.cards.map((card, index) => (
          <a class="supporting-row" href={pathFor(`/work/${card.slug}`)}>
            <span class="supporting-row__index">{String(index + 1).padStart(2, '0')}</span>
            <div class="supporting-row__title">
              <p>{card.tag}</p>
              <h3>{card.title}</h3>
            </div>
            <div class="supporting-row__evidence">
              <p>{card.description}</p>
              <dl>
                {card.metrics.map((metric) => (
                  <div><dt>{metric.label}</dt><dd>{metric.value}</dd></div>
                ))}
              </dl>
            </div>
            <span class="supporting-row__arrow" aria-hidden="true">↗</span>
          </a>
        ))}
      </div>
    </Container>
  </section>

  <section data-page-section="work-close" class="work-close">
    <Container>
      <div class="work-close__grid">
        <h2>{copy.work.close.heading}</h2>
        <a href={pathFor('/hire')}>
          {copy.work.close.cta}<span aria-hidden="true">↗</span>
        </a>
      </div>
    </Container>
  </section>
</Layout>

<style>
  .work-intro { border-bottom: 1px solid var(--ink-100); background: var(--paper-0); }
  .work-scene { padding-block: var(--space-section); }
  .work-scene--register { background: var(--paper-0); }
  .work-scene--supporting { border-top: 1px solid var(--ink-100); background: var(--paper-50); }
  .mission-register, .supporting-register { margin-top: clamp(3rem, 7vw, 6rem); }
  .supporting-register { border-top: 1px solid var(--ink-300); }
  .supporting-row {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 1.25rem;
    padding-block: clamp(1.75rem, 4vw, 3rem);
    border-bottom: 1px solid var(--ink-300);
    color: var(--ink-1000);
    text-decoration: none;
  }
  .supporting-row__index, .supporting-row__title > p, .supporting-row dt {
    margin: 0;
    color: var(--ink-500);
    font-family: var(--font-mono);
    font-size: var(--t-meta-size);
    font-weight: var(--t-meta-weight);
    letter-spacing: var(--t-meta-letter);
    line-height: var(--t-meta-line);
    text-transform: uppercase;
  }
  .supporting-row h3 {
    max-width: 18ch;
    margin: .75rem 0 0;
    font-family: var(--font-display);
    font-size: var(--t-headline-size);
    font-weight: 700;
    letter-spacing: var(--t-headline-letter);
    line-height: var(--t-headline-line);
    text-wrap: balance;
  }
  .supporting-row__evidence > p { max-width: 44rem; margin: 0; color: var(--ink-700); line-height: var(--t-body-line); text-wrap: pretty; }
  .supporting-row dl { display: flex; flex-wrap: wrap; gap: 1.25rem clamp(2rem, 5vw, 4rem); margin: 1.5rem 0 0; }
  .supporting-row dd { margin: .35rem 0 0; font-family: var(--font-display); font-size: var(--t-headline-size); font-weight: 700; line-height: 1; }
  .supporting-row__arrow { justify-self: start; font-size: 1.25rem; transition: transform var(--dur-hover) var(--ease-cinematic); }
  .supporting-row:hover .supporting-row__arrow, .supporting-row:focus-visible .supporting-row__arrow { transform: translate(.2rem, -.2rem); }
  .work-close { padding-block: var(--space-section); background: var(--ink-1000); color: var(--paper-0); }
  .work-close__grid { display: grid; gap: clamp(2rem, 5vw, 4rem); align-items: end; }
  .work-close h2 { max-width: 15ch; margin: 0; font-family: var(--font-display); font-size: var(--t-display-m-size); letter-spacing: var(--t-display-m-letter); line-height: var(--t-display-m-line); text-wrap: balance; }
  .work-close a {
    display: inline-flex;
    gap: 1rem;
    align-items: center;
    justify-content: center;
    min-height: 3rem;
    justify-self: start;
    padding: .8rem 1.35rem;
    border: 1px solid var(--paper-0);
    color: var(--paper-0);
    font-family: var(--font-mono);
    font-size: var(--t-meta-size);
    font-weight: 700;
    letter-spacing: var(--t-meta-letter);
    line-height: 1.3;
    text-decoration: none;
    text-transform: uppercase;
  }
  .work-close a:hover, .work-close a:focus-visible { background: var(--paper-0); color: var(--ink-1000); }
  @media (min-width: 48rem) {
    .supporting-row { grid-template-columns: 3rem minmax(13rem, .8fr) minmax(20rem, 1.2fr) 2rem; column-gap: clamp(1.5rem, 4vw, 4rem); }
    .supporting-row__arrow { justify-self: end; }
    .work-close__grid { grid-template-columns: minmax(0, 1fr) auto; }
    .work-close a { justify-self: end; }
  }
  @media (prefers-reduced-motion: reduce) { .supporting-row__arrow { transition: none; } }
</style>
