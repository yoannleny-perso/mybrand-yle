---
import { render, type CollectionEntry } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Container from '../layout/Container.astro';
import ArticleFrame from '../brand/ArticleFrame.astro';
import Prose from '../primitives/Prose.astro';
import { localizedPath, type Locale } from '../../data/localized-site';

interface Props { locale: Locale; entry: CollectionEntry<'concepts'>; }
const { locale, entry } = Astro.props;
const { Content } = await render(entry);
const detailCopy = {
  en: { kind: 'Concept Library', read: 'min read', reviewed: 'Last reviewed', related: 'Related Reading', cases: 'Related Case Studies', noticeLabel: 'English content notice', notice: null },
  fr: { kind: 'Bibliothèque de concepts', read: 'min de lecture', reviewed: 'Dernière révision', related: 'Lectures connexes', cases: 'Études de cas connexes', noticeLabel: 'Note sur le contenu en anglais', notice: "Ce contenu est rédigé et maintenu en anglais — la référence technique reste dans sa langue d'origine." },
  es: { kind: 'Biblioteca de conceptos', read: 'min de lectura', reviewed: 'Última revisión', related: 'Lecturas relacionadas', cases: 'Casos de estudio relacionados', noticeLabel: 'Aviso de contenido en inglés', notice: 'Este contenido se redacta y mantiene en inglés — la referencia técnica permanece en su idioma original.' },
} as const;
const copy = detailCopy[locale];
const clusterLabels: Record<Locale, Record<string, string>> = {
  en: { 'data-architecture': 'Data Architecture', 'data-engineering': 'Data Engineering', 'bi-analytics': 'BI & Analytics', 'agentic-ai': 'Agentic AI' },
  fr: { 'data-architecture': 'Architecture des Données', 'data-engineering': 'Ingénierie des Données', 'bi-analytics': 'BI & Analytique', 'agentic-ai': 'IA Agentique' },
  es: { 'data-architecture': 'Arquitectura de Datos', 'data-engineering': 'Ingeniería de Datos', 'bi-analytics': 'BI y Analítica', 'agentic-ai': 'IA Agéntica' },
};
const depthLabels: Record<Locale, Record<string, string>> = {
  en: { foundational: 'Foundational', core: 'Core', intermediate: 'Intermediate', advanced: 'Advanced' },
  fr: { foundational: 'Fondamental', core: 'Essentiel', intermediate: 'Intermédiaire', advanced: 'Avancé' },
  es: { foundational: 'Fundamental', core: 'Esencial', intermediate: 'Intermedio', advanced: 'Avanzado' },
};
const pathFor = (path: string) => localizedPath(locale, path);
const readingTime = String(entry.data.readingTime || '');
const metadata = [
  clusterLabels[locale][entry.data.cluster || ''] || entry.data.cluster || copy.kind,
  depthLabels[locale][entry.data.depth || 'foundational'],
  readingTime.toLowerCase().includes('min') ? readingTime : `${readingTime} ${copy.read}`,
  `${copy.reviewed} ${entry.data.lastReviewed || ''}`,
];
---

<Layout title={`${entry.data.title} — ${copy.kind} — Yoann Leny`} description={entry.data.definition || entry.data.title}>
  <div class="reading-progress" aria-hidden="true"></div>
  <Container>
    <div class="knowledge-detail">
      <ArticleFrame eyebrow={copy.kind} title={entry.data.title} dek={entry.data.definition} metadata={metadata} accent="change">
        {copy.notice && <aside class="language-notice" aria-label={copy.noticeLabel}><span lang="en">EN</span><p>{copy.notice}</p></aside>}
        <div lang="en"><Prose><Content /></Prose></div>

        {entry.data.relatedConcepts && entry.data.relatedConcepts.length > 0 && (
          <nav class="related-register" aria-labelledby="related-concepts-heading">
            <h2 id="related-concepts-heading">{copy.related}</h2>
            <ul>{entry.data.relatedConcepts.map((concept) => <li><a href={pathFor(`/concepts/${concept}`)}>{concept.replace(/-/g, ' ')} <span aria-hidden="true">↗</span></a></li>)}</ul>
          </nav>
        )}
        {entry.data.relatedCaseStudies && entry.data.relatedCaseStudies.length > 0 && (
          <nav class="related-register" aria-labelledby="related-cases-heading">
            <h2 id="related-cases-heading">{copy.cases}</h2>
            <ul>{entry.data.relatedCaseStudies.map((study) => <li><a href={pathFor(`/work/${study}`)}>{study.replace(/-/g, ' ')} <span aria-hidden="true">↗</span></a></li>)}</ul>
          </nav>
        )}
      </ArticleFrame>
    </div>
  </Container>
</Layout>

<style>
  .knowledge-detail { padding-bottom: var(--space-section); }
  .knowledge-detail :global(.article-frame__header h1) { max-width: 19ch; font-size: var(--t-display-m-size); }
  .knowledge-detail :global(.prose-content pre) { max-width: 100%; overflow-x: auto; padding: 1rem; background: var(--paper-50); }
  .language-notice, .related-register { max-width: 72ch; margin-inline: auto; }
  .language-notice { display: grid; grid-template-columns: auto minmax(0, 1fr); gap: 1rem; margin-bottom: 3rem; padding-block: 1rem; border-block: 1px solid var(--ink-100); }
  .language-notice span, .language-notice p { margin: 0; }
  .language-notice span { align-self: start; border-bottom: 2px solid var(--signal-intelligence); color: var(--ink-1000); font-family: var(--font-mono); font-size: var(--t-meta-size); font-weight: 700; }
  .language-notice p { color: var(--ink-700); font-size: var(--t-body-s-size); line-height: var(--t-body-s-line); }
  .related-register { margin-top: clamp(3rem, 8vw, 6rem); border-top: 1px solid var(--ink-300); }
  .related-register h2 { margin: 0; padding-block: 1rem; color: var(--ink-500); font-family: var(--font-mono); font-size: var(--t-meta-size); letter-spacing: var(--t-meta-letter); text-transform: uppercase; }
  .related-register ul { margin: 0; padding: 0; border-top: 1px solid var(--ink-100); list-style: none; }
  .related-register :global(a) { display: flex; justify-content: space-between; min-height: 3rem; padding-block: 1rem; border-bottom: 1px solid var(--ink-100); color: var(--ink-1000); font-family: var(--font-display); font-size: var(--t-headline-size); text-decoration: none; text-transform: capitalize; }
</style>
