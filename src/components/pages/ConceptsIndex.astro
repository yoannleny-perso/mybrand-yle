---
import type { CollectionEntry } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Container from '../layout/Container.astro';
import CinematicIntro from '../brand/CinematicIntro.astro';
import { localizedPath, type Locale } from '../../data/localized-site';

interface Props { locale: Locale; entries: CollectionEntry<'concepts'>[]; }
type ClusterKey = 'data-architecture' | 'data-engineering' | 'bi-analytics' | 'agentic-ai';
const { locale, entries } = Astro.props;
const pathFor = (path: string) => localizedPath(locale, path);
const copy = {
  en: {
    title: 'Concept Library — Yoann Leny', description: 'Fifty deep takes on data architecture, data engineering, BI and analytics, and agentic AI. Each entry: what it is, why it matters, how it works, vendor comparison, and my take.', eyebrow: 'Concept Library', heading: 'A working notebook of how I think about each problem.', summary: '50+ entries across data architecture, data engineering, BI and analytics, and agentic AI. Each entry follows the same structure: what it is, why it matters, how it works, vendor comparisons grounded in what I have actually deployed, and a short signed take.', notice: null,
    system: 'The operating system', compose: 'How the clusters compose.', stages: [['Data Engineering', 'Pipelines, compute, & orchestration'], ['Data Architecture', 'Storage, models, & semantics'], ['BI & Analytics', 'Metrics, dashboards, & decisions'], ['Agentic AI', 'Workflows, tools, & orchestration']],
    clusters: { 'data-architecture': ['Data Architecture', 'The shapes data takes when it has to serve multiple consumers reliably — lakes, warehouses, lakehouses, mesh, semantic layers, and the contracts that hold them together.'], 'data-engineering': ['Data Engineering', 'The disciplines that make data move reliably at scale — orchestration, transformation, contracts, observability, cost, and the operating model that holds the function together.'], 'bi-analytics': ['BI & Analytics', 'The layer that turns data into decisions — semantic models, dashboards, decision intelligence, and the editorial discipline of designing metrics for executive use.'], 'agentic-ai': ['Agentic AI', 'Building AI systems that do, not just answer — agent topologies, guardrails, evaluation, governance, and the architectural patterns that make agentic systems survive production.'] },
    entries: 'entries', browse: 'Browse cluster', search: 'Search 50+ concepts…', filterLabels: { cluster: 'Cluster', depth: 'Depth' }, clusterFilters: [['all', 'All clusters'], ['data-architecture', 'Architecture'], ['data-engineering', 'Engineering'], ['bi-analytics', 'BI'], ['agentic-ai', 'Agentic AI']], depthFilters: [['all', 'Any depth'], ['foundational', 'Foundational'], ['core', 'Core'], ['intermediate', 'Intermediate'], ['advanced', 'Advanced']], noResults: 'No concepts found matching your criteria.', living: 'Living document', contributionStart: 'The library is reviewed quarterly. If a vendor comparison is out of date or a definition has aged,', contributionLink: 'send me a note', contributionEnd: "and I'll update the entry — with credit if you'd like.", depth: { foundational: 'Foundational', core: 'Core', intermediate: 'Intermediate', advanced: 'Advanced' },
  },
  fr: {
    title: 'Bibliothèque de concepts — Yoann Leny', description: "Cinquante analyses approfondies sur l'architecture des données, l'ingénierie des données, la BI et l'analyse, et l'IA agentique. Chaque entrée : ce que c'est, pourquoi c'est important, comment ça fonctionne, comparaison des fournisseurs et mon avis.", eyebrow: 'Bibliothèque de concepts', heading: 'Un carnet de bord de ma réflexion sur chaque problème.', summary: "Plus de 50 entrées couvrant l'architecture des données, l'ingénierie des données, la BI et l'analyse, et l'IA agentique. Chaque fiche suit la même structure : ce que c'est, pourquoi c'est important, comment ça fonctionne, des comparaisons d'outils basées sur ce que j'ai réellement déployé, et mon avis synthétique.", notice: 'Les entrées de la bibliothèque sont rédigées et maintenues en anglais.',
    system: "Le système d'exploitation", compose: "Comment les pôles s'assemblent.", stages: [['Ingénierie des Données', 'Pipelines, calcul & orchestration'], ['Architecture des Données', 'Stockage, modèles & sémantique'], ['BI & Décisionnel', 'Métriques, tableaux de bord & décisions'], ['IA Agentique', 'Flux de travail, outils & orchestration']],
    clusters: { 'data-architecture': ['Architecture des Données', "La forme que prennent les données lorsqu'elles doivent servir plusieurs consommateurs de manière fiable — lakes, warehouses, lakehouses, mesh, couches sémantiques et les contrats qui les lient."], 'data-engineering': ['Ingénierie des Données', 'Les disciplines qui permettent de faire circuler les données de manière fiable à grande échelle — orchestration, transformation, contrats, observabilité, coûts et modèle opérationnel associé.'], 'bi-analytics': ['BI & Décisionnel', 'La couche qui transforme les données en décisions — modèles sémantiques, tableaux de bord, intelligence décisionnelle et la rigueur de conception des indicateurs pour les directions générales.'], 'agentic-ai': ['IA Agentique', "Bâtir des systèmes d'IA qui agissent, et pas seulement répondent — topologies d'agents, garde-fous, évaluation, gouvernance et les architectures d'agents viables en production."] },
    entries: 'entrées', browse: 'Parcourir le pôle', search: 'Rechercher parmi 50+ concepts…', filterLabels: { cluster: 'Pôle', depth: 'Niveau' }, clusterFilters: [['all', 'Tous les pôles'], ['data-architecture', 'Architecture'], ['data-engineering', 'Ingénierie'], ['bi-analytics', 'BI & Décisionnel'], ['agentic-ai', 'IA Agentique']], depthFilters: [['all', 'Tous niveaux'], ['foundational', 'Fondamental'], ['core', 'Essentiel'], ['intermediate', 'Intermédiaire'], ['advanced', 'Avancé']], noResults: 'Aucun concept ne correspond à vos critères.', living: 'Document vivant', contributionStart: "La bibliothèque est revue chaque trimestre. Si une comparaison d'outils est dépassée ou qu'une définition a vieilli,", contributionLink: 'signalez-le moi', contributionEnd: 'et je mettrai à jour la fiche — avec mention de votre contribution si vous le souhaitez.', depth: { foundational: 'Fondamental', core: 'Essentiel', intermediate: 'Intermédiaire', advanced: 'Avancé' },
  },
  es: {
    title: 'Biblioteca de conceptos — Yoann Leny', description: 'Más de 50 análisis profundos sobre arquitectura de datos, ingeniería de datos, BI y analítica, e IA agéntica. Cada entrada: qué es, por qué importa, cómo funciona, comparación de herramientas y mi opinión.', eyebrow: 'Biblioteca de conceptos', heading: 'Una bitácora de mi reflexión sobre cada problema.', summary: 'Más de 50 entradas que cubren arquitectura de datos, ingeniería de datos, BI y analítica, e IA agéntica. Cada ficha sigue la misma estructura: qué es, por qué importa, cómo funciona, comparaciones de herramientas basadas en lo que realmente he implementado, y mi opinión sintética.', notice: 'Las entradas de la biblioteca se redactan y mantienen en inglés.',
    system: 'El sistema operativo', compose: 'Cómo se conectan los pilares.', stages: [['Ingeniería de Datos', 'Pipelines, cómputo y orquestación'], ['Arquitectura de Datos', 'Almacenamiento, modelos y semántica'], ['BI y Analítica', 'Métricas, tableros y decisiones'], ['IA Agéntica', 'Flujos de trabajo, herramientas y orquestación']],
    clusters: { 'data-architecture': ['Arquitectura de Datos', 'La forma que toman los datos para servir a múltiples consumidores de manera confiable — lagos, almacenes, lakehouses, mesh, capas semánticas y los contratos que los unen.'], 'data-engineering': ['Ingeniería de Datos', 'Las disciplinas que hacen que los datos se muevan de manera confiable a escala — orquestación, transformación, contratos, observabilidad, costos y el modelo operativo de la función.'], 'bi-analytics': ['BI y Analítica', 'La capa que convierte los datos en decisiones — modelos semánticos, tableros, inteligencia de decisiones y la disciplina editorial de diseñar métricas para uso ejecutivo.'], 'agentic-ai': ['IA Agéntica', 'Construcción de sistemas de IA que actúan, no solo responden — topologías de agentes, barandillas de seguridad (guardrails), evaluación, gobernanza y patrones arquitectónicos viables en producción.'] },
    entries: 'entradas', browse: 'Explorar pilar', search: 'Buscar entre más de 50 conceptos…', filterLabels: { cluster: 'Pilar', depth: 'Nivel' }, clusterFilters: [['all', 'Todos los pilares'], ['data-architecture', 'Arquitectura'], ['data-engineering', 'Ingeniería'], ['bi-analytics', 'BI y Analítica'], ['agentic-ai', 'IA Agéntica']], depthFilters: [['all', 'Todos los niveles'], ['foundational', 'Fundamental'], ['core', 'Esencial'], ['intermediate', 'Intermedio'], ['advanced', 'Avanzado']], noResults: 'Ningún concepto coincide con tus criterios.', living: 'Documento vivo', contributionStart: 'La biblioteca se revisa cada trimestre. Si alguna comparación de herramientas está desactualizada o una definición ha envejecido,', contributionLink: 'avísame', contributionEnd: 'y actualizaré la ficha — con mención a tu contribución si lo deseas.', depth: { foundational: 'Fundamental', core: 'Esencial', intermediate: 'Intermedio', advanced: 'Avanzado' },
  },
} as const;
const c = copy[locale];
const keys: ClusterKey[] = ['data-architecture', 'data-engineering', 'bi-analytics', 'agentic-ai'];
const groups = keys.map((key, index) => ({ id: String(index + 1).padStart(2, '0'), key, name: c.clusters[key][0], description: c.clusters[key][1], entries: entries.filter((entry) => entry.data.cluster === key) }));
const slugFor = (entry: CollectionEntry<'concepts'>) => entry.data.slug || entry.id.split('/').pop() || entry.id;
const filterDepth = (depth?: string) => depth || 'foundational';
---

<Layout title={c.title} description={c.description}>
  <section class="knowledge-intro"><Container size="wide"><CinematicIntro eyebrow={c.eyebrow} title={c.heading} summary={c.summary} variant="utility" accent="change">{c.notice && <p class="english-notice"><span lang="en">EN</span>{c.notice}</p>}</CinematicIntro></Container></section>

  <section class="concept-map"><Container><header><p>{c.system}</p><h2>{c.compose}</h2></header><ol>{c.stages.map(([name, description], index) => <li><span>{String(index + 1).padStart(2, '0')}</span><div><h3>{name}</h3><p>{description}</p></div></li>)}</ol></Container></section>

  <section class="cluster-overview"><Container><div>{groups.map((group) => <article><span>{group.id}</span><div><h2>{group.name}</h2><p class="cluster-count">{group.entries.length} {c.entries}</p><p>{group.description}</p><a href={`#cluster-${group.id}`}>{c.browse} <span aria-hidden="true">↓</span></a></div></article>)}</div></Container></section>

  <div class="concept-tools"><Container><div class="concept-tools__inner"><label><span class="sr-only">{c.search}</span><input id="search-input" type="search" placeholder={c.search} /></label><div class="filter-groups"><p class="filter-label" id="cluster-filters-label">{c.filterLabels.cluster}</p><div id="cluster-filters" role="group" aria-labelledby="cluster-filters-label">{c.clusterFilters.map(([key, label], index) => <button class="filter-btn-cluster" class:list={{ 'is-active': index === 0 }} type="button" data-filter={key} aria-pressed={index === 0 ? 'true' : 'false'}>{label}</button>)}</div><p class="filter-label" id="depth-filters-label">{c.filterLabels.depth}</p><div id="depth-filters" role="group" aria-labelledby="depth-filters-label">{c.depthFilters.map(([key, label], index) => <button class="filter-btn-depth" class:list={{ 'is-active': index === 0 }} type="button" data-filter={key} aria-pressed={index === 0 ? 'true' : 'false'}>{label}</button>)}</div></div></div></Container></div>

  <section class="concept-register"><Container><div id="concepts-list">{groups.map((group) => <section id={`cluster-${group.id}`} class="cluster-section" data-cluster={group.key}><header><span>{group.id}</span><h2>{group.name}</h2><p>{group.entries.length} {c.entries}</p></header><div>{group.entries.map((entry) => <article class="concept-item" data-cluster={group.key} data-depth={filterDepth(entry.data.depth)}><p>{c.depth[entry.data.depth || 'foundational']}</p><a href={pathFor(`/concepts/${slugFor(entry)}`)}><div class="concept-text"><h3 class="concept-title">{entry.data.title}</h3><span class="concept-def">{entry.data.definition}</span></div><i aria-hidden="true">↗</i></a></article>)}</div></section>)}</div><p id="no-results" hidden>{c.noResults}</p></Container></section>

  <section class="contribution"><Container><div><p>{c.living}</p><span>{c.contributionStart} <a href={pathFor('/contact')}>{c.contributionLink}</a> {c.contributionEnd}</span></div></Container></section>
</Layout>

<script>
  function initConceptFilters() {
    const filterRoot = document.querySelector<HTMLElement>('.concept-tools');
    if (!filterRoot || filterRoot.dataset.filtersReady === 'true') return;
    filterRoot.dataset.filtersReady = 'true';
    const clusterButtons = filterRoot.querySelectorAll<HTMLButtonElement>('.filter-btn-cluster');
    const depthButtons = filterRoot.querySelectorAll<HTMLButtonElement>('.filter-btn-depth');
    const searchInput = document.querySelector<HTMLInputElement>('#search-input');
    const concepts = document.querySelectorAll<HTMLElement>('.concept-item');
    const clusters = document.querySelectorAll<HTMLElement>('.cluster-section');
    const noResults = document.querySelector<HTMLElement>('#no-results');
    let activeCluster = 'all'; let activeDepth = 'all'; let searchQuery = '';
    const updateFilters = () => {
      let visibleCount = 0;
      concepts.forEach((concept) => {
        const text = `${concept.querySelector('.concept-title')?.textContent || ''} ${concept.querySelector('.concept-def')?.textContent || ''}`.toLowerCase();
        const show = (activeCluster === 'all' || concept.dataset.cluster === activeCluster) && (activeDepth === 'all' || concept.dataset.depth === activeDepth) && (!searchQuery || text.includes(searchQuery));
        concept.hidden = !show; if (show) visibleCount += 1;
      });
      clusters.forEach((cluster) => { cluster.hidden = !Array.from(cluster.querySelectorAll<HTMLElement>('.concept-item')).some((item) => !item.hidden); });
      if (noResults) noResults.hidden = visibleCount !== 0;
    };
    const bind = (buttons: NodeListOf<HTMLButtonElement>, setValue: (value: string) => void) => buttons.forEach((button) => button.addEventListener('click', () => { buttons.forEach((item) => { item.classList.toggle('is-active', item === button); item.setAttribute('aria-pressed', item === button ? 'true' : 'false'); }); setValue(button.dataset.filter || 'all'); updateFilters(); }));
    bind(clusterButtons, (value) => { activeCluster = value; }); bind(depthButtons, (value) => { activeDepth = value; });
    searchInput?.addEventListener('input', () => { searchQuery = searchInput.value.trim().toLowerCase(); updateFilters(); });
  }
  initConceptFilters(); document.addEventListener('astro:page-load', initConceptFilters);
</script>

<style>
  .knowledge-intro { border-bottom: 1px solid var(--ink-100); background: var(--paper-0); }
  .english-notice { display: flex; gap: .75rem; margin: 0; color: var(--ink-700); font-size: var(--t-body-s-size); }
  .english-notice span { align-self: start; border-bottom: 2px solid var(--signal-intelligence); color: var(--ink-1000); font-family: var(--font-mono); font-size: var(--t-meta-size); font-weight: 700; }
  .concept-map { padding-block: var(--space-section); background: var(--ink-1000); color: var(--paper-0); }
  .concept-map header > p, .concept-map ol > li > span { color: var(--ink-300); font-family: var(--font-mono); font-size: var(--t-meta-size); letter-spacing: var(--t-meta-letter); text-transform: uppercase; }
  .concept-map header > p { margin: 0 0 1rem; }
  .concept-map header h2 { max-width: 20ch; margin: 0; font-family: var(--font-display); font-size: var(--t-display-m-size); }
  .concept-map ol { display: grid; margin: clamp(2.5rem, 6vw, 5rem) 0 0; padding: 0; border-top: 1px solid var(--ink-700); list-style: none; }
  .concept-map li { display: grid; grid-template-columns: 2.5rem minmax(0, 1fr); gap: 1rem; padding-block: 1.5rem; border-bottom: 1px solid var(--ink-700); }
  .concept-map li h3 { margin: 0 0 .5rem; font-family: var(--font-display); font-size: var(--t-headline-size); }
  .concept-map li p { margin: 0; color: var(--ink-300); font-size: var(--t-body-s-size); line-height: var(--t-body-s-line); }
  .cluster-overview { padding-block: var(--space-section); background: var(--paper-50); }
  .cluster-overview > :global(div) > div { border-top: 1px solid var(--ink-300); }
  .cluster-overview article { display: grid; grid-template-columns: 3rem minmax(0, 1fr); gap: 1rem; padding-block: 2rem; border-bottom: 1px solid var(--ink-300); }
  .cluster-overview article > span, .cluster-count { color: var(--ink-500); font-family: var(--font-mono); font-size: var(--t-meta-size); letter-spacing: var(--t-meta-letter); text-transform: uppercase; }
  .cluster-overview h2 { margin: 0; font-family: var(--font-display); font-size: var(--t-headline-size); }
  .cluster-overview article div > p:not(.cluster-count) { max-width: 52rem; color: var(--ink-700); line-height: var(--t-body-line); }
  .cluster-overview a { display: inline-flex; gap: .75rem; min-height: 44px; align-items: center; color: var(--ink-1000); font-family: var(--font-mono); font-size: var(--t-meta-size); font-weight: 700; letter-spacing: var(--t-meta-letter); text-transform: uppercase; }
  /* Not sticky by default: wrapped chips make the bar ~490px tall at 320px, which would
     occupy half the viewport and bury anchor targets. It sticks once there is room. */
  .concept-tools { z-index: 20; padding-block: 1rem; border-block: 1px solid var(--ink-100); background: var(--paper-0); }
  .concept-tools__inner { display: grid; gap: 1rem; }
  .concept-tools input { width: 100%; min-height: 44px; padding: .75rem 1rem; border: 1px solid var(--ink-300); background: var(--paper-0); color: var(--ink-1000); font: inherit; }
  /* Chips wrap rather than scroll: longer FR/ES labels must never be hidden off-axis. */
  .filter-groups { display: grid; grid-template-columns: auto minmax(0, 1fr); gap: .5rem 1rem; align-items: baseline; }
  .filter-groups > div { display: flex; flex-wrap: wrap; gap: .25rem 1.25rem; }
  .filter-label { margin: 0; color: var(--ink-500); font-family: var(--font-mono); font-size: var(--t-meta-size); letter-spacing: var(--t-meta-letter); text-transform: uppercase; }
  .filter-groups button { min-width: 24px; min-height: 44px; flex: 0 0 auto; padding: .5rem 0; border: 0; border-bottom: 2px solid transparent; background: transparent; color: var(--ink-500); font-family: var(--font-mono); font-size: var(--t-meta-size); font-weight: 700; letter-spacing: var(--t-meta-letter); text-transform: uppercase; cursor: pointer; }
  .filter-groups button.is-active { border-color: var(--ink-1000); color: var(--ink-1000); }
  .concept-register { padding-block: var(--space-section); background: var(--paper-0); }
  /* Anchor targets must clear the fixed header, plus the toolbar once it sticks. */
  .cluster-section { margin-bottom: clamp(4rem, 10vw, 8rem); scroll-margin-top: calc(var(--header-height) + 1.5rem); }
  .cluster-section > header { display: grid; gap: .5rem; padding-bottom: 1.5rem; border-bottom: 1px solid var(--ink-300); }
  .cluster-section > header span, .cluster-section > header p, .concept-item > p { margin: 0; color: var(--ink-500); font-family: var(--font-mono); font-size: var(--t-meta-size); letter-spacing: var(--t-meta-letter); text-transform: uppercase; }
  .cluster-section > header h2 { margin: 0; font-family: var(--font-display); font-size: var(--t-display-m-size); }
  .concept-item { display: grid; gap: .75rem; padding-block: 1.75rem; border-bottom: 1px solid var(--ink-100); }
  .concept-item[hidden], .cluster-section[hidden] { display: none; }
  /* Two children, two columns. The title and definition share one track so the definition's
     length can no longer starve the title's — the defect this layout previously had. */
  .concept-item a { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: .75rem; color: var(--ink-1000); text-decoration: none; }
  .concept-text { display: grid; gap: .5rem; min-width: 0; }
  .concept-item h3 { margin: 0; font-family: var(--font-display); font-size: var(--t-headline-size); }
  .concept-def { max-width: 55rem; color: var(--ink-700); font-size: var(--t-body-s-size); line-height: var(--t-body-s-line); }
  .concept-item i { font-style: normal; }
  #no-results { padding-block: 4rem; color: var(--ink-500); font-size: var(--t-body-l-size); text-align: center; }
  .contribution { padding-block: var(--space-section); border-top: 1px solid var(--ink-100); background: var(--paper-50); }
  .contribution > :global(div) > div { max-width: 60ch; }
  .contribution p { color: var(--ink-500); font-family: var(--font-mono); font-size: var(--t-meta-size); letter-spacing: var(--t-meta-letter); text-transform: uppercase; }
  .contribution span { color: var(--ink-700); font-size: var(--t-body-s-size); font-style: italic; line-height: var(--t-body-s-line); }
  .contribution a { display: inline-flex; min-height: 24px; align-items: center; color: var(--ink-1000); }
  @media (min-width: 48rem) { .concept-map ol { grid-template-columns: repeat(4, minmax(0, 1fr)); } .concept-map li { display: block; padding-inline: 1.25rem; border-right: 1px solid var(--ink-700); } .concept-map li:first-child { padding-left: 0; } .cluster-overview article { grid-template-columns: 3rem minmax(12rem, .6fr) minmax(20rem, 1.4fr); } .cluster-overview article > div { display: grid; grid-template-columns: minmax(12rem, .7fr) minmax(18rem, 1.3fr); gap: 1.5rem 3rem; } .cluster-overview h2, .cluster-count { grid-column: 1; } .cluster-overview article div > p:not(.cluster-count), .cluster-overview a { grid-column: 2; } .cluster-overview article div > p:not(.cluster-count) { grid-row: 1 / span 2; margin-top: 0; } .cluster-section > header { grid-template-columns: 3rem minmax(0, 1fr) auto; align-items: end; } .concept-item { grid-template-columns: 9rem minmax(0, 1fr); } }
  @media (min-width: 64rem) { .filter-groups { column-gap: 1.75rem; } .concept-tools { position: sticky; top: var(--header-height); } .cluster-section { scroll-margin-top: calc(var(--header-height) + 13rem); } }
</style>
