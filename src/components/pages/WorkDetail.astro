---
import { render, type CollectionEntry } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Container from '../layout/Container.astro';
import ArticleFrame from '../brand/ArticleFrame.astro';
import Prose from '../primitives/Prose.astro';
import CaseDiagram from '../visuals/CaseDiagram.astro';
import type { CinematicSignal } from '../brand/cinematic-contracts';
import { localizedPath, type Locale } from '../../data/localized-site';

interface Props {
  locale: Locale;
  entry: CollectionEntry<'case-studies'>;
}

type DiagramVariant = 'agents' | 'medallion' | 'semantic' | 'org';

const { locale, entry } = Astro.props;
const { Content } = await render(entry);
const slug = entry.data.slug || entry.id;
const pathFor = (path: string) => localizedPath(locale, path);

const detailCopy = {
  en: {
    detailLabel: 'Case Study',
    achievementLabel: 'Work',
    contextLabel: 'Brief',
    sectorLabel: 'Sector',
    durationLabel: 'Duration',
    outcomesLabel: 'Outcomes',
    closeHeading: 'Have a similar problem?',
    contactLabel: 'Start a conversation',
    backLabel: 'Back to all work',
    noticeLabel: 'English content notice',
    notice: null,
    diagramCaptions: {
      'multi-agent-skill-tracker': 'HIERARCHICAL AGENTS INSIDE DETERMINISTIC BOUNDARIES',
      'enterprise-medallion-stack': 'BRONZE → SILVER → GOLD → ONE GOVERNED CONSUMPTION LAYER',
      'ai-ready-semantic-layer': 'EVERY CONSUMER RESOLVES METRICS THROUGH ONE CONTRACT',
      'global-data-ops-scaling-model': 'DOMAIN PODS ON A PAVED ROAD, INSTRUMENTED MONTHLY',
    },
  },
  fr: {
    detailLabel: 'Étude de cas',
    achievementLabel: 'Réalisation',
    contextLabel: 'Contexte',
    sectorLabel: 'Secteur',
    durationLabel: 'Durée',
    outcomesLabel: 'Résultats',
    closeHeading: 'Vous faites face à un défi similaire ?',
    contactLabel: 'Lancer une conversation',
    backLabel: 'Retour aux réalisations',
    noticeLabel: 'Note sur le contenu en anglais',
    notice: "Ce contenu est rédigé et maintenu en anglais — la référence technique reste dans sa langue d'origine.",
    diagramCaptions: {
      'multi-agent-skill-tracker': 'AGENTS HIÉRARCHISÉS DANS DES FRONTIÈRES DÉTERMINISTES',
      'enterprise-medallion-stack': 'BRONZE → SILVER → GOLD → UNE COUCHE DE CONSOMMATION GOUVERNÉE',
      'ai-ready-semantic-layer': 'CHAQUE CONSOMMATEUR RÉSOUT LES MÉTRIQUES VIA UN CONTRAT UNIQUE',
      'global-data-ops-scaling-model': 'PODS MÉTIERS SUR UNE VOIE BALISÉE, INSTRUMENTÉS CHAQUE MOIS',
    },
  },
  es: {
    detailLabel: 'Caso de Estudio',
    achievementLabel: 'Proyecto',
    contextLabel: 'Resumen',
    sectorLabel: 'Sector',
    durationLabel: 'Duración',
    outcomesLabel: 'Resultados',
    closeHeading: '¿Te enfrentas a un desafío similar?',
    contactLabel: 'Iniciar conversación',
    backLabel: 'Volver a todos los proyectos',
    noticeLabel: 'Aviso de contenido en inglés',
    notice: 'Este contenido se redacta y mantiene en inglés — la referencia técnica permanece en su idioma original.',
    diagramCaptions: {
      'multi-agent-skill-tracker': 'AGENTES JERÁRQUICOS DENTRO DE LÍMITES DETERMINISTAS',
      'enterprise-medallion-stack': 'BRONCE → PLATA → ORO → UNA CAPA DE CONSUMO GOBERNADA',
      'ai-ready-semantic-layer': 'CADA CONSUMIDOR RESUELVE MÉTRICAS MEDIANTE UN ÚNICO CONTRATO',
      'global-data-ops-scaling-model': 'PODS DE DOMINIO SOBRE UN CAMINO PAVIMENTADO, INSTRUMENTADOS MENSUALMENTE',
    },
  },
} as const;

const copy = detailCopy[locale];
const year = entry.data.yearStart || entry.data.yearEnd;
const eyebrowParts = [copy.achievementLabel, year?.toString()].filter((item): item is string => Boolean(item));
const duration = entry.data.yearStart
  ? `${entry.data.yearStart}${entry.data.yearEnd ? ` — ${entry.data.yearEnd}` : ''}`
  : entry.data.yearEnd?.toString();
const metadata = [
  copy.contextLabel,
  entry.data.sector && `${copy.sectorLabel}: ${entry.data.sector}`,
  duration && `${copy.durationLabel}: ${duration}`,
].filter((item): item is string => Boolean(item));

const diagrams: Record<string, { variant: DiagramVariant; accent: CinematicSignal }> = {
  'multi-agent-skill-tracker': { variant: 'agents', accent: 'intelligence' },
  'enterprise-medallion-stack': { variant: 'medallion', accent: 'change' },
  'ai-ready-semantic-layer': { variant: 'semantic', accent: 'intelligence' },
  'global-data-ops-scaling-model': { variant: 'org', accent: 'outcome' },
};
const diagram = diagrams[slug];
const diagramCaption = copy.diagramCaptions[slug as keyof typeof copy.diagramCaptions];
---

<Layout title={`${entry.data.title} — ${copy.detailLabel} — Yoann Leny`} description={entry.data.client}>
  <Container>
    <ArticleFrame
      eyebrow={eyebrowParts.join(' · ')}
      title={entry.data.title}
      dek={entry.data.client}
      metadata={metadata}
      accent={diagram?.accent}
    >
      {entry.data.heroImage && (
        <figure class="case-artifact">
          <img src={entry.data.heroImage} alt={entry.data.title} />
        </figure>
      )}

      {copy.notice && (
        <aside class="language-notice" aria-label={copy.noticeLabel}>
          <span lang="en">EN</span>
          <p>{copy.notice}</p>
        </aside>
      )}

      <div lang="en"><Prose><Content /></Prose></div>

      {diagram && (
        <CaseDiagram variant={diagram.variant} locale={locale} caption={diagramCaption} />
      )}

      {entry.data.metrics && entry.data.metrics.length > 0 && (
        <section class="case-outcomes" aria-labelledby="case-outcomes-heading">
          <h2 id="case-outcomes-heading">{copy.outcomesLabel}</h2>
          <dl>
            {entry.data.metrics.map((metric) => (
              <div><dt>{metric.label}</dt><dd>{metric.value}</dd></div>
            ))}
          </dl>
        </section>
      )}
    </ArticleFrame>
  </Container>

  <section class="detail-close">
    <Container>
      <div class="detail-close__grid">
        <h2>{copy.closeHeading}</h2>
        <div class="detail-close__actions">
          <a href={pathFor('/contact')}>{copy.contactLabel}<span aria-hidden="true">↗</span></a>
          <a href={pathFor('/work')}>{copy.backLabel}<span aria-hidden="true">←</span></a>
        </div>
      </div>
    </Container>
  </section>
</Layout>

<style>
  .case-artifact { margin: 0 0 clamp(2.5rem, 7vw, 6rem); overflow: hidden; border-block: 1px solid var(--ink-100); background: var(--paper-50); }
  :global(.case-diagram) { margin: clamp(3rem, 7vw, 6rem) 0; }
  .case-artifact img { display: block; width: 100%; height: auto; }
  .language-notice {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: 1rem;
    max-width: 72ch;
    margin: 0 auto clamp(2.5rem, 6vw, 5rem);
    padding: 1rem 0;
    border-block: 1px solid var(--ink-100);
  }
  .language-notice span, .language-notice p { margin: 0; }
  .language-notice span { align-self: start; border-bottom: 2px solid var(--signal-intelligence); color: var(--ink-1000); font-family: var(--font-mono); font-size: var(--t-meta-size); font-weight: 700; letter-spacing: var(--t-meta-letter); }
  .language-notice p { color: var(--ink-700); font-size: var(--t-body-s-size); line-height: var(--t-body-s-line); }
  .case-outcomes { max-width: 72ch; margin: 0 auto clamp(3rem, 7vw, 6rem); border-block: 1px solid var(--ink-300); }
  .case-outcomes h2 { margin: 0; padding-block: 1rem; color: var(--ink-500); font-family: var(--font-mono); font-size: var(--t-meta-size); letter-spacing: var(--t-meta-letter); line-height: var(--t-meta-line); text-transform: uppercase; }
  .case-outcomes dl { display: grid; margin: 0; }
  .case-outcomes dl > div { display: flex; flex-direction: column-reverse; gap: .5rem; padding-block: 1.5rem; border-top: 1px solid var(--ink-100); }
  .case-outcomes dt { color: var(--ink-500); font-family: var(--font-mono); font-size: var(--t-meta-size); letter-spacing: var(--t-meta-letter); line-height: var(--t-meta-line); text-transform: uppercase; }
  .case-outcomes dd { margin: 0; color: var(--ink-1000); font-family: var(--font-display); font-size: var(--t-display-m-size); font-weight: 700; letter-spacing: var(--t-display-m-letter); line-height: 1; }
  .detail-close { margin-top: var(--space-section); padding-block: var(--space-section); background: var(--ink-1000); color: var(--paper-0); }
  .detail-close__grid { display: grid; gap: clamp(2rem, 6vw, 5rem); }
  .detail-close h2 { max-width: 15ch; margin: 0; font-family: var(--font-display); font-size: var(--t-display-m-size); letter-spacing: var(--t-display-m-letter); line-height: var(--t-display-m-line); text-wrap: balance; }
  .detail-close__actions { display: flex; flex-wrap: wrap; gap: .75rem; align-items: start; }
  .detail-close a {
    display: inline-flex;
    gap: 1rem;
    align-items: center;
    min-height: 3rem;
    padding: .8rem 1.35rem;
    border: 1px solid var(--ink-700);
    color: var(--paper-0);
    font-family: var(--font-mono);
    font-size: var(--t-meta-size);
    font-weight: 700;
    letter-spacing: var(--t-meta-letter);
    line-height: 1.3;
    text-decoration: none;
    text-transform: uppercase;
  }
  .detail-close a:first-child { border-color: var(--paper-0); background: var(--paper-0); color: var(--ink-1000); }
  .detail-close a:hover, .detail-close a:focus-visible { border-color: var(--signal-change); }
  @media (min-width: 40rem) { .case-outcomes dl { grid-template-columns: repeat(3, minmax(0, 1fr)); } .case-outcomes dl > div { padding-inline: 1rem; } .case-outcomes dl > div:first-child { padding-left: 0; } }
  @media (min-width: 48rem) { .detail-close__grid { grid-template-columns: minmax(0, 1fr) minmax(18rem, .7fr); align-items: end; } }
</style>
