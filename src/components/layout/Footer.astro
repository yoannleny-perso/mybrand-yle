---
---

<footer class="dark-surface py-24 mt-32">
  <div class="mx-auto w-full px-6 sm:px-12 lg:px-[max(96px,8vw)] max-w-[1440px]">
    
    <div class="mb-24">
      <div class="font-display text-[length:var(--t-display-m-size)] leading-[var(--t-display-m-line)] font-light max-w-3xl mb-8">
        Modern organizations don't just need better tools. They need better operating systems.
      </div>
      <div class="h-px w-full bg-ink-700"></div>
    </div>
    
    <div class="grid grid-cols-1 md:grid-cols-3 gap-12 font-body text-[length:var(--t-body-size)] text-ink-300">
      <!-- Column 1: Sitemap -->
      <div class="flex flex-col gap-4">
        <h3 class="font-mono text-[length:var(--t-meta-size)] uppercase tracking-[var(--t-meta-letter)] text-ink-500 mb-2">Sitemap</h3>
        <a href="/work" class="hover:text-paper-50 transition-colors">Work</a>
        <a href="/capabilities" class="hover:text-paper-50 transition-colors">Capabilities</a>
        <a href="/concepts" class="hover:text-paper-50 transition-colors">Concepts</a>
        <a href="/insights" class="hover:text-paper-50 transition-colors">Insights</a>
        <a href="/lab" class="hover:text-paper-50 transition-colors">Lab</a>
      </div>
      
      <!-- Column 2: Direct -->
      <div class="flex flex-col gap-4">
        <h3 class="font-mono text-[length:var(--t-meta-size)] uppercase tracking-[var(--t-meta-letter)] text-ink-500 mb-2">Direct</h3>
        <a href="mailto:yoann.leny@gmail.com" class="hover:text-paper-50 transition-colors">Email</a>
        <a href="https://www.linkedin.com/in/yoann-leny-10144b37/" target="_blank" rel="noopener noreferrer" class="hover:text-paper-50 transition-colors">LinkedIn</a>
        <a href="/contact" class="hover:text-paper-50 transition-colors">Calendar booking link</a>
      </div>
      
      <!-- Column 3: Meta -->
      <div class="flex flex-col gap-4">
        <h3 class="font-mono text-[length:var(--t-meta-size)] uppercase tracking-[var(--t-meta-letter)] text-ink-500 mb-2">Meta</h3>
        <a href="/now" class="hover:text-paper-50 transition-colors">Now</a>
        <a href="/privacy" class="hover:text-paper-50 transition-colors">Privacy</a>
        <a href="/imprint" class="hover:text-paper-50 transition-colors">Imprint</a>
      </div>
    </div>
    
    <div class="mt-24 flex flex-col md:flex-row justify-between items-center pt-8 border-t border-ink-700 font-mono text-[length:var(--t-meta-size)] uppercase tracking-[var(--t-meta-letter)] text-ink-500">
      <div>&copy; {new Date().getFullYear()} Yoann Leny</div>
      <div>Operator. Architect. Builder.</div>
    </div>
  </div>
</footer>
