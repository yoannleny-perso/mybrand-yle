---
const lang = Astro.currentLocale || 'en';

const translations = {
  en: {
    tagline: "Modern organizations don't just need better tools. They need better operating systems.",
    sitemap: "Sitemap",
    work: "Work",
    capabilities: "Capabilities",
    concepts: "Concepts",
    insights: "Insights",
    hire: "Hire me",
    decisions: "Decision log",
    direct: "Direct",
    email: "Email",
    linkedin: "LinkedIn",
    calendar: "Contact",
    meta: "Meta",
    now: "Now",
    privacy: "Privacy",
    imprint: "Imprint",
    sub: "Operator. Architect. Builder."
  },
  fr: {
    tagline: "Les organisations modernes n'ont pas seulement besoin de meilleurs outils. Elles ont besoin de meilleurs systèmes d'exploitation.",
    sitemap: "Plan du site",
    work: "Projets",
    capabilities: "Compétences",
    concepts: "Concepts",
    insights: "Réflexions",
    hire: "Me recruter",
    decisions: "Journal de décisions",
    direct: "Direct",
    email: "E-mail",
    linkedin: "LinkedIn",
    calendar: "Contact",
    meta: "Méta",
    now: "En ce moment",
    privacy: "Confidentialité",
    imprint: "Mentions légales",
    sub: "Opérateur. Architecte. Bâtisseur."
  },
  es: {
    tagline: "Las organizaciones modernas no solo necesitan mejores herramientas. Necesitan mejores sistemas operativos.",
    sitemap: "Mapa del sitio",
    work: "Proyectos",
    capabilities: "Competencias",
    concepts: "Conceptos",
    insights: "Reflexiones",
    hire: "Contrátame",
    decisions: "Registro de decisiones",
    direct: "Directo",
    email: "Correo",
    linkedin: "LinkedIn",
    calendar: "Contacto",
    meta: "Meta",
    now: "Ahora",
    privacy: "Privacidad",
    imprint: "Aviso legal",
    sub: "Operador. Arquitecto. Constructor."
  }
};

const t = translations[lang as keyof typeof translations] || translations.en;

const getLangPath = (path: string) => {
  if (lang === 'en') return path;
  return `/${lang}${path === '/' ? '' : path}`;
};
---

<footer class="dark-surface py-24 mt-32">
  <div class="mx-auto w-full px-6 sm:px-12 lg:px-[max(96px,8vw)] max-w-[1440px]">
    
    <div class="mb-24">
      <div class="font-display text-[length:var(--t-display-m-size)] leading-[var(--t-display-m-line)] font-light max-w-3xl mb-8">
        {t.tagline}
      </div>
      <div class="h-px w-full bg-ink-700"></div>
    </div>
    
    <div class="grid grid-cols-1 md:grid-cols-3 gap-12 font-body text-[length:var(--t-body-size)] text-ink-300">
      <!-- Column 1: Sitemap -->
      <div class="flex flex-col gap-4">
        <h3 class="font-mono text-[length:var(--t-meta-size)] uppercase tracking-[var(--t-meta-letter)] text-ink-500 mb-2">{t.sitemap}</h3>
        <a href={getLangPath('/work')} class="hover:text-paper-50 transition-colors">{t.work}</a>
        <a href={getLangPath('/capabilities')} class="hover:text-paper-50 transition-colors">{t.capabilities}</a>
        <a href={getLangPath('/concepts')} class="hover:text-paper-50 transition-colors">{t.concepts}</a>
        <a href={getLangPath('/insights')} class="hover:text-paper-50 transition-colors">{t.insights}</a>
        <a href="/decisions" class="hover:text-paper-50 transition-colors">{t.decisions}</a>
      </div>
      
      <!-- Column 2: Direct -->
      <div class="flex flex-col gap-4">
        <h3 class="font-mono text-[length:var(--t-meta-size)] uppercase tracking-[var(--t-meta-letter)] text-ink-500 mb-2">{t.direct}</h3>
        <a href="mailto:yoann.leny@gmail.com" class="hover:text-paper-50 transition-colors">{t.email}</a>
        <a href="https://www.linkedin.com/in/yoann-leny-10144b37/" target="_blank" rel="noopener noreferrer" class="hover:text-paper-50 transition-colors">{t.linkedin}</a>
        <a href={getLangPath('/contact')} class="hover:text-paper-50 transition-colors">{t.calendar}</a>
      </div>
      
      <!-- Column 3: Meta -->
      <div class="flex flex-col gap-4">
        <h3 class="font-mono text-[length:var(--t-meta-size)] uppercase tracking-[var(--t-meta-letter)] text-ink-500 mb-2">{t.meta}</h3>
        <a href={getLangPath('/now')} class="hover:text-paper-50 transition-colors">{t.now}</a>
        <a href="/hire" class="hover:text-paper-50 transition-colors">{t.hire}</a>
        <a href="/privacy" class="hover:text-paper-50 transition-colors">{t.privacy}</a>
        <a href="/imprint" class="hover:text-paper-50 transition-colors">{t.imprint}</a>
      </div>
    </div>
    
    <div class="mt-24 flex flex-col md:flex-row justify-between items-center pt-8 border-t border-ink-700 font-mono text-[length:var(--t-meta-size)] uppercase tracking-[var(--t-meta-letter)] text-ink-500">
      <div>&copy; {new Date().getFullYear()} Yoann Leny</div>
      <div>{t.sub}</div>
    </div>
  </div>
</footer>

