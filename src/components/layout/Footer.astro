---
const lang = Astro.currentLocale || 'en';

const translations = {
  en: {
    tagline: "Data and AI leadership, built for the way organizations really operate.",
    sitemap: "Sitemap",
    work: "Work",
    capabilities: "Capabilities",
    about: "About",
    concepts: "Concepts",
    insights: "Insights",
    hire: "Hire me",
    decisions: "Decision log",
    direct: "Direct",
    email: "Email",
    linkedin: "LinkedIn",
    calendar: "Contact",
    meta: "Meta",
    now: "Now",
    privacy: "Privacy",
    imprint: "Imprint",
    sub: "Operator. Architect. Builder."
  },
  fr: {
    tagline: "Leadership Data et IA, conçu pour la façon dont les organisations fonctionnent réellement.",
    sitemap: "Plan du site",
    work: "Projets",
    capabilities: "Compétences",
    about: "À propos",
    concepts: "Concepts",
    insights: "Réflexions",
    hire: "Me recruter",
    decisions: "Journal de décisions (EN)",
    direct: "Direct",
    email: "E-mail",
    linkedin: "LinkedIn",
    calendar: "Contact",
    meta: "Méta",
    now: "En ce moment",
    privacy: "Confidentialité",
    imprint: "Mentions légales",
    sub: "Opérateur. Architecte. Bâtisseur."
  },
  es: {
    tagline: "Liderazgo en datos e IA, creado para la forma en que las organizaciones operan realmente.",
    sitemap: "Mapa del sitio",
    work: "Proyectos",
    capabilities: "Competencias",
    about: "Sobre mí",
    concepts: "Conceptos",
    insights: "Reflexiones",
    hire: "Contrátame",
    decisions: "Registro de decisiones (EN)",
    direct: "Directo",
    email: "Correo",
    linkedin: "LinkedIn",
    calendar: "Contacto",
    meta: "Meta",
    now: "Ahora",
    privacy: "Privacidad",
    imprint: "Aviso legal",
    sub: "Operador. Arquitecto. Constructor."
  }
};

const t = translations[lang as keyof typeof translations] || translations.en;

const getLangPath = (path: string) => {
  if (lang === 'en') return path;
  return `/${lang}${path === '/' ? '' : path}`;
};
---

<footer class="footer-scene bg-ink-900 py-20 text-paper-0 sm:py-24" style="border-radius: var(--radius-scene) var(--radius-scene) 0 0">
  <div class="mx-auto w-full max-w-[1440px] px-4 sm:px-8 lg:px-[max(72px,6vw)]">
    
    <div class="mb-24">
      <div class="font-display text-[length:var(--t-display-m-size)] leading-[var(--t-display-m-line)] font-light max-w-3xl mb-8">
        {t.tagline}
      </div>
      <div class="h-px w-full bg-ink-700"></div>
    </div>
    
    <div class="grid grid-cols-1 gap-12 font-body text-[length:var(--t-body-size)] text-ink-300 md:grid-cols-3">
      <!-- Column 1: Sitemap -->
      <div class="flex flex-col gap-4">
        <h3 class="mb-2 font-mono text-[length:var(--t-meta-size)] uppercase tracking-[var(--t-meta-letter)] text-ink-300">{t.sitemap}</h3>
        <a href={getLangPath('/work')} class="hover:text-paper-50 transition-colors">{t.work}</a>
        <a href={getLangPath('/capabilities')} class="hover:text-paper-50 transition-colors">{t.capabilities}</a>
        <a href={getLangPath('/about')} class="hover:text-paper-50 transition-colors">{t.about}</a>
        <a href={getLangPath('/concepts')} class="hover:text-paper-50 transition-colors">{t.concepts}</a>
        <a href={getLangPath('/insights')} class="hover:text-paper-50 transition-colors">{t.insights}</a>
        <a href="/decisions" class="hover:text-paper-50 transition-colors">{t.decisions}</a>
      </div>
      
      <!-- Column 2: Direct -->
      <div class="flex flex-col gap-4">
        <h3 class="mb-2 font-mono text-[length:var(--t-meta-size)] uppercase tracking-[var(--t-meta-letter)] text-ink-300">{t.direct}</h3>
        <a href="mailto:yoann.leny@gmail.com" class="hover:text-paper-50 transition-colors">{t.email}</a>
        <a href="https://www.linkedin.com/in/yoann-leny-10144b37/" target="_blank" rel="noopener noreferrer" class="hover:text-paper-50 transition-colors">{t.linkedin}</a>
        <a href={getLangPath('/contact')} class="hover:text-paper-50 transition-colors">{t.calendar}</a>
      </div>
      
      <!-- Column 3: Meta -->
      <div class="flex flex-col gap-4">
        <h3 class="mb-2 font-mono text-[length:var(--t-meta-size)] uppercase tracking-[var(--t-meta-letter)] text-ink-300">{t.meta}</h3>
        <a href={getLangPath('/now')} class="hover:text-paper-50 transition-colors">{t.now}</a>
        <a href={getLangPath('/hire')} class="hover:text-paper-50 transition-colors">{t.hire}</a>
        <a href={getLangPath('/privacy')} class="hover:text-paper-50 transition-colors">{t.privacy}</a>
        <a href={getLangPath('/imprint')} class="hover:text-paper-50 transition-colors">{t.imprint}</a>
      </div>
    </div>
    
    <div class="mt-24 flex flex-col items-center justify-between border-t border-ink-700 pt-8 font-mono text-[length:var(--t-meta-size)] uppercase tracking-[var(--t-meta-letter)] text-ink-300 md:flex-row">
      <div>&copy; {new Date().getFullYear()} Yoann Leny</div>
      <div>{t.sub}</div>
    </div>
  </div>
</footer>

<style>
  .footer-scene :global(a:focus-visible) {
    outline-color: var(--focus-on-dark);
  }
</style>
