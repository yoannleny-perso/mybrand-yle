---
const lang = Astro.currentLocale || 'en';

const translations = {
  en: {
    work: 'Work', capabilities: 'Capabilities', about: 'About', thinking: 'Thinking', talk: 'Discuss a role',
    logoLabel: 'Yoann Leny home', openMenu: 'Open menu', closeMenu: 'Close menu',
    language: 'Language', langEn: 'English', langFr: 'French', langEs: 'Spanish',
  },
  fr: {
    work: 'Projets', capabilities: 'Compétences', about: 'À propos', thinking: 'Réflexions', talk: 'Échanger sur un poste',
    logoLabel: 'Accueil Yoann Leny', openMenu: 'Ouvrir le menu', closeMenu: 'Fermer le menu',
    language: 'Langue', langEn: 'Anglais', langFr: 'Français', langEs: 'Espagnol',
  },
  es: {
    work: 'Proyectos', capabilities: 'Competencias', about: 'Sobre mí', thinking: 'Reflexiones', talk: 'Hablar de un puesto',
    logoLabel: 'Inicio Yoann Leny', openMenu: 'Abrir el menú', closeMenu: 'Cerrar el menú',
    language: 'Idioma', langEn: 'Inglés', langFr: 'Francés', langEs: 'Español',
  },
};

const t = translations[lang as keyof typeof translations] || translations.en;
const getLangPath = (path: string) => lang === 'en' ? path : `/${lang}${path === '/' ? '' : path}`;
const normalizePath = (path: string) => path.replace(/\/+$/, '') || '/';
const currentPath = normalizePath(Astro.url.pathname);
const navItems = [
  { label: t.work, path: '/work' },
  { label: t.capabilities, path: '/capabilities' },
  { label: t.about, path: '/about' },
  { label: t.thinking, path: '/insights' },
];
const isActive = (path: string) => {
  const localized = normalizePath(getLangPath(path));
  return currentPath === localized || currentPath.startsWith(`${localized}/`);
};
const languages = [
  { code: 'en', label: t.langEn },
  { code: 'fr', label: t.langFr },
  { code: 'es', label: t.langEs },
];
---

<header id="global-header" class="fixed left-0 top-0 z-50 w-full px-4 py-4 transition-[padding] duration-300 sm:px-8 xl:px-[max(72px,6vw)]">
  <div class="relative mx-auto flex min-h-14 max-w-[1440px] items-center justify-between rounded-full bg-paper-0/95 px-5 shadow-[0_10px_32px_rgba(5,5,5,.08)]">
    <a href={getLangPath('/')} class="z-50 rounded-full font-display text-xl font-semibold tracking-[-0.035em] text-ink-1000 md:text-2xl" aria-label={t.logoLabel}>
      Yoann Leny<span class="brand-signal" aria-hidden="true"></span>
    </a>

    <nav aria-label="Primary navigation" class="absolute left-1/2 hidden -translate-x-1/2 items-center gap-8 xl:flex">
      {navItems.map((item) => (
        <a
          href={getLangPath(item.path)}
          aria-current={isActive(item.path) ? 'page' : undefined}
          class:list={[
            'relative py-3 text-sm font-medium transition-colors after:absolute after:inset-x-0 after:bottom-1 after:h-0.5 after:origin-left after:bg-signal-intelligence after:transition-transform',
            isActive(item.path) ? 'text-ink-1000 after:scale-x-100' : 'text-ink-900 after:scale-x-0 hover:text-ink-1000 hover:after:scale-x-100',
          ]}
        >{item.label}</a>
      ))}
    </nav>

    <div class="z-10 hidden items-center gap-5 xl:flex">
      <div class="flex items-center gap-1" aria-label={t.language}>
        {languages.map((language) => (
          <button
            type="button"
            data-lang-switch={language.code}
            aria-label={`${t.language}: ${language.label}`}
            aria-pressed={lang === language.code}
            class:list={[
              'min-h-11 min-w-11 rounded-full px-2 font-mono text-[0.625rem] font-semibold uppercase tracking-[0.08em] transition-colors',
              lang === language.code ? 'bg-ink-1000 text-paper-0' : 'text-ink-700 hover:bg-paper-50 hover:text-ink-1000',
            ]}
          >{language.code}</button>
        ))}
      </div>
      <a href={getLangPath('/hire')} class="inline-flex min-h-11 items-center rounded-full bg-ink-1000 px-5 py-2.5 text-sm font-semibold text-paper-0 transition-colors hover:bg-ink-900">
        {t.talk}
      </a>
    </div>

    <button
      type="button"
      class="relative z-50 -mr-3 inline-flex min-h-12 min-w-12 items-center justify-center text-ink-1000 xl:hidden"
      aria-label={t.openMenu}
      data-label-open={t.openMenu}
      data-label-close={t.closeMenu}
      id="mobile-menu-btn"
      aria-expanded="false"
      aria-controls="mobile-menu-overlay"
    >
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round">
        <line id="mobile-line-1" class="origin-center transition-all duration-300" x1="3" y1="12" x2="21" y2="12"></line>
        <line id="mobile-line-2" class="origin-center transition-all duration-300" x1="3" y1="6" x2="21" y2="6"></line>
        <line id="mobile-line-3" class="origin-center transition-all duration-300" x1="3" y1="18" x2="21" y2="18"></line>
      </svg>
    </button>

    <div id="mobile-menu-overlay" class="fixed inset-0 z-40 flex flex-col justify-between px-6 pb-8 pt-28 transition-transform duration-300 sm:px-12 xl:hidden" style="background-color: var(--paper-0)" role="dialog" aria-modal="true" aria-label={t.openMenu} aria-hidden="true" inert>
      <nav aria-label="Mobile navigation" class="flex flex-col border-t border-ink-100">
        {navItems.map((item, index) => (
          <a
            href={getLangPath(item.path)}
            aria-current={isActive(item.path) ? 'page' : undefined}
            class:list={[
              'flex items-center justify-between border-b border-ink-100 py-5 font-display text-[clamp(1.75rem,8vw,2.75rem)] font-semibold leading-none tracking-[-0.04em] transition-colors hover:text-ink-700',
              isActive(item.path) ? 'text-ink-1000 underline decoration-signal-intelligence decoration-2 underline-offset-8' : 'text-ink-1000',
            ]}
          >
            <span>{item.label}</span><span class="font-mono text-[0.625rem] font-normal tracking-normal text-ink-500" aria-hidden="true">0{index + 1}</span>
          </a>
        ))}
      </nav>

      <div class="space-y-5">
        <div>
          <p class="mb-3 font-mono text-[0.625rem] uppercase tracking-[0.1em] text-ink-500">{t.language}</p>
          <div class="grid grid-cols-3 gap-2">
            {languages.map((language) => (
              <button
                type="button"
                data-lang-switch={language.code}
                aria-label={`${t.language}: ${language.label}`}
                aria-pressed={lang === language.code}
                class:list={[
                  'min-h-12 rounded-full px-3 font-mono text-xs font-semibold uppercase transition-colors',
                  lang === language.code ? 'bg-ink-1000 text-paper-0' : 'bg-paper-0 text-ink-1000 hover:bg-paper-50',
                ]}
              >{language.code}</button>
            ))}
          </div>
        </div>
        <a href={getLangPath('/hire')} class="flex min-h-12 w-full items-center justify-center rounded-full bg-ink-1000 px-5 py-3 text-center text-base font-semibold text-paper-0 transition-colors hover:bg-ink-900">
          {t.talk}<span class="ml-3" aria-hidden="true">↗</span>
        </a>
      </div>
    </div>
  </div>
</header>

<style>
  :global(#global-header.is-scrolled),
  :global(#global-header.menu-open) {
    padding-top: 0.75rem;
    padding-bottom: 0.75rem;
  }

  .brand-signal {
    display: inline-block;
    width: .28em;
    height: .28em;
    margin-left: .08em;
    border-radius: 50%;
    background: var(--signal-intelligence);
  }

  #mobile-menu-btn[aria-expanded="true"] #mobile-line-1 { transform: scaleX(0); opacity: 0; }
  #mobile-menu-btn[aria-expanded="true"] #mobile-line-2 { transform: translateY(6px) rotate(45deg); }
  #mobile-menu-btn[aria-expanded="true"] #mobile-line-3 { transform: translateY(-6px) rotate(-45deg); }
  #mobile-menu-overlay { transform: translateX(100%); }
  #mobile-menu-overlay.is-open { transform: translateX(0); }
</style>

<script>
  function initHeader() {
    const header = document.getElementById('global-header');
    if (!header || header.dataset.initialized === 'true') return;
    header.dataset.initialized = 'true';

    const btn = header.querySelector<HTMLButtonElement>('#mobile-menu-btn');
    const overlay = header.querySelector<HTMLElement>('#mobile-menu-overlay');
    let previousOverflow = '';
    let lockedScrollY = 0;

    const onScroll = () => header.classList.toggle('is-scrolled', window.scrollY > 8);
    window.addEventListener('scroll', onScroll, { passive: true });
    onScroll();

    if (btn && overlay) {
      const focusableSelector = 'a[href], button:not([disabled]), [tabindex]:not([tabindex="-1"])';
      const setOpen = (open: boolean, restoreFocus = false) => {
        btn.setAttribute('aria-expanded', String(open));
        btn.setAttribute('aria-label', open ? (btn.dataset.labelClose || 'Close menu') : (btn.dataset.labelOpen || 'Open menu'));
        overlay.setAttribute('aria-hidden', String(!open));
        overlay.inert = !open;
        overlay.classList.toggle('is-open', open);
        header.classList.toggle('menu-open', open);

        if (open) {
          lockedScrollY = window.scrollY;
          previousOverflow = document.body.style.overflow;
          document.body.style.overflow = 'hidden';
          const first = overlay.querySelector<HTMLElement>(focusableSelector);
          window.setTimeout(() => first?.focus({ preventScroll: true }), 50);
        } else {
          document.body.style.overflow = previousOverflow;
          window.scrollTo(0, lockedScrollY);
          if (restoreFocus) btn.focus({ preventScroll: true });
        }
      };

      btn.addEventListener('click', () => setOpen(btn.getAttribute('aria-expanded') !== 'true'));
      overlay.querySelectorAll('a').forEach((link) => link.addEventListener('click', () => setOpen(false)));

      document.addEventListener('keydown', (event) => {
        if (btn.getAttribute('aria-expanded') !== 'true') return;
        if (event.key === 'Escape') {
          event.preventDefault();
          setOpen(false, true);
          return;
        }
        if (event.key !== 'Tab') return;

        const focusable = [btn, ...Array.from(overlay.querySelectorAll<HTMLElement>(focusableSelector))]
          .filter((element) => element.offsetParent !== null);
        const first = focusable[0];
        const last = focusable[focusable.length - 1];
        if (event.shiftKey && document.activeElement === first) {
          event.preventDefault();
          last?.focus();
        } else if (!event.shiftKey && document.activeElement === last) {
          event.preventDefault();
          first?.focus();
        }
      });
    }

    header.querySelectorAll<HTMLElement>('[data-lang-switch]').forEach((button) => {
      button.addEventListener('click', () => {
        const targetLang = button.dataset.langSwitch;
        if (!targetLang) return;
        localStorage.setItem('preferred-lang', targetLang);

        const supportedLangs = ['en', 'fr', 'es'];
        const parts = window.location.pathname.split('/').filter(Boolean);
        if (parts[0] && supportedLangs.includes(parts[0])) parts.shift();
        if (targetLang !== 'en' && parts[0] !== 'decisions') parts.unshift(targetLang);
        window.location.href = `/${parts.join('/')}${window.location.search}${window.location.hash}`;
      });
    });
  }

  initHeader();
  document.addEventListener('astro:page-load', initHeader);
</script>
