---
interface Props {
  size?: 'narrow' | 'default' | 'wide';
  class?: string;
}

const { size = 'default', class: className = '' } = Astro.props;

const sizes = {
  narrow: 'max-w-[720px]',
  default: 'max-w-[1200px]',
  wide: 'max-w-[1440px]'
};
---

<div class:list={['mx-auto w-full px-4 sm:px-8 lg:px-[max(72px,6vw)]', sizes[size], className]}>
  <slot />
</div>
