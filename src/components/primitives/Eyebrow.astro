---
interface Props {
  text?: string;
  class?: string;
}

const { text, class: className = '' } = Astro.props;
---

<div class:list={['mb-8 font-mono text-[var(--t-meta-size)] font-semibold uppercase leading-[var(--t-meta-line)] tracking-[var(--t-meta-letter)] text-ink-700', className]}>
  {text ? text : <slot />}
</div>
