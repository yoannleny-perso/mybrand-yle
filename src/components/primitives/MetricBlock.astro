---
interface Props {
  label: string;
  value: string;
  description?: string;
  size?: 'default' | 'large';
}

const { label, value, description, size = 'default' } = Astro.props;
---

<div class="metric-card flex min-w-0 flex-col gap-3 border-t border-ink-100 pt-5">
  <div
    class="metric__value font-display font-black leading-none tracking-tighter text-ink-1000"
    style={size === 'large'
      ? 'font-size: clamp(1.75rem, 4vw, 2.75rem);'
      : 'font-size: clamp(1.5rem, 3vw, 2.25rem);'}
  >
    {value}
  </div>

  <div class="metric__label flex-shrink-0 font-mono text-[0.6875rem] font-semibold uppercase leading-snug tracking-[0.1em] text-ink-700">
    {label}
  </div>

  {description && (
    <div class="metric__desc mt-1 flex-shrink-0 font-body text-[0.8125rem] leading-relaxed text-ink-700">
      {description}
    </div>
  )}
</div>
