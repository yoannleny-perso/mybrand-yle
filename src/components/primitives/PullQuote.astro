---
interface Props {
  text?: string;
  attribution?: string;
  position?: 'left' | 'right' | 'center';
}

const { text, attribution, position = 'center' } = Astro.props;

const alignClasses = {
  left: 'text-left',
  center: 'text-center mx-auto',
  right: 'text-right ml-auto'
};
---

<figure class={`my-16 relative py-8 ${alignClasses[position]} max-w-3xl`}>
  <div class="absolute top-0 left-0 w-full h-[1px] bg-ink-100"></div>
  <blockquote class="font-display italic text-[length:var(--t-display-m-size)] leading-[var(--t-display-m-line)] tracking-[var(--t-display-m-letter)] font-[var(--t-display-m-weight)] text-ink-1000 mb-6">
    <span class="hanging-punctuation">{text ? text : <slot />}</span>
  </blockquote>
  {attribution && (
    <figcaption class="font-mono text-[length:var(--t-meta-size)] uppercase tracking-[var(--t-meta-letter)] text-ink-500">
      — {attribution}
    </figcaption>
  )}
  <div class="absolute bottom-0 left-0 w-full h-[1px] bg-ink-100"></div>
</figure>

<style>
  .hanging-punctuation {
    hanging-punctuation: first last;
  }
</style>
