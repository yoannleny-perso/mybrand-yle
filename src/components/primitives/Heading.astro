---
interface Props {
  level: 1 | 2 | 3 | 4;
  as?: 'h1' | 'h2' | 'h3' | 'h4' | 'div';
  serif?: boolean;
}

const { level, as: Tag = `h${level}` as any, serif = true } = Astro.props;

const styles = {
  1: 'text-[length:var(--t-display-xl-size)] leading-[var(--t-display-xl-line)] tracking-[var(--t-display-xl-letter)] font-[var(--t-display-xl-weight)]',
  2: 'text-[length:var(--t-display-l-size)] leading-[var(--t-display-l-line)] tracking-[var(--t-display-l-letter)] font-[var(--t-display-l-weight)]',
  3: 'text-[length:var(--t-display-m-size)] leading-[var(--t-display-m-line)] tracking-[var(--t-display-m-letter)] font-[var(--t-display-m-weight)]',
  4: 'text-[length:var(--t-headline-size)] leading-[var(--t-headline-line)] tracking-[var(--t-headline-letter)] font-[var(--t-headline-weight)]'
};

const fontClass = serif ? 'font-display' : 'font-body';
---

<Tag class={`${fontClass} ${styles[level]}`}>
  <slot />
</Tag>
