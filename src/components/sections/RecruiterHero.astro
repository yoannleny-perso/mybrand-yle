---
import Container from '../layout/Container.astro';
import IdentityLens from '../brand/IdentityLens.astro';
import type { RecruiterHeroCopy } from '../../data/localized-site';

interface Props {
  copy: RecruiterHeroCopy;
  primaryHref: string;
  secondaryHref: string;
}

const { copy, primaryHref, secondaryHref } = Astro.props;
---

<section class="recruiter-hero">
  <Container size="wide">
    <div class="recruiter-hero__grid">
      <div class="recruiter-hero__copy">
        <div class="recruiter-hero__status">
          <span class="recruiter-hero__availability"><i aria-hidden="true"></i>{copy.availability}</span>
          <span aria-hidden="true">/</span>
          <span>{copy.location}</span>
        </div>

        <p class="recruiter-hero__role">{copy.roleLabel}</p>
        <h1>{copy.headline}</h1>
        <p class="recruiter-hero__summary">{copy.summary}</p>

        <div class="recruiter-hero__actions">
          <a class="recruiter-hero__primary" href={primaryHref}>
            {copy.primaryLabel}<span aria-hidden="true">↗</span>
          </a>
          <a class="recruiter-hero__secondary" href={secondaryHref}>
            {copy.secondaryLabel}<span aria-hidden="true">→</span>
          </a>
        </div>

        <aside class="recruiter-hero__brief" aria-label={copy.briefAriaLabel}>
          <header><span>{copy.briefLabel}</span><span>{copy.fitLabel}</span></header>
          <dl>
            <div><dt>{copy.roleTerm}</dt><dd>{copy.roleValue}</dd></div>
            <div><dt>{copy.scopeTerm}</dt><dd>{copy.scopeValue}</dd></div>
            <div><dt>{copy.reachTerm}</dt><dd>{copy.reachValue}</dd></div>
          </dl>
        </aside>
      </div>

      <div class="recruiter-hero__lens">
        <IdentityLens alt={copy.portraitAlt} orbitLabel={copy.orbitLabel} eager />
      </div>
    </div>
  </Container>
</section>

<style>
  .recruiter-hero {
    overflow: clip;
    padding-block: clamp(7.5rem, 13vw, 11rem) clamp(3.5rem, 8vw, 7rem);
    border-bottom: 1px solid var(--ink-100);
    background: var(--paper-50);
  }
  .recruiter-hero__grid {
    display: grid;
    gap: clamp(2.5rem, 7vw, 7rem);
    align-items: center;
    min-width: 0;
  }
  .recruiter-hero__copy { min-width: 0; order: 2; }
  .recruiter-hero__lens {
    width: min(100%, 31rem);
    min-width: 0;
    order: 1;
    justify-self: center;
  }
  .recruiter-hero__status, .recruiter-hero__role, .recruiter-hero__brief header,
  .recruiter-hero__brief dt {
    font-family: var(--font-mono);
    font-size: var(--t-meta-size);
    font-weight: var(--t-meta-weight);
    letter-spacing: var(--t-meta-letter);
    line-height: var(--t-meta-line);
    text-transform: uppercase;
  }
  .recruiter-hero__status {
    display: flex;
    flex-wrap: wrap;
    gap: .5rem 1rem;
    align-items: center;
    color: var(--ink-700);
  }
  .recruiter-hero__availability { display: inline-flex; gap: .6rem; align-items: center; }
  .recruiter-hero__availability i {
    width: .65rem;
    height: .65rem;
    flex: none;
    background: var(--signal-outcome);
    border-radius: 50%;
  }
  .recruiter-hero__role { margin: clamp(2rem, 4vw, 3.5rem) 0 0; color: var(--signal-intelligence); }
  h1 {
    max-width: 13ch;
    margin: 1rem 0 0;
    overflow-wrap: break-word;
    color: var(--ink-1000);
    font-family: var(--font-display);
    font-size: var(--t-display-xl-size);
    font-weight: var(--t-display-xl-weight);
    letter-spacing: var(--t-display-xl-letter);
    line-height: var(--t-display-xl-line);
    text-wrap: balance;
  }
  .recruiter-hero__summary {
    max-width: 43rem;
    margin: 1.75rem 0 0;
    color: var(--ink-700);
    font-size: var(--t-body-l-size);
    line-height: var(--t-body-l-line);
    text-wrap: pretty;
  }
  .recruiter-hero__actions { display: flex; flex-wrap: wrap; gap: .75rem; margin-top: 2rem; }
  .recruiter-hero__actions a {
    display: inline-flex;
    gap: 1rem;
    align-items: center;
    justify-content: center;
    min-height: 3rem;
    max-width: 100%;
    padding: .8rem 1.35rem;
    font-family: var(--font-mono);
    font-size: var(--t-meta-size);
    font-weight: 700;
    letter-spacing: var(--t-meta-letter);
    line-height: 1.25;
    text-align: center;
    text-decoration: none;
    text-transform: uppercase;
  }
  .recruiter-hero__primary { background: var(--ink-1000); color: var(--paper-0); }
  .recruiter-hero__secondary { border: 1px solid var(--ink-300); color: var(--ink-1000); }
  .recruiter-hero__actions a:hover, .recruiter-hero__actions a:focus-visible { transform: translateY(-2px); }
  .recruiter-hero__brief { max-width: 49rem; margin-top: clamp(2.5rem, 6vw, 4rem); border-top: 1px solid var(--ink-300); }
  .recruiter-hero__brief header {
    display: flex;
    flex-wrap: wrap;
    gap: .75rem 2rem;
    justify-content: space-between;
    padding-block: 1rem;
    color: var(--ink-500);
  }
  .recruiter-hero__brief dl { display: grid; margin: 0; border-top: 1px solid var(--ink-100); }
  .recruiter-hero__brief dl div { min-width: 0; padding: 1rem 0; border-bottom: 1px solid var(--ink-100); }
  .recruiter-hero__brief dt { color: var(--ink-500); }
  .recruiter-hero__brief dd { margin: .5rem 0 0; color: var(--ink-900); font-size: var(--t-body-s-size); line-height: var(--t-body-s-line); }
  @media (min-width: 38rem) {
    .recruiter-hero__brief dl { grid-template-columns: repeat(3, minmax(0, 1fr)); }
    .recruiter-hero__brief dl div { padding-inline: 1rem; border-left: 1px solid var(--ink-100); }
    .recruiter-hero__brief dl div:first-child { padding-left: 0; border-left: 0; }
  }
  @media (min-width: 64rem) {
    .recruiter-hero__grid { grid-template-columns: minmax(0, 1.15fr) minmax(22rem, .85fr); }
    .recruiter-hero__copy { order: 1; }
    .recruiter-hero__lens { width: min(100%, 39rem); order: 2; }
  }
  @media (max-width: 32rem) {
    .recruiter-hero__actions a { width: 100%; }
  }
  @media (prefers-reduced-motion: reduce) {
    .recruiter-hero__actions a { transition: none; }
    .recruiter-hero__actions a:hover, .recruiter-hero__actions a:focus-visible { transform: none; }
  }
</style>
