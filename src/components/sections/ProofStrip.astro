---
interface Metric {
  value: string;
  label: string;
}

interface Props {
  metrics: Metric[];
}

const { metrics } = Astro.props;
---

<section class="bg-ink-1000 text-paper-50" aria-labelledby="proof-strip-title">
  <div class="mx-auto grid w-full max-w-[1440px] sm:grid-cols-2 lg:grid-cols-[1.35fr_repeat(3,1fr)]">
    <div class="border-b border-ink-700 p-6 sm:p-8 lg:border-b-0 lg:border-r lg:px-[max(3rem,8vw)] lg:py-9">
      <p id="proof-strip-title" class="font-mono text-[0.6875rem] font-semibold uppercase tracking-[0.12em] text-paper-50">Published proof</p>
      <p class="mt-2 max-w-[28ch] text-sm leading-5 text-ink-300">Figures summarized from the supporting case material on this site.</p>
    </div>
    {metrics.map((metric) => (
      <div class="border-b border-ink-700 p-6 last:border-b-0 sm:p-8 sm:[&:nth-child(even)]:border-r lg:border-b-0 lg:border-r lg:last:border-r-0">
        <p class="font-display text-[clamp(2.4rem,4vw,4.5rem)] font-semibold leading-none tracking-[-0.05em] text-white" data-countup>{metric.value}</p>
        <p class="mt-2 font-mono text-[0.625rem] uppercase tracking-[0.1em] text-ink-300">{metric.label}</p>
      </div>
    ))}
  </div>
</section>
