---
import type { Achievement } from '../../data/achievements';
import type { AchievementLabels } from '../../data/localized-site';

interface Props {
  achievement: Achievement;
  index: number;
  featured?: boolean;
  labels: AchievementLabels;
}

const { achievement, index, featured = false, labels } = Astro.props;
const indexLabel = String(index + 1).padStart(2, '0');
const Tag = achievement.href ? 'a' : 'article';
const tagProps = achievement.href ? { href: achievement.href } : {};
---

<Tag
  {...tagProps}
  class:list={[
    'achievement-card group relative flex h-full min-h-[25rem] flex-col overflow-hidden border border-ink-200 bg-paper-0 p-6 sm:p-8',
    featured && 'md:min-h-[30rem]',
    achievement.href && 'transition-transform duration-300 hover:-translate-y-1',
  ]}
  style={`--project-accent: ${achievement.accent}`}
>
  <div class="absolute inset-x-0 top-0 h-1 bg-[var(--project-accent)]" aria-hidden="true"></div>

  <div class="flex flex-col gap-3 border-b border-ink-200 pb-5 sm:flex-row sm:items-start sm:justify-between sm:gap-6">
    <div class="font-mono text-[0.6875rem] font-semibold uppercase tracking-[0.12em] text-ink-500">
      {labels.evidence} / {indexLabel}
    </div>
    <div class="flex items-center gap-2 font-mono text-[0.625rem] uppercase tracking-[0.08em] text-ink-600 sm:justify-end sm:text-right">
      <span class="h-2 w-2 shrink-0 rounded-full bg-signal" aria-hidden="true"></span>
      {achievement.status}
    </div>
  </div>

  <div class="flex grow flex-col pt-7">
    <p class="mb-3 font-mono text-[0.6875rem] uppercase tracking-[0.1em] text-ink-500">
      {achievement.projectType}
    </p>
    <h3 class="max-w-[16ch] font-display text-[clamp(2rem,4vw,3.25rem)] font-semibold leading-[0.96] tracking-[-0.045em] text-ink-1000">
      {achievement.name}
    </h3>
    <p class="mt-6 max-w-[46ch] font-body text-base leading-7 text-ink-700">
      {achievement.summary}
    </p>

    <dl class="mt-auto grid grid-cols-2 gap-x-5 gap-y-4 border-t border-ink-200 pt-6">
      <div>
        <dt class="font-mono text-[0.625rem] uppercase tracking-[0.1em] text-ink-500">{labels.sector}</dt>
        <dd class="mt-1 text-sm font-medium text-ink-900">{achievement.industry}</dd>
      </div>
      <div>
        <dt class="font-mono text-[0.625rem] uppercase tracking-[0.1em] text-ink-500">{labels.context}</dt>
        <dd class="mt-1 text-sm font-medium text-ink-900">{achievement.location}</dd>
      </div>
    </dl>

    <ul class="mt-6 flex flex-wrap gap-2" aria-label={labels.capabilities}>
      {achievement.capabilities.map((capability) => (
        <li class="border border-ink-200 bg-paper-50 px-3 py-1.5 font-mono text-[0.625rem] uppercase tracking-[0.06em] text-ink-700">
          {capability}
        </li>
      ))}
    </ul>
  </div>
</Tag>
