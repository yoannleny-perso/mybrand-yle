---
interface Metric {
  value: string;
  label: string;
}

interface Props {
  title: string;
  client?: string;
  metric?: string;
  metrics?: Metric[];
  href: string;
  description: string;
  size: 'tall' | 'wide' | 'square';
  tag: string;
  categories?: string;
  pattern?: 'agents' | 'layers' | 'semantic' | 'org';
}

const {
  title,
  client,
  metric,
  metrics,
  href,
  description,
  size,
  tag,
  categories = '',
  pattern = 'layers',
} = Astro.props;

// Column spans only — heights flow with content so text can never clip.
const sizeClasses = {
  tall: 'col-span-12 md:col-span-5',
  wide: 'col-span-12 md:col-span-7',
  square: 'col-span-12 md:col-span-5',
};

// Cover height varies by card size to keep the asymmetric rhythm.
const coverClasses = {
  tall: 'h-56 md:h-72',
  wide: 'h-56 md:h-64',
  square: 'h-48 md:h-56',
};
---

<a
  href={href}
  data-categories={categories}
  class={`project-card group flex flex-col w-full h-full overflow-hidden bg-paper-0 border border-ink-100 rounded-[var(--radius-card)] ${sizeClasses[size]} shadow-card hover:shadow-hover hover:-translate-y-1 transition-all duration-300`}
>
  <!-- Generative monochrome cover -->
  <div class={`relative overflow-hidden bg-[#ECECEF] ${coverClasses[size]}`}>
    <svg
      class="absolute inset-0 w-full h-full text-ink-300 opacity-60 transform group-hover:scale-[1.04] transition-transform duration-700 ease-out"
      aria-hidden="true"
      preserveAspectRatio="xMidYMid slice"
      viewBox="0 0 400 240"
      fill="none"
      stroke="currentColor"
    >
      {pattern === 'agents' && (
        <g stroke-width="1">
          <circle cx="200" cy="70" r="14" />
          <circle cx="110" cy="150" r="14" />
          <circle cx="200" cy="150" r="14" />
          <circle cx="290" cy="150" r="14" />
          <circle cx="65" cy="215" r="10" />
          <circle cx="155" cy="215" r="10" />
          <circle cx="245" cy="215" r="10" />
          <circle cx="335" cy="215" r="10" />
          <path d="M192 82 L118 138 M200 84 V136 M208 82 L282 138" />
          <path d="M104 162 L70 206 M116 162 L150 206 M284 162 L250 206 M296 162 L330 206" />
        </g>
      )}
      {pattern === 'layers' && (
        <g stroke-width="1">
          <path d="M200 30 L330 90 L200 150 L70 90 Z" />
          <path d="M200 80 L330 140 L200 200 L70 140 Z" />
          <path d="M200 130 L330 190 L200 250 L70 190 Z" />
        </g>
      )}
      {pattern === 'semantic' && (
        <g stroke-width="1">
          <rect x="60" y="40" width="280" height="40" rx="8" />
          <rect x="60" y="100" width="280" height="40" rx="8" />
          <rect x="60" y="160" width="280" height="40" rx="8" />
          <path d="M120 80 V100 M200 80 V100 M280 80 V100 M120 140 V160 M200 140 V160 M280 140 V160" />
        </g>
      )}
      {pattern === 'org' && (
        <g stroke-width="1">
          <rect x="170" y="30" width="60" height="34" rx="8" />
          <rect x="60" y="110" width="60" height="34" rx="8" />
          <rect x="170" y="110" width="60" height="34" rx="8" />
          <rect x="280" y="110" width="60" height="34" rx="8" />
          <rect x="60" y="190" width="60" height="34" rx="8" />
          <rect x="170" y="190" width="60" height="34" rx="8" />
          <rect x="280" y="190" width="60" height="34" rx="8" />
          <path d="M200 64 V88 M90 110 V88 H310 V110 M90 144 V190 M200 144 V190 M310 144 V190" />
        </g>
      )}
    </svg>

    <div class="absolute top-5 left-5 flex flex-wrap gap-2">
      <span class="font-mono text-[11px] font-semibold uppercase tracking-[0.08em] text-ink-900 bg-paper-0/90 px-3.5 py-1.5 backdrop-blur-sm rounded-full border border-ink-100">
        {tag}
      </span>
      {client && (
        <span class="font-mono text-[11px] uppercase text-ink-700 bg-paper-0/90 px-3.5 py-1.5 backdrop-blur-sm rounded-full border border-ink-100">
          {client}
        </span>
      )}
    </div>
  </div>

  <!-- Content flows naturally; nothing can clip -->
  <div class="flex flex-col gap-4 p-6 sm:p-8 grow">
    <h3 class="font-display text-[1.375rem] leading-[1.25] font-semibold text-ink-1000 group-hover:text-signal transition-colors duration-200">
      {title}
    </h3>
    <p class="font-body text-[0.9375rem] leading-[1.6] text-ink-700">
      {description}
    </p>

    <div class="mt-auto pt-5 border-t border-ink-100">
      {metrics && metrics.length > 0 ? (
        <div class="flex items-end justify-between gap-4">
          <div class="grid grid-cols-3 gap-4 grow">
            {metrics.slice(0, 3).map((m) => (
              <div class="flex flex-col gap-1">
                <span class="font-display font-bold text-[1.25rem] leading-none text-ink-1000" data-countup>{m.value}</span>
                <span class="font-mono text-[10px] uppercase tracking-[0.08em] text-ink-500 leading-snug">{m.label}</span>
              </div>
            ))}
          </div>
          <span class="text-ink-1000 opacity-0 group-hover:opacity-100 group-hover:translate-x-1 transition-all duration-300 shrink-0" aria-hidden="true">&rarr;</span>
        </div>
      ) : (
        <div class="font-mono text-[12px] uppercase tracking-[0.08em] text-ink-900 font-bold flex justify-between items-center gap-4">
          <span>{metric}</span>
          <span class="opacity-0 group-hover:opacity-100 group-hover:translate-x-1 transition-all duration-300 shrink-0" aria-hidden="true">&rarr;</span>
        </div>
      )}
    </div>
  </div>
</a>
