---
interface Props {
  title: string;
  client?: string;
  metric: string;
  href: string;
  description: string;
  size: 'tall' | 'wide' | 'square';
  tag: string;
  categories?: string;
}

const { title, client, metric, href, description, size, tag, categories = "" } = Astro.props;

// 12-column grid definitions based on size
const sizeClasses = {
  tall: 'col-span-12 md:col-span-5 aspect-[4/5]',
  wide: 'col-span-12 md:col-span-8 aspect-video md:aspect-[16/9]',
  square: 'col-span-12 md:col-span-4 aspect-square'
};
---

<a href={href} data-categories={categories} class={`project-card group block relative overflow-hidden bg-paper-0 border border-ink-100 rounded-[var(--radius-card)] ${sizeClasses[size]} shadow-card hover:shadow-hover transition-all duration-300`}>
  <!-- Image placeholder -->
  <div class="absolute inset-0 bg-ink-100 overflow-hidden">
    <div class="w-full h-full bg-ink-300 opacity-20 transform group-hover:scale-[1.05] transition-transform duration-500 ease-out"></div>
    <div class="absolute inset-0 bg-[url('data:image/svg+xml;base64,PHN2ZyB4bWxucz0iaHR0cDovL3d3dy53My5vcmcvMjAwMC9zdmciIHdpZHRoPSI0IiBoZWlnaHQ9IjQiPjxyZWN0IHdpZHRoPSI0IiBoZWlnaHQ9IjQiIGZpbGw9IiMwMDAiIGZpbGwtb3BhY2l0eT0iMC4wNCIvPjwvc3ZnPg==')] mix-blend-overlay"></div>
  </div>

  <div class="absolute inset-0 p-6 sm:p-8 flex flex-col justify-between z-10 transition-transform duration-300 group-hover:-translate-y-2">
    <div class="flex justify-between items-start">
      <div class="font-mono text-[length:var(--t-meta-size)] uppercase tracking-[var(--t-meta-letter)] text-ink-1000 bg-paper-50/90 px-4 py-2 backdrop-blur-sm rounded-full border border-ink-100 shadow-sm">
        {tag}
      </div>
      {client && (
        <div class="font-mono text-[length:var(--t-meta-size)] uppercase text-ink-700 bg-paper-50/90 px-4 py-2 backdrop-blur-sm rounded-full border border-ink-100 shadow-sm">
          {client}
        </div>
      )}
    </div>

    <div class="bg-paper-50/90 backdrop-blur-md p-6 border border-ink-100 shadow-[var(--shadow-card)] rounded-[24px]">
      <h3 class="font-display text-[length:var(--t-headline-size)] leading-[var(--t-headline-line)] font-[var(--t-headline-weight)] mb-3 text-ink-1000">
        {title}
      </h3>
      <p class="font-body text-[length:var(--t-body-s-size)] leading-[var(--t-body-s-line)] text-ink-700 mb-4 max-w-lg">
        {description}
      </p>
      <div class="font-mono text-[length:var(--t-meta-size)] uppercase tracking-[var(--t-meta-letter)] text-ink-1000 border-t border-ink-100 pt-3 flex justify-between items-center font-bold">
        <span>{metric}</span>
        <span class="opacity-0 group-hover:opacity-100 group-hover:translate-x-1 transition-all duration-300">&rarr;</span>
      </div>
    </div>
  </div>
</a>
