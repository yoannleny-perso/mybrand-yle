---
import '@fontsource-variable/archivo';
import '@fontsource-variable/inter';
import '@fontsource/azeret-mono';
import '@fontsource/azeret-mono/600.css';
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';

import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  canonicalUrl?: string;
}

const { 
  title = "Yoann Leny — Data Operations and Agentic AI Architect", 
  description = "Yoann Leny architects AI-enabled operating systems for modern organizations.",
  ogImage = '/og/home.png',
  canonicalUrl = Astro.url.pathname === "/" ? Astro.site : new URL(Astro.url.pathname, Astro.site)
} = Astro.props;

const siteUrl = Astro.site || "https://yoannleny.com";
const absoluteOgImage = new URL(ogImage, siteUrl).toString();
const absoluteCanonicalUrl = new URL(canonicalUrl || Astro.url.pathname, siteUrl).toString();

const lang = Astro.currentLocale || 'en';
const skipText = lang === 'fr' ? 'Aller au contenu' : lang === 'es' ? 'Ir al contenido' : 'Skip to content';
const localePrefix = /^\/(fr|es)(?=\/|$)/;
const unprefixedPath = Astro.url.pathname.replace(localePrefix, '') || '/';
const localizedPath = (locale: 'en' | 'fr' | 'es') => {
  if (locale === 'en') return unprefixedPath;
  return `/${locale}${unprefixedPath === '/' ? '/' : unprefixedPath}`;
};
const hasLocalizedEquivalent = !unprefixedPath.startsWith('/decisions');
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <!-- Mark JS as available before first paint; reveal styles only apply then -->
    <script is:inline>document.documentElement.classList.add('js');</script>

    <!-- Language detection: only ever redirects from the homepage, so deep
         links, explicit navigation, and EN-only pages are never hijacked. -->
    <script is:inline>
      (function() {
        const supportedLangs = ['en', 'fr', 'es'];
        const defaultLang = 'en';
        const path = window.location.pathname;

        const homeFor = (l) => (l === defaultLang ? '/' : '/' + l + '/');
        if (path !== '/') return;

        let savedLang = null;
        try {
          savedLang = localStorage.getItem('preferred-lang');
        } catch (_) {
          // Storage can be unavailable in privacy-restricted browser contexts.
        }

        const normalize = (language) => (language || '').toLowerCase().split('-')[0];
        const browserLanguages = [
          ...(Array.isArray(navigator.languages) ? navigator.languages : []),
          navigator.language,
        ];
        const browserLang = browserLanguages.map(normalize).find((language) => supportedLangs.includes(language));
        const targetLang = supportedLangs.includes(savedLang) ? savedLang : (browserLang || defaultLang);

        if (targetLang !== defaultLang) {
          window.location.replace(homeFor(targetLang));
        }
      })();
    </script>
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={absoluteCanonicalUrl} />
    {hasLocalizedEquivalent && (
      <>
        <link rel="alternate" hreflang="en" href={new URL(localizedPath('en'), siteUrl)} />
        <link rel="alternate" hreflang="fr" href={new URL(localizedPath('fr'), siteUrl)} />
        <link rel="alternate" hreflang="es" href={new URL(localizedPath('es'), siteUrl)} />
        <link rel="alternate" hreflang="x-default" href={new URL(localizedPath('en'), siteUrl)} />
      </>
    )}
    
    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={absoluteOgImage} />
    <meta property="og:url" content={absoluteCanonicalUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Yoann Leny" />
    
    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={absoluteOgImage} />
    
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <ClientRouter />
  </head>
  <body>
    <a class="skip-link" href="#main-content">{skipText}</a>
    <Header />
    <main id="main-content" tabindex="-1">
      <slot />
    </main>
    <Footer />

    <script>
      // Single site-wide reveal system. Content is visible without JS;
      // with JS we hide-then-reveal on intersection. Re-runs after
      // view transitions via astro:page-load.
      function initReveals() {
        const targets = document.querySelectorAll('.scroll-reveal:not(.is-revealed), [data-stagger]:not(.is-revealed)');
        if (targets.length === 0) return;

        const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        if (reduceMotion || !('IntersectionObserver' in window)) {
          targets.forEach((el) => el.classList.add('is-revealed'));
          return;
        }

        const observer = new IntersectionObserver((entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add('is-revealed');
              observer.unobserve(entry.target);
            }
          });
        }, { threshold: 0.1, rootMargin: '0px 0px -5% 0px' });

        targets.forEach((el) => observer.observe(el));

        // Safety net: nothing stays hidden if the observer misbehaves.
        setTimeout(() => {
          document.querySelectorAll('.scroll-reveal:not(.is-revealed), [data-stagger]:not(.is-revealed)')
            .forEach((el) => el.classList.add('is-revealed'));
          observer.disconnect();
        }, 6000);
      }

      // Metric count-up: <span data-countup> animates its numeric part once.
      function initCountUps() {
        const els = document.querySelectorAll('[data-countup]:not([data-counted])');
        if (els.length === 0) return;
        const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

        const animate = (el: Element) => {
          el.setAttribute('data-counted', 'true');
          const original = el.textContent || '';
          const match = original.match(/([\d,.]+)/);
          if (!match || reduceMotion) return;
          const target = parseFloat(match[1].replace(/,/g, ''));
          if (!isFinite(target)) return;
          const decimals = (match[1].split('.')[1] || '').length;
          const start = performance.now();
          const dur = 1200;
          const ease = (t: number) => 1 - Math.pow(1 - t, 3);
          const frame = (now: number) => {
            const p = Math.min(1, (now - start) / dur);
            const value = (target * ease(p)).toFixed(decimals);
            el.textContent = original.replace(match[1], Number(value).toLocaleString('en-US', { minimumFractionDigits: decimals }));
            if (p < 1) requestAnimationFrame(frame);
            else el.textContent = original;
          };
          requestAnimationFrame(frame);
        };

        if (!('IntersectionObserver' in window)) { els.forEach(animate); return; }
        const io = new IntersectionObserver((entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) { animate(entry.target); io.unobserve(entry.target); }
          });
        }, { threshold: 0.5 });
        els.forEach((el) => io.observe(el));
      }

      // Reading progress hairline: opt-in per page via .reading-progress element.
      function initReadingProgress() {
        const bar = document.querySelector<HTMLElement>('.reading-progress');
        if (!bar) return;
        const update = () => {
          const doc = document.documentElement;
          const max = doc.scrollHeight - window.innerHeight;
          bar.style.transform = `scaleX(${max > 0 ? Math.min(1, window.scrollY / max) : 0})`;
        };
        window.addEventListener('scroll', update, { passive: true });
        update();
      }

      function initAll() {
        initReveals();
        initCountUps();
        initReadingProgress();
      }

      initAll();
      document.addEventListener('astro:page-load', initAll);
    </script>
  </body>
</html>
