---
import Layout from '../layouts/Layout.astro';
import Container from '../components/layout/Container.astro';
import Section from '../components/layout/Section.astro';
import AchievementCard from '../components/sections/AchievementCard.astro';
import ProofStrip from '../components/sections/ProofStrip.astro';
import RecruiterHero from '../components/sections/RecruiterHero.astro';
import { achievements } from '../data/achievements';

const capabilityEvidence = [
  {
    mandate: 'Make data useful to leaders',
    practice: 'Executive reporting, semantic layers, and decision products that make performance legible.',
    evidence: ['GroupIQ', 'Polaris'],
  },
  {
    mandate: 'Put AI into reliable operation',
    practice: 'Agentic systems, governed context, evaluation, and human control where decisions carry weight.',
    evidence: ['Lense Studio', 'Media Data Studio'],
  },
  {
    mandate: 'Turn platforms into adoption',
    practice: 'Product strategy, operating models, and team rituals that move a system from delivery to daily use.',
    evidence: ['Cap Ostrea', 'Polaris'],
  },
];

const thinking = [
  {
    label: 'Agentic operations',
    title: 'Why most agent demos collapse in production',
    href: '/insights/why-most-agent-demos-collapse-in-production',
  },
  {
    label: 'Data products',
    title: 'Data as a product, three years on',
    href: '/insights/data-as-a-product-three-years-on',
  },
  {
    label: 'Executive systems',
    title: 'The ten numbers on a CEO dashboard',
    href: '/insights/ten-numbers-ceo-dashboard',
  },
];
---

<Layout
  title="Yoann Leny — Data & AI executive leader"
  description="Data and AI leadership across strategy, platforms, products, and operating models. Explore selected achievements and production case studies."
>
  <RecruiterHero primaryLabel="Discuss a role" primaryHref="/hire" />

  <ProofStrip
    metrics={[
      { value: '40+', label: 'experts led' },
      { value: '3 regions', label: 'international scope' },
      { value: '$13M+', label: 'attributed impact' },
    ]}
  />

  <Section id="selected-achievements">
    <Container>
      <div class="mb-12 grid gap-8 border-b border-ink-300 pb-8 lg:grid-cols-12 lg:items-end">
        <div class="lg:col-span-8">
          <p class="font-mono text-[0.6875rem] font-semibold uppercase tracking-[0.12em] text-signal">02 / Evidence</p>
          <h2 class="mt-4 max-w-[15ch] font-display text-[clamp(2.75rem,5.5vw,5.75rem)] font-semibold leading-[0.92] tracking-[-0.05em] text-ink-1000">
            Products that make the claim concrete.
          </h2>
        </div>
        <div class="lg:col-span-4">
          <p class="max-w-[42ch] text-base leading-7 text-ink-700">
            Five named achievements across regulated reporting, people operations, analytics quality, marketplaces, and media data architecture.
          </p>
          <a href="/work" class="mt-5 inline-flex min-h-11 items-center border-b border-ink-1000 font-mono text-[0.6875rem] font-semibold uppercase tracking-[0.09em] text-ink-900 hover:text-signal">
            Open the complete work register <span class="ml-3" aria-hidden="true">→</span>
          </a>
        </div>
      </div>

      <div class="grid gap-5 md:grid-cols-2">
        {achievements.map((achievement, index) => (
          <div class:list={[index === 4 && 'md:col-span-2 lg:max-w-[calc(50%-0.625rem)]']}>
            <AchievementCard achievement={achievement} index={index} featured={index === 0 || index === 4} />
          </div>
        ))}
      </div>
    </Container>
  </Section>

  <section id="capabilities" class="border-y border-ink-300 bg-paper-0 py-[var(--space-section)]">
    <Container>
      <div class="grid gap-8 lg:grid-cols-12">
        <div class="lg:col-span-4">
          <p class="font-mono text-[0.6875rem] font-semibold uppercase tracking-[0.12em] text-signal">03 / Capability map</p>
          <h2 class="mt-4 max-w-[12ch] font-display text-[clamp(2.5rem,4.5vw,4.75rem)] font-semibold leading-[0.94] tracking-[-0.045em] text-ink-1000">
            Capabilities, attached to proof.
          </h2>
          <p class="mt-6 max-w-[36ch] text-base leading-7 text-ink-700">
            Recruiters should not have to infer the link between a skill and where it has been applied.
          </p>
          <a href="/capabilities" class="mt-8 inline-flex min-h-11 items-center border-b border-ink-1000 font-mono text-[0.6875rem] font-semibold uppercase tracking-[0.09em] text-ink-900 hover:text-signal">
            Explore the full practice <span class="ml-3" aria-hidden="true">→</span>
          </a>
        </div>

        <div class="border-t border-ink-300 lg:col-span-8 lg:border-t-0">
          {capabilityEvidence.map((item, index) => (
            <article class="grid gap-5 border-b border-ink-300 py-7 sm:grid-cols-[2.5rem_1.1fr_1.5fr] sm:gap-6 lg:py-9">
              <span class="font-mono text-[0.6875rem] text-signal">{String(index + 1).padStart(2, '0')}</span>
              <h3 class="font-display text-[clamp(1.5rem,2.5vw,2.25rem)] font-semibold leading-[1.05] tracking-[-0.035em] text-ink-1000">{item.mandate}</h3>
              <div>
                <p class="text-[0.95rem] leading-6 text-ink-700">{item.practice}</p>
                <p class="mt-4 font-mono text-[0.625rem] uppercase tracking-[0.08em] text-ink-500">
                  Evidence: <span class="text-ink-900">{item.evidence.join(' · ')}</span>
                </p>
              </div>
            </article>
          ))}
        </div>
      </div>
    </Container>
  </section>

  <section class="bg-ink-1000 py-[var(--space-section)] text-paper-50">
    <Container>
      <div class="grid gap-12 lg:grid-cols-12 lg:items-start">
        <div class="lg:col-span-7">
          <p class="font-mono text-[0.6875rem] font-semibold uppercase tracking-[0.12em] text-ink-300">04 / Recruiter fit</p>
          <h2 class="mt-5 max-w-[13ch] font-display text-[clamp(3rem,5.5vw,6rem)] font-semibold leading-[0.9] tracking-[-0.05em] text-white">
            The right mandate is bigger than a tool choice.
          </h2>
        </div>
        <div class="lg:col-span-5 lg:pt-8">
          <p class="max-w-[48ch] text-lg leading-8 text-ink-300">
            I am most useful where a leadership team needs to connect business direction with data and AI delivery—and leave behind an operating system the organization can actually run.
          </p>
          <ul class="mt-8 border-t border-ink-700 text-sm text-paper-50">
            <li class="flex gap-4 border-b border-ink-700 py-4"><span class="font-mono text-signal">01</span>Executive ownership of a data and AI transformation</li>
            <li class="flex gap-4 border-b border-ink-700 py-4"><span class="font-mono text-signal">02</span>A platform or product portfolio that needs sharper adoption</li>
            <li class="flex gap-4 border-b border-ink-700 py-4"><span class="font-mono text-signal">03</span>A distributed team that needs a scalable operating model</li>
          </ul>
          <div class="mt-8 flex flex-col gap-3 sm:flex-row">
            <a href="/hire" class="inline-flex min-h-12 items-center justify-center bg-signal px-6 py-3 font-mono text-xs font-semibold uppercase tracking-[0.08em] text-white hover:bg-white hover:text-ink-1000">
              Discuss a role <span class="ml-3" aria-hidden="true">↗</span>
            </a>
            <a href="/about" class="inline-flex min-h-12 items-center justify-center border border-ink-700 px-6 py-3 font-mono text-xs font-semibold uppercase tracking-[0.08em] text-paper-50 hover:border-paper-50">
              Leadership approach
            </a>
          </div>
        </div>
      </div>
    </Container>
  </section>

  <Section id="thinking">
    <Container>
      <div class="mb-10 flex flex-col gap-6 border-b border-ink-300 pb-7 sm:flex-row sm:items-end sm:justify-between">
        <div>
          <p class="font-mono text-[0.6875rem] font-semibold uppercase tracking-[0.12em] text-signal">05 / Thinking</p>
          <h2 class="mt-4 font-display text-[clamp(2.5rem,5vw,5rem)] font-semibold leading-none tracking-[-0.045em] text-ink-1000">How I make decisions.</h2>
        </div>
        <a href="/insights" class="inline-flex min-h-11 items-center border-b border-ink-1000 font-mono text-[0.6875rem] font-semibold uppercase tracking-[0.09em] text-ink-900 hover:text-signal">
          Browse all thinking <span class="ml-3" aria-hidden="true">→</span>
        </a>
      </div>

      <div class="grid border-t border-ink-300 md:grid-cols-3 md:border-t-0">
        {thinking.map((item, index) => (
          <a href={item.href} class="group flex min-h-[18rem] flex-col border-b border-ink-300 py-7 md:border-r md:px-7 md:first:pl-0 md:last:border-r-0 md:last:pr-0">
            <div class="flex items-center justify-between gap-4 font-mono text-[0.625rem] uppercase tracking-[0.1em] text-ink-500">
              <span>{item.label}</span>
              <span>{String(index + 1).padStart(2, '0')}</span>
            </div>
            <h3 class="mt-8 max-w-[18ch] font-display text-[clamp(1.75rem,2.7vw,2.65rem)] font-semibold leading-[1.02] tracking-[-0.04em] text-ink-1000 transition-colors group-hover:text-signal">{item.title}</h3>
            <span class="mt-auto pt-8 font-mono text-xs text-ink-700" aria-hidden="true">Read essay ↗</span>
          </a>
        ))}
      </div>
    </Container>
  </Section>

  <section class="border-t border-ink-300 bg-paper-0 py-16 sm:py-24">
    <Container>
      <div class="grid gap-8 lg:grid-cols-12 lg:items-end">
        <div class="lg:col-span-8">
          <p class="font-mono text-[0.6875rem] font-semibold uppercase tracking-[0.12em] text-signal">06 / Next conversation</p>
          <h2 class="mt-4 max-w-[17ch] font-display text-[clamp(2.75rem,5vw,5rem)] font-semibold leading-[0.94] tracking-[-0.045em] text-ink-1000">
            If the mandate needs both strategic range and operating depth, let's talk.
          </h2>
        </div>
        <div class="lg:col-span-4 lg:text-right">
          <a href="/hire" class="inline-flex min-h-12 items-center justify-center bg-signal px-6 py-3.5 font-mono text-xs font-semibold uppercase tracking-[0.08em] text-white transition-transform hover:-translate-y-0.5">
            Discuss a role <span class="ml-3" aria-hidden="true">↗</span>
          </a>
        </div>
      </div>
    </Container>
  </section>
</Layout>
