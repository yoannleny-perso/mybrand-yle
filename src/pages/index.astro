---
import Layout from '../layouts/Layout.astro';
import Container from '../components/layout/Container.astro';
import Section from '../components/layout/Section.astro';
import Grid from '../components/layout/Grid.astro';
import Eyebrow from '../components/primitives/Eyebrow.astro';
import Heading from '../components/primitives/Heading.astro';
import MetricBlock from '../components/primitives/MetricBlock.astro';
import Hero from '../components/sections/Hero.tsx';
import CapabilityList from '../components/sections/CapabilityList.tsx';
import AsymmetricCard from '../components/sections/AsymmetricCard.astro';
import TestimonialCrossfade from '../components/sections/TestimonialCrossfade.tsx';

const heroHeadline = [
  "Building",
  "AI-Enabled Operating Systems",
  "for Modern Organizations."
];

const capabilities = [
  {
    number: "01",
    title: "Agentic AI Architecture",
    summary: "Multi-agent systems with deterministic guardrails and audit trails.",
    slug: "agentic-ai-architecture"
  },
  {
    number: "02",
    title: "Data & Semantic Platforms",
    summary: "Medallion lakehouses with a governed semantic layer on top.",
    slug: "data-platforms"
  },
  {
    number: "03",
    title: "Strategic Data Operations",
    summary: "Treating data as a product with contracts, SLAs, and lineage.",
    slug: "strategic-data-ops"
  },
  {
    number: "04",
    title: "Team Orchestration",
    summary: "Designing pods, roles, and rituals that scale beyond 40 experts.",
    slug: "team-orchestration"
  },
  {
    number: "05",
    title: "Executive Enablement",
    summary: "Turning leadership questions into observable operating decisions.",
    slug: "executive-enablement"
  }
];

const testimonials = [
  {
    quote: "\"Yoann is the rare leader who can stand at the whiteboard with engineers in the morning and at the executive committee in the afternoon — and move both rooms forward.\"",
    attribution: "CEO, Global Consulting Firm"
  },
  {
    quote: "\"He didn't just modernize our data stack. He gave us an operating model that the next CTO will inherit and not have to redesign.\"",
    attribution: "Chief Data Officer, Industrial Group"
  },
  {
    quote: "\"What he calls 'restraint' the rest of us call 'finally seeing the signal'. Yoann removes more than he adds, and that is exactly what senior teams need.\"",
    attribution: "Partner, Strategy Practice"
  }
];
---

<Layout>
  <!-- SECTION 1 — HERO -->
  <Hero 
    client:load
    headlineLines={heroHeadline} 
    subheadline="I help companies turn data, AI, and people into measurable operating advantage." 
  />

  <div class="hairline max-w-[1440px] mx-auto"></div>

  <!-- SECTION 2 — ABOUT + METRICS -->
  <Section id="about">
    <Container>
      <!-- Eyebrow: fully integrated, subtle, doesn't compete with heading -->
      <div class="mb-10">
        <Eyebrow text="02 / 08 — APPROACH" />
      </div>

      <Grid columns={12}>
        <!-- LEFT: Copy block — 8pt vertical rhythm throughout -->
        <div class="col-span-12 lg:col-span-6 flex flex-col gap-8 mb-16 lg:mb-0">

          <!-- Headline: breathable negative space via leading-[1.08] and max-w -->
          <h2 class="font-display font-black text-ink-900 max-w-[14ch] leading-[1.08] tracking-[-0.03em]"
              style="font-size: clamp(2.25rem, 4.5vw, 3.75rem);">
            I build the systems<br />
            <span class="text-signal">that scale teams.</span>
          </h2>

          <!-- Body copy: 20px / 1.7 line-height, constrained to 55ch -->
          <div class="flex flex-col gap-6 max-w-[55ch]">
            <p class="font-body text-[1.125rem] leading-[1.75] text-ink-700">
              I have spent the last decade at the intersection of data engineering, AI architecture, and executive operations — building the platforms, agentic workflows, and team structures that turn capability into compounding margin.
            </p>
            <p class="font-body text-[1.125rem] leading-[1.75] text-ink-700">
              Most organizations don't have a tooling problem. They have an <em class="text-ink-900 not-italic font-semibold">operating system</em> problem. Tools are easy. The way decisions, data, models, and people compose into a working whole — that's where leverage lives.
            </p>
          </div>

          <!-- CTA link -->
          <a href="/work"
             class="inline-flex items-center gap-2 font-mono text-[0.6875rem] font-bold uppercase tracking-[0.12em] text-ink-900 border-b-2 border-signal pb-1 w-fit hover:text-signal transition-colors duration-200">
            See how it works <span class="text-base">→</span>
          </a>
        </div>

        <!-- RIGHT: Metrics grid — 8pt gaps, cards sized to content not viewport -->
        <div class="col-span-12 lg:col-span-5 lg:col-start-8 flex items-start lg:items-center">
          <!--
            4-card grid:
            gap-4 (16px) horizontally, gap-6 (24px) vertically — 8pt multiples.
            Cards are width-bound by the column, not fixed px.
          -->
          <div class="grid grid-cols-2 gap-x-4 gap-y-6 w-full">
            <MetricBlock label="Revenue impact delivered" value="$13M+" size="large" />
            <MetricBlock label="Experts orchestrated" value="40+" size="large" />
            <MetricBlock label="Regions led" value="3" size="large" />
            <MetricBlock label="Utilization uplift" value="+15%" size="large" />
          </div>
        </div>
      </Grid>
    </Container>
  </Section>

  <div class="hairline max-w-[1440px] mx-auto"></div>

  <!-- SECTION 3 — CAPABILITIES -->
  <Section id="capabilities">
    <Container>
      <div class="mb-12 max-w-3xl">
        <Eyebrow text="03 / 08 — WHAT I DO" />
        <h2 class="font-display font-black text-ink-900 mt-4 mb-5 leading-[1.1] tracking-[-0.025em]"
            style="font-size: clamp(2rem, 4vw, 3rem);">
          This is how I scale organizations.
        </h2>
        <p class="font-body text-[1.125rem] leading-[1.7] text-ink-700 max-w-[52ch]">
          Five practices, one operating logic. Each row is a system I have built and run in production — not a methodology I read about.
        </p>
      </div>
    </Container>
    
    <div class="max-w-[1440px] mx-auto">
      <CapabilityList client:visible capabilities={capabilities} />
    </div>
  </Section>

  <div class="hairline max-w-[1440px] mx-auto"></div>

  <!-- SECTION 4 — SELECTED WORK -->
  <Section id="work">
    <Container>
      <div class="mb-12">
        <Eyebrow text="04 / 08 — SELECTED WORK" />
        <h2 class="font-display font-black text-ink-900 mt-4 leading-[1.08] tracking-[-0.03em]"
            style="font-size: clamp(2rem, 4vw, 3rem);">
          <span class="block">Production work.</span>
          <span class="block text-ink-500 font-medium">Measured outcomes.</span>
        </h2>
      </div>

      <Grid columns={12} gap="loose">
        <AsymmetricCard 
          size="tall"
          tag="2025 · ENTERPRISE · 18 MONTHS"
          title="Multi-Agent Skill Tracker"
          description="A hierarchical agentic system that maintains a live skills graph for 40+ consultants, recommends staffing, and surfaces hiring gaps to leadership weekly."
          metric="+15% utilization · -22% bench time"
          href="/work/multi-agent-skill-tracker"
        />
        <div class="col-span-12 md:col-span-2 hidden md:block"></div> {/* Spacer */}
        
        <AsymmetricCard 
          size="wide"
          tag="2024 · GLOBAL · 12 MONTHS"
          title="Enterprise Medallion Stack"
          description="A bronze–silver–gold lakehouse architecture deployed across three regions, with a governed semantic layer feeding analytics, ML, and agent workflows from a single source of truth."
          metric="$13M+ revenue impact · 9-month payback"
          href="/work/enterprise-medallion-stack"
        />

        <AsymmetricCard 
          size="square"
          tag="2024 · MID-MARKET · 6 MONTHS"
          title="AI-Ready Semantic Layer"
          description="A metric definition layer designed specifically for LLM and agent consumption, eliminating hallucinated KPIs and standardizing how AI tools query the business."
          metric="0 KPI drift incidents in production"
          href="/work/ai-ready-semantic-layer"
        />
        
        <div class="col-span-12 md:col-span-2 hidden md:block"></div> {/* Spacer */}
        
        <AsymmetricCard 
          size="tall"
          tag="2023 · GLOBAL · 24 MONTHS"
          title="Global Data Ops Scaling Model"
          description="An operating model for a 40-person data team across three regions: pod design, role split, ritual cadence, and a custom internal observability layer for delivery health."
          metric="40+ experts · 3 regions · 4 qtrs to steady-state"
          href="/work/global-data-ops-scaling-model"
        />
      </Grid>
      
      <div class="mt-16 text-right">
        <a href="/work" class="font-mono text-[length:var(--t-meta-size)] uppercase tracking-[var(--t-meta-letter)] text-ink-1000 hover:text-ink-500 transition-colors">
          &rarr; See all work
        </a>
      </div>
    </Container>
  </Section>

  <div class="hairline max-w-[1440px] mx-auto"></div>

  <!-- SECTION 5 — LEADERSHIP PHILOSOPHY -->
  <Section id="philosophy">
    <Container>
      <Eyebrow text="05 / 08 — PHILOSOPHY" />

      <!-- Pull-quote: constrained width, large italic, generous vertical space -->
      <div class="max-w-[42ch] mx-auto text-center my-12 md:my-16">
        <p class="font-display font-semibold italic text-ink-900 leading-[1.35] tracking-[-0.02em]"
           style="font-size: clamp(1.25rem, 2.5vw, 1.875rem);">
          Modern organizations don't fail because they lack tools.<br />
          They fail because they lack an operating system that turns those tools into decisions.
        </p>
      </div>

      <!-- Philosophy cards: 4-col grid, each with a tinted surface for variety -->
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 md:gap-6">
        <div class="flex flex-col gap-4 bg-[var(--surface-indigo)] rounded-2xl p-8 border border-indigo-100">
          <div class="w-8 h-[3px] rounded-full bg-signal"></div>
          <h3 class="font-display font-bold text-[1.125rem] text-ink-900 leading-snug">Data is a product, not a service.</h3>
          <p class="font-body text-[0.9375rem] leading-relaxed text-ink-700">Owners, contracts, SLAs, deprecation policies — like any product worth running.</p>
        </div>
        <div class="flex flex-col gap-4 bg-[var(--surface-blue)] rounded-2xl p-8 border border-blue-100">
          <div class="w-8 h-[3px] rounded-full bg-blue-500"></div>
          <h3 class="font-display font-bold text-[1.125rem] text-ink-900 leading-snug">AI should upgrade teams into architects.</h3>
          <p class="font-body text-[0.9375rem] leading-relaxed text-ink-700">Agents handle execution. Humans set the rules execution must respect.</p>
        </div>
        <div class="flex flex-col gap-4 bg-[var(--surface-green)] rounded-2xl p-8 border border-emerald-100">
          <div class="w-8 h-[3px] rounded-full bg-emerald-500"></div>
          <h3 class="font-display font-bold text-[1.125rem] text-ink-900 leading-snug">Operational visibility is a strategic asset.</h3>
          <p class="font-body text-[0.9375rem] leading-relaxed text-ink-700">If a leader cannot see the system, they cannot govern it.</p>
        </div>
        <div class="flex flex-col gap-4 bg-[var(--surface-purple)] rounded-2xl p-8 border border-purple-100">
          <div class="w-8 h-[3px] rounded-full bg-purple-500"></div>
          <h3 class="font-display font-bold text-[1.125rem] text-ink-900 leading-snug">Systems scale what talent alone cannot.</h3>
          <p class="font-body text-[0.9375rem] leading-relaxed text-ink-700">Hiring fixes throughput for a quarter. Systems fix it forever.</p>
        </div>
      </div>
    </Container>
  </Section>

  <div class="hairline max-w-[1440px] mx-auto"></div>

  <!-- SECTION 6 — INSIGHTS / WRITING -->
  <Section id="insights">
    <Container>
      <div class="mb-10">
        <Eyebrow text="06 / 08 — INSIGHTS" />
        <h2 class="font-display font-black text-ink-900 mt-4 mb-4 leading-[1.1] tracking-[-0.025em]"
            style="font-size: clamp(2rem, 4vw, 3rem);">Writing is how I think.</h2>
        <p class="font-body text-[1.125rem] leading-[1.7] text-ink-700 max-w-[52ch]">
          Essays and concept entries on data architecture, agentic AI, and the operating model questions that decide whether either of them works.
        </p>
      </div>

      <!-- Insight cards: each gets a distinct surface tint for scannability -->
      <div class="grid grid-cols-1 md:grid-cols-3 gap-5">

        <a href="/insights" class="group flex flex-col justify-between gap-6 p-8 rounded-2xl bg-[var(--surface-indigo)] border border-indigo-100 hover:shadow-[0_8px_32px_rgba(99,102,241,0.15)] hover:-translate-y-1 transition-all duration-300 min-h-[280px]">
          <div class="flex flex-col gap-4">
            <span class="font-mono text-[0.625rem] font-bold uppercase tracking-[0.12em] text-signal">Agentic AI · 5 min read</span>
            <h3 class="font-display font-bold text-[1.125rem] text-ink-900 leading-snug group-hover:text-signal transition-colors">
              Why most agent demos collapse in production
            </h3>
            <p class="font-body text-[0.875rem] leading-relaxed text-ink-700">The gap between a working prototype and a system you can govern.</p>
          </div>
          <span class="font-mono text-[0.6875rem] uppercase tracking-[0.1em] text-ink-500">2026-Q1 →</span>
        </a>

        <a href="/insights" class="group flex flex-col justify-between gap-6 p-8 rounded-2xl bg-[var(--surface-blue)] border border-blue-100 hover:shadow-[0_8px_32px_rgba(59,130,246,0.15)] hover:-translate-y-1 transition-all duration-300 min-h-[280px]">
          <div class="flex flex-col gap-4">
            <span class="font-mono text-[0.625rem] font-bold uppercase tracking-[0.12em] text-blue-600">Data Architecture · 8 min read</span>
            <h3 class="font-display font-bold text-[1.125rem] text-ink-900 leading-snug group-hover:text-blue-600 transition-colors">
              The medallion architecture, decoded
            </h3>
            <p class="font-body text-[0.875rem] leading-relaxed text-ink-700">Why bronze, silver, gold is not just a naming convention.</p>
          </div>
          <span class="font-mono text-[0.6875rem] uppercase tracking-[0.1em] text-ink-500">2026-Q1 →</span>
        </a>

        <a href="/insights" class="group flex flex-col justify-between gap-6 p-8 rounded-2xl bg-[var(--surface-green)] border border-emerald-100 hover:shadow-[0_8px_32px_rgba(16,185,129,0.15)] hover:-translate-y-1 transition-all duration-300 min-h-[280px]">
          <div class="flex flex-col gap-4">
            <span class="font-mono text-[0.625rem] font-bold uppercase tracking-[0.12em] text-emerald-600">BI & Analytics · 6 min read</span>
            <h3 class="font-display font-bold text-[1.125rem] text-ink-900 leading-snug group-hover:text-emerald-600 transition-colors">
              The semantic layer is the new data API
            </h3>
            <p class="font-body text-[0.875rem] leading-relaxed text-ink-700">Why your KPIs need a contract before your agents read them.</p>
          </div>
          <span class="font-mono text-[0.6875rem] uppercase tracking-[0.1em] text-ink-500">2026-Q1 →</span>
        </a>
      </div>
      
      <div class="mt-8 flex justify-end">
        <a href="/concepts"
           class="inline-flex items-center gap-2 font-mono text-[0.6875rem] font-bold uppercase tracking-[0.1em] text-ink-900 hover:text-signal transition-colors">
          Browse the full concept library (50+) →
        </a>
      </div>
    </Container>
  </Section>

  <div class="hairline max-w-[1440px] mx-auto"></div>

  <!-- SECTION 7 — TESTIMONIALS / PROOF -->
  <Section id="testimonials">
    <Container>
      <div class="mb-8">
        <Eyebrow text="07 / 08 — IN THEIR WORDS" />
      </div>
      
      <TestimonialCrossfade client:visible testimonials={testimonials} />
      
      <div class="mt-12 flex justify-center">
        <a href="/contact"
           class="inline-flex items-center gap-2 font-mono text-[0.6875rem] font-bold uppercase tracking-[0.1em] text-ink-900 hover:text-signal transition-colors">
          References available on request →
        </a>
      </div>
    </Container>
  </Section>

</Layout>
