---
import Layout from '../layouts/Layout.astro';
import Container from '../components/layout/Container.astro';
import Section from '../components/layout/Section.astro';
import Eyebrow from '../components/primitives/Eyebrow.astro';
import Heading from '../components/primitives/Heading.astro';
import Prose from '../components/primitives/Prose.astro';

const lastUpdated = "May 2026";
---

<Layout title="Now — Yoann Leny" description="What I am working on this month, what engagements have capacity, and what is fully booked. Updated regularly.">
  
  <Section id="header">
    <Container size="narrow">
      <div class="pt-24 pb-16">
        <Eyebrow text={`UPDATED ${lastUpdated}`} />
        <h1 class="font-display font-black text-ink-900 mt-4 mb-6 leading-[1.08] tracking-[-0.03em]"
            style="font-size: clamp(2.5rem, 5vw, 4rem);">
          What I'm doing now.
        </h1>
        
        <div class="font-body text-ink-900 space-y-10 text-[1.0625rem] leading-[1.7] mt-10">
          <p class="text-[1.25rem] leading-[1.6] font-semibold text-ink-900 mb-10">
            This is my <a href="https://nownownow.com/about" target="_blank" rel="noopener noreferrer" class="text-signal underline decoration-signal/30 underline-offset-4 hover:text-ink-900 transition-colors">now page</a>. It shows my current priorities and availability.
          </p>

          <div>
            <h2 class="font-display font-bold text-[1.5rem] leading-snug text-ink-900 mb-4">Current Focus</h2>
            <div class="space-y-6 text-ink-700">
              <p>
                I am currently wrapping up a 12-month engagement architecting a medallion lakehouse and deterministic agentic layer for a global enterprise client. We are entering the transition phase, moving operations from the build pod to the steady-state platform team.
              </p>
              <p>
                Outside of client work, my main focus is expanding the <a href="/concepts" class="text-signal underline decoration-signal/30 underline-offset-4 hover:text-ink-900 transition-colors">Concept Library</a> on this site, specifically building out the Agentic AI patterns that hold up in production.
              </p>
            </div>
          </div>

          <div class="bg-[var(--surface-indigo)] rounded-2xl p-8 border border-indigo-100">
            <div class="w-8 h-[3px] rounded-full bg-signal mb-4"></div>
            <h2 class="font-display font-bold text-[1.25rem] leading-snug text-ink-900 mb-4">Availability</h2>
            <ul class="list-disc pl-5 space-y-4 text-ink-700 marker:text-signal/50">
              <li><strong>Architect-in-residence:</strong> Fully booked until Q4 2026. Taking preliminary conversations for late Q4 or Q1 2027.</li>
              <li><strong>Executive advisory:</strong> One slot open for a CDO or CTO.</li>
              <li><strong>Diagnostic & rebuild plan:</strong> Available for one 6-week engagement starting in July.</li>
            </ul>
          </div>

          <div>
            <h2 class="font-display font-bold text-[1.5rem] leading-snug text-ink-900 mb-4">Reading</h2>
            <p class="text-ink-700">
              Re-reading <em class="font-semibold text-ink-900 not-italic">Thinking in Systems</em> by Donella Meadows, and catching up on the latest papers regarding Model Context Protocol (MCP) implementations in multi-agent frameworks.
            </p>
          </div>
        </div>
        
        <div class="mt-16 pt-8 border-t border-ink-100 flex justify-end">
          <a href="/contact" class="inline-flex items-center gap-2 font-mono text-[0.6875rem] font-bold uppercase tracking-[0.1em] text-ink-900 hover:text-signal transition-colors">
            Start a conversation →
          </a>
        </div>
      </div>
    </Container>
  </Section>

</Layout>
