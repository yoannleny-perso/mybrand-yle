---
import Layout from '../../layouts/Layout.astro';
import Container from '../../components/layout/Container.astro';
import Section from '../../components/layout/Section.astro';
import Grid from '../../components/layout/Grid.astro';
import Eyebrow from '../../components/primitives/Eyebrow.astro';
import Heading from '../../components/primitives/Heading.astro';

const filters = [
  "ALL",
  "AGENTIC AI",
  "DATA ARCHITECTURE",
  "DATA ENGINEERING",
  "BI & ANALYTICS",
  "OPERATING MODEL",
  "EXECUTIVE"
];

const essays = [
  {
    cluster: "AGENTIC AI",
    title: "The case for deterministic guardrails",
    dek: "The boring half of agent design that decides whether the magical half ever ships.",
    meta: "9 MIN · MARCH 2026",
    href: "/insights/the-case-for-deterministic-guardrails"
  },
  {
    cluster: "DATA ARCHITECTURE",
    title: "Lakehouse, warehouse, mesh — what actually changes for the business",
    dek: "A short decision tree, not a religious debate.",
    meta: "11 MIN · FEBRUARY 2026",
    href: "/insights/lakehouse-warehouse-mesh"
  },
  {
    cluster: "OPERATING MODEL",
    title: "Designing teams for agentic operations",
    dek: "When agents handle execution, your org chart is wrong by default.",
    meta: "13 MIN · FEBRUARY 2026",
    href: "/insights/designing-teams-for-agentic-operations"
  },
  {
    cluster: "BI & ANALYTICS",
    title: "The semantic layer is the new data API",
    dek: "Why your KPIs need a contract before your agents read them.",
    meta: "8 MIN · JANUARY 2026",
    href: "/insights/the-semantic-layer-is-the-new-data-api"
  },
  {
    cluster: "EXECUTIVE",
    title: "Ten numbers that should be on every CEO's data dashboard",
    dek: "And the forty that should not.",
    meta: "7 MIN · JANUARY 2026",
    href: "/insights/ten-numbers-ceo-dashboard"
  },
  {
    cluster: "DATA ENGINEERING",
    title: "The half-life of a data stack is shorter than you think",
    dek: "Architecture decisions made today have a four-year horizon, not ten.",
    meta: "10 MIN · DECEMBER 2025",
    href: "/insights/half-life-of-data-stack"
  },
  {
    cluster: "AGENTIC AI",
    title: "Tool calls are not features. Tools are products.",
    dek: "Treating tools as products is the difference between a clever demo and a governable system.",
    meta: "9 MIN · DECEMBER 2025",
    href: "/insights/tools-are-products"
  },
  {
    cluster: "OPERATING MODEL",
    title: "Data as a product, three years on",
    dek: "What worked, what didn't, what the literature still gets wrong.",
    meta: "12 MIN · NOVEMBER 2025",
    href: "/insights/data-as-a-product-three-years-on"
  }
];
---

<Layout title="Insights — Yoann Leny" description="Essays on data architecture, agentic AI, and the operating model behind both. Updated regularly.">
  
  <Section id="header">
    <Container>
      <div class="pt-24 pb-16">
        <Eyebrow text="INSIGHTS" />
        <h1 class="font-display font-black text-ink-900 mt-4 mb-6 leading-[1.08] tracking-[-0.03em]"
            style="font-size: clamp(2.5rem, 5vw, 4rem);">
          Writing is how I think.
        </h1>
        <p class="font-body text-[1.125rem] leading-[1.75] text-ink-700 max-w-[55ch]">
          Essays on the questions that decide whether data and AI deliver — operating models, architectural choices, and the soft systems that hold both together. For reference material on specific concepts, see the <a href="/concepts" class="text-signal underline decoration-signal/30 underline-offset-4 hover:text-ink-900 transition-colors">concept library</a>.
        </p>
      </div>
    </Container>
  </Section>

  <!-- FEATURED ESSAY -->
  <Section id="featured">
    <Container>
      <a href="/insights/why-most-agent-demos-collapse-in-production" class="group block relative overflow-hidden bg-ink-900 rounded-[20px] mb-16 p-10 md:p-16 hover:bg-ink-1000 transition-colors duration-400 shadow-sm hover:shadow-[0_16px_40px_rgba(0,0,0,0.2)]">
        <div class="relative z-10">
          <div class="font-mono text-[0.6875rem] font-bold uppercase tracking-[0.1em] text-signal mb-8 flex items-center gap-4">
            <span class="w-8 h-[2px] bg-signal inline-block"></span>
            FEATURED · AGENTIC AI
          </div>
          <h2 class="font-display font-bold text-white text-[2rem] leading-[1.15] mb-6 max-w-3xl group-hover:text-signal transition-colors">
            Why most agent demos collapse in production.
          </h2>
          <p class="font-body text-[1.125rem] leading-[1.75] text-ink-300 max-w-2xl mb-12">
            Probabilistic systems can be built in a weekend. Governable ones take a year. The gap between the two is where most AI initiatives quietly fail.
          </p>
          <div class="font-mono text-[0.6875rem] font-bold uppercase tracking-[0.1em] text-ink-500 border-t border-ink-800 pt-6 flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4">
            <span>14 MIN READ · LAST REVIEWED MARCH 2026</span>
            <span class="text-signal flex items-center gap-2 group-hover:gap-3 transition-all">Read the essay <span aria-hidden="true">&rarr;</span></span>
          </div>
        </div>
      </a>
    </Container>
  </Section>

  <!-- ESSAY GRID -->
  <Section id="essays">
    <Container>
      <!-- Filter Row -->
      <div class="mb-16 border-b border-ink-100 pb-4 overflow-x-auto">
        <div class="flex gap-8 font-mono text-[length:var(--t-meta-size)] uppercase tracking-[var(--t-meta-letter)] min-w-max" id="insight-filters">
          {filters.map((filter, i) => (
            <button 
              class={`filter-btn transition-colors ${i === 0 ? 'text-ink-1000 border-b border-ink-1000' : 'text-ink-500 hover:text-ink-1000'}`}
              data-filter={filter === "ALL" ? "all" : filter}
            >
              {filter}
            </button>
          ))}
        </div>
      </div>

      <Grid columns={12} gap="loose">
        {essays.map(essay => (
          <a href={essay.href} data-cluster={essay.cluster} class="insight-card group col-span-12 md:col-span-6 lg:col-span-4 flex flex-col justify-between p-8 border border-ink-100 bg-paper-0 rounded-[var(--radius-sm)] shadow-[var(--shadow-card)] hover:-translate-y-1 hover:shadow-hover transition-all duration-300 min-h-[300px]">
            <div>
              <div class="font-mono text-[11px] font-semibold uppercase tracking-[0.08em] text-signal mb-5">
                {essay.cluster}
              </div>
              <h3 class="font-display font-semibold text-[1.375rem] leading-[1.3] tracking-[-0.01em] text-ink-1000 mb-4 group-hover:text-signal transition-colors duration-200">
                {essay.title}
              </h3>
              <p class="font-body text-[0.9375rem] leading-[1.6] text-ink-700">
                {essay.dek}
              </p>
            </div>
            <div class="font-mono text-[11px] uppercase tracking-[0.08em] text-ink-500 mt-8 pt-4 border-t border-ink-100 flex justify-between items-center">
              <span>{essay.meta}</span>
              <span class="opacity-0 group-hover:opacity-100 group-hover:translate-x-1 transition-all duration-300" aria-hidden="true">&rarr;</span>
            </div>
          </a>
        ))}
      </Grid>
    </Container>
  </Section>

  <div class="hairline max-w-[1440px] mx-auto my-16"></div>

  <!-- CONCEPT LIBRARY CROSS-LINK -->
  <Section id="reference">
    <Container>
      <div class="max-w-2xl mx-auto text-center py-8">
        <div class="font-mono text-[0.6875rem] font-bold uppercase tracking-[0.1em] text-ink-500 mb-6">REFERENCE</div>
        <h2 class="font-display font-bold text-ink-900 mt-4 mb-6 leading-[1.15] tracking-[-0.02em]"
            style="font-size: clamp(1.5rem, 3vw, 2.25rem);">
          Need a definition, not an opinion?
        </h2>
        <p class="font-body text-[1rem] leading-[1.7] text-ink-700 mb-8">
          The <a href="/concepts" class="text-signal font-semibold hover:text-ink-900 underline decoration-signal/30 underline-offset-4 transition-colors">concept library</a> is where I put the reference material — definitions, vendor comparisons, and architectural patterns. Currently 50+ entries across data architecture, data engineering, BI and analytics, and agentic AI.
        </p>
        <a href="/concepts" class="font-mono text-[0.6875rem] font-bold uppercase tracking-[0.1em] text-ink-900 hover:text-signal transition-colors inline-flex items-center gap-2">
          Browse the concept library <span aria-hidden="true">&rarr;</span>
        </a>
      </div>
    </Container>
  </Section>

  <Section id="closing" background="ink">
    <Container>
      <div class="py-24 text-center max-w-4xl mx-auto">
        <h2 class="font-display font-black text-paper-50 mb-12 leading-[1.08] tracking-[-0.03em]"
            style="font-size: clamp(2rem, 4vw, 3rem);">
          <span class="block text-ink-300 font-medium text-[0.8em] mb-4">If something here is useful — say so.</span>
          <span class="block">If something here is wrong — say that too.</span>
        </h2>
        <div class="flex flex-col sm:flex-row items-center justify-center gap-6 font-mono text-[0.6875rem] font-bold uppercase tracking-[0.1em]">
          <a href="mailto:yoann.leny@gmail.com" class="bg-signal text-white px-8 py-4 rounded-xl hover:bg-signal/90 hover:-translate-y-1 hover:shadow-[0_8px_24px_rgba(99,102,241,0.25)] transition-all duration-300">Send a direct email &rarr;</a>
        </div>
      </div>
    </Container>
  </Section>
</Layout>

<script>
  // Client-side filtering with a soft fade — re-initialized after view transitions.
  function initInsightFilters() {
    const buttons = document.querySelectorAll<HTMLButtonElement>('.filter-btn');
    const cards = document.querySelectorAll<HTMLElement>('.insight-card');
    if (buttons.length === 0) return;

    cards.forEach((c) => {
      c.style.transition = 'opacity 240ms cubic-bezier(0.16, 1, 0.3, 1), transform 240ms cubic-bezier(0.16, 1, 0.3, 1)';
    });

    buttons.forEach((btn) => {
      btn.addEventListener('click', () => {
        buttons.forEach((b) => {
          b.classList.remove('text-ink-1000', 'border-b', 'border-ink-1000');
          b.classList.add('text-ink-500');
        });
        btn.classList.add('text-ink-1000', 'border-b', 'border-ink-1000');
        btn.classList.remove('text-ink-500');

        const filterValue = btn.getAttribute('data-filter');

        cards.forEach((card) => {
          const show = filterValue === 'all' || card.getAttribute('data-cluster') === filterValue;
          if (show) {
            card.style.display = 'flex';
            requestAnimationFrame(() => {
              card.style.opacity = '1';
              card.style.transform = 'none';
            });
          } else {
            card.style.opacity = '0';
            card.style.transform = 'scale(0.98)';
            setTimeout(() => {
              if (card.style.opacity === '0') card.style.display = 'none';
            }, 240);
          }
        });
      });
    });
  }

  initInsightFilters();
  document.addEventListener('astro:page-load', initInsightFilters);
</script>
