---
import { getCollection } from 'astro:content';
import InsightDetail from '../../components/pages/InsightDetail.astro';

export async function getStaticPaths() {
  const insights = await getCollection('insights');
  return insights.map((entry) => ({ params: { slug: entry.data.slug || entry.id }, props: { entry } }));
}
const { entry } = Astro.props;
---
<InsightDetail locale="en" entry={entry} />
