---
import { getCollection } from 'astro:content';
import InsightDetail from '../../../components/pages/InsightDetail.astro';
import type { Locale } from '../../../data/localized-site';

export async function getStaticPaths() {
  const insights = await getCollection('insights');
  return (['fr', 'es'] as const).flatMap((locale) => insights.map((entry) => ({ params: { lang: locale, slug: entry.data.slug || entry.id }, props: { entry, locale } })));
}
const { entry, locale } = Astro.props as { entry: Awaited<ReturnType<typeof getCollection<'insights'>>>[number]; locale: Locale };
---
<InsightDetail locale={locale} entry={entry} />
