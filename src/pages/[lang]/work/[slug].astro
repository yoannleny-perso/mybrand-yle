---
import { getCollection } from 'astro:content';
import WorkDetail from '../../../components/pages/WorkDetail.astro';

export async function getStaticPaths() {
  const caseStudies = await getCollection('case-studies');
  const locales = ['fr', 'es'] as const;

  return locales.flatMap((locale) => caseStudies.map((entry) => ({
    params: { lang: locale, slug: entry.data.slug || entry.id },
    props: { entry, locale },
  })));
}

const { entry, locale } = Astro.props;
---

<WorkDetail locale={locale} entry={entry} />
