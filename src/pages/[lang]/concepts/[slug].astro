---
import { getCollection, render } from 'astro:content';
import Layout from '../../../layouts/Layout.astro';
import Container from '../../../components/layout/Container.astro';
import Section from '../../../components/layout/Section.astro';
import Eyebrow from '../../../components/primitives/Eyebrow.astro';
import Heading from '../../../components/primitives/Heading.astro';
import Prose from '../../../components/primitives/Prose.astro';

export async function getStaticPaths() {
  const concepts = await getCollection('concepts');
  const locales = ['fr', 'es'];
  
  const paths = [];
  for (const locale of locales) {
    for (const entry of concepts) {
      paths.push({
        params: {
          lang: locale,
          slug: entry.data.slug || entry.id
        },
        props: {
          entry,
          lang: locale
        }
      });
    }
  }
  return paths;
}

const { entry, lang } = Astro.props;
const { Content } = await render(entry);

const depthTranslated = lang === 'fr' 
  ? (entry.data.depth === 'foundational' || !entry.data.depth ? 'FONDAMENTAL' : entry.data.depth === 'intermediate' ? 'INTERMÉDIAIRE' : 'AVANCÉ') 
  : (entry.data.depth === 'foundational' || !entry.data.depth ? 'FUNDAMENTAL' : entry.data.depth === 'intermediate' ? 'INTERMEDIO' : 'AVANZADO');

const clusterTranslated = lang === 'fr'
  ? entry.data.cluster?.replace('data-architecture', 'Architecture des Données')
                       .replace('data-engineering', 'Ingénierie des Données')
                       .replace('bi-analytics', 'BI & Décisionnel')
                       .replace('agentic-ai', 'IA Agentique')
  : entry.data.cluster?.replace('data-architecture', 'Arquitectura de Datos')
                       .replace('data-engineering', 'Ingeniería de Datos')
                       .replace('bi-analytics', 'BI y Analítica')
                       .replace('agentic-ai', 'IA Agéntica');
---

<Layout title={`${entry.data.title} — ${lang === 'fr' ? 'Bibliothèque de concepts' : 'Biblioteca de conceptos'} — Yoann Leny`} description={entry.data.definition}>

  <div class="reading-progress" aria-hidden="true"></div>

  <Section id="header">
    <Container size="narrow">
      <div class="pt-24 pb-8">
        <div class="font-mono text-[length:var(--t-meta-size)] uppercase tracking-[var(--t-meta-letter)] text-ink-500 mb-8 border-b border-ink-100 pb-4">
          {clusterTranslated} &middot; {depthTranslated} &middot; {entry.data.readingTime} {lang === 'fr' ? 'MIN DE LECTURE' : 'MIN DE LECTURA'} &middot; {lang === 'fr' ? 'DERNIÈRE RÉVISION' : 'ÚLTIMA REVISIÓN'} {entry.data.lastReviewed}
        </div>
        
        <Heading level={1} as="h1" class="mb-6">
          {entry.data.title}
        </Heading>
        
        <p class="font-body text-[length:var(--t-body-l-size)] leading-[var(--t-body-l-line)] text-ink-500 max-w-[60ch]">
          {entry.data.definition}
        </p>
      </div>
    </Container>
  </Section>

  <Section id="content">
    <Container size="narrow">
      <Prose>
        <Content />
      </Prose>
      
      {entry.data.relatedConcepts && entry.data.relatedConcepts.length > 0 && (
        <div class="mt-24 pt-12 border-t border-ink-100">
          <div class="font-mono text-[length:var(--t-meta-size)] uppercase tracking-[var(--t-meta-letter)] text-ink-500 mb-4">
            {lang === 'fr' ? 'Lectures connexes' : 'Lecturas relacionadas'}
          </div>
          <ul class="list-disc pl-5 space-y-2 font-body text-[length:var(--t-body-size)] text-ink-700 marker:text-ink-300">
            {entry.data.relatedConcepts.map((concept: string) => (
              <li>
                <a href={`/${lang}/concepts/${concept}`} class="text-ink-1000 hover:text-ink-500 underline decoration-ink-100 underline-offset-4">
                  {concept.replace(/-/g, ' ')}
                </a>
              </li>
            ))}
          </ul>
        </div>
      )}
    </Container>
  </Section>

</Layout>
