---
import { getCollection } from 'astro:content';
import ConceptDetail from '../../../components/pages/ConceptDetail.astro';
import type { Locale } from '../../../data/localized-site';

export async function getStaticPaths() {
  const concepts = await getCollection('concepts');
  return (['fr', 'es'] as const).flatMap((locale) => concepts.map((entry) => ({ params: { lang: locale, slug: entry.data.slug || entry.id }, props: { entry, locale } })));
}
const { entry, locale } = Astro.props as { entry: Awaited<ReturnType<typeof getCollection<'concepts'>>>[number]; locale: Locale };
---
<ConceptDetail locale={locale} entry={entry} />
