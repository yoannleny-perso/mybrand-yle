---
import Layout from '../../../layouts/Layout.astro';
import Container from '../../../components/layout/Container.astro';
import Section from '../../../components/layout/Section.astro';
import Grid from '../../../components/layout/Grid.astro';
import Eyebrow from '../../../components/primitives/Eyebrow.astro';
import Heading from '../../../components/primitives/Heading.astro';

const filters = [
  { key: "all", display: "TODOS" },
  { key: "AGENTIC AI", display: "IA AGÉNTICA" },
  { key: "DATA ARCHITECTURE", display: "ARQUITECTURA DE DATOS" },
  { key: "DATA ENGINEERING", display: "INGENIERÍA DE DATOS" },
  { key: "BI & ANALYTICS", display: "BI Y ANALÍTICA" },
  { key: "OPERATING MODEL", display: "MODELO OPERATIVO" },
  { key: "EXECUTIVE", display: "EJECUTIVO" }
];

const essays = [
  {
    cluster: "AGENTIC AI",
    title: "El caso de las barandillas de seguridad deterministas",
    dek: "La mitad aburrida del diseño de agentes que decide si la mitad mágica alguna vez se implementa en producción.",
    meta: "9 MIN · MARZO 2026",
    href: "/es/insights/the-case-for-deterministic-guardrails"
  },
  {
    cluster: "DATA ARCHITECTURE",
    title: "Lakehouse, warehouse, mesh — qué cambia realmente para el negocio",
    dek: "Un árbol de decisiones corto, no un debate teológico.",
    meta: "11 MIN · FEBRERO 2026",
    href: "/es/insights/lakehouse-warehouse-mesh"
  },
  {
    cluster: "OPERATING MODEL",
    title: "Diseño de equipos para operaciones agénticas",
    dek: "Cuando los agentes se encargan de la ejecución, tu organigrama está mal por defecto.",
    meta: "13 MIN · FEBRERO 2026",
    href: "/es/insights/designing-teams-for-agentic-operations"
  },
  {
    cluster: "BI & ANALYTICS",
    title: "La capa semántica es la nueva API de datos",
    dek: "Por qué tus KPIs necesitan un contrato antes de que tus agentes los lean.",
    meta: "8 MIN · ENERO 2026",
    href: "/es/insights/the-semantic-layer-is-the-new-data-api"
  },
  {
    cluster: "EXECUTIVE",
    title: "Diez números que deberían estar en el dashboard de cada CEO",
    dek: "Y los cuarenta que no deberían.",
    meta: "7 MIN · ENERO 2026",
    href: "/es/insights/ten-numbers-ceo-dashboard"
  },
  {
    cluster: "DATA ENGINEERING",
    title: "La vida media de un stack de datos es más corta de lo que piensas",
    dek: "Las decisiones de arquitectura que se toman hoy tienen un horizonte de cuatro años, no de diez.",
    meta: "10 MIN · DICIEMBRE 2025",
    href: "/es/insights/half-life-of-data-stack"
  },
  {
    cluster: "AGENTIC AI",
    title: "Las llamadas a herramientas no son características. Las herramientas son productos.",
    dek: "Tratar las herramientas como productos es la diferencia entre una demo ingeniosa y un sistema gobernable.",
    meta: "9 MIN · DICIEMBRE 2025",
    href: "/es/insights/tools-are-products"
  },
  {
    cluster: "OPERATING MODEL",
    title: "Datos como producto, tres años después",
    dek: "Qué funcionó, qué no y qué sigue entendiendo mal la literatura de la industria.",
    meta: "12 MIN · NOVIEMBRE 2025",
    href: "/es/insights/data-as-a-product-three-years-on"
  }
];
---

<Layout title="Perspectivas y Ensayos — Yoann Leny" description="Ensayos sobre arquitectura de datos, IA agéntica y el modelo operativo detrás de ambos. Actualizado regularmente.">
  
  <Section id="header">
    <Container>
      <div class="pt-24 pb-16">
        <Eyebrow text="PERSPECTIVAS" />
        <h1 class="font-display font-black text-ink-900 mt-4 mb-6 leading-[1.08] tracking-[-0.03em]"
            style="font-size: clamp(2.5rem, 5vw, 4rem);">
          Escribir es mi forma de pensar.
        </h1>
        <p class="font-body text-[1.125rem] leading-[1.75] text-ink-700 max-w-[55ch]">
          Ensayos sobre las preguntas clave que determinan si los datos y la IA generan valor real: modelos operativos, decisiones de arquitectura y los sistemas blandos organizacionales que los sostienen. Para material de referencia sobre conceptos específicos, consulte la <a href="/es/concepts" class="text-signal underline decoration-signal/30 underline-offset-4 hover:text-ink-900 transition-colors">biblioteca de conceptos</a>.
        </p>
      </div>
    </Container>
  </Section>

  <!-- FEATURED ESSAY -->
  <Section id="featured">
    <Container>
      <a href="/es/insights/why-most-agent-demos-collapse-in-production" class="group block relative overflow-hidden bg-ink-900 rounded-[20px] mb-16 p-10 md:p-16 hover:bg-ink-1000 transition-colors duration-400 shadow-sm hover:shadow-[0_16px_40px_rgba(0,0,0,0.2)]">
        <div class="relative z-10">
          <div class="font-mono text-[0.6875rem] font-bold uppercase tracking-[0.1em] text-signal mb-8 flex items-center gap-4">
            <span class="w-8 h-[2px] bg-signal inline-block"></span>
            DESTACADO · IA AGÉNTICA
          </div>
          <h2 class="font-display font-bold text-white text-[2rem] leading-[1.15] mb-6 max-w-3xl group-hover:text-signal transition-colors">
            Por qué la mayoría de las demos de agentes colapsan en producción.
          </h2>
          <p class="font-body text-[1.125rem] leading-[1.75] text-ink-300 max-w-2xl mb-12">
            Los sistemas probabilísticos se pueden construir en un fin de semana. Los gobernables toman un año. La brecha entre ambos es donde la mayoría de las iniciativas de IA fracasan silencieusement (silenciosamente).
          </p>
          <div class="font-mono text-[0.6875rem] font-bold uppercase tracking-[0.1em] text-ink-500 border-t border-ink-800 pt-6 flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4">
            <span>14 MIN DE LECTURA · ÚLTIMA REVISIÓN EN MARZO DE 2026</span>
            <span class="text-signal flex items-center gap-2 group-hover:gap-3 transition-all">Leer el ensayo <span aria-hidden="true">&rarr;</span></span>
          </div>
        </div>
      </a>
    </Container>
  </Section>

  <!-- ESSAY GRID -->
  <Section id="essays">
    <Container>
      <!-- Filter Row -->
      <div class="mb-16 border-b border-ink-100 pb-4 overflow-x-auto">
        <div class="flex gap-8 font-mono text-[length:var(--t-meta-size)] uppercase tracking-[var(--t-meta-letter)] min-w-max" id="insight-filters">
          {filters.map((filter, i) => (
            <button 
              class={`filter-btn transition-colors py-3 cursor-pointer ${i === 0 ? 'text-ink-1000 border-b border-ink-1000' : 'text-ink-500 hover:text-ink-1000'}`}
              data-filter={filter.key}
            >
              {filter.display}
            </button>
          ))}
        </div>
      </div>

      <Grid columns={12} gap="loose">
        {essays.map(essay => (
          <a href={essay.href} data-cluster={essay.cluster} class="insight-card group col-span-12 md:col-span-6 lg:col-span-4 flex flex-col justify-between p-8 border border-ink-100 bg-paper-0 rounded-[var(--radius-sm)] shadow-[var(--shadow-card)] hover:-translate-y-1 hover:shadow-hover transition-all duration-300 min-h-[300px]">
            <div>
              <div class="font-mono text-[length:var(--t-meta-size)] uppercase tracking-[var(--t-meta-letter)] text-ink-500 mb-6">
                {essay.cluster}
              </div>
              <h3 class="font-display font-semibold text-[1.375rem] leading-[1.3] tracking-[-0.01em] text-ink-1000 mb-4 group-hover:text-signal transition-colors duration-200">
                {essay.title}
              </h3>
              <p class="font-body text-[length:var(--t-body-s-size)] leading-[var(--t-body-s-line)] text-ink-700">
                {essay.dek}
              </p>
            </div>
            <div class="font-mono text-[length:var(--t-meta-size)] uppercase tracking-[var(--t-meta-letter)] text-ink-500 mt-8 pt-4 border-t border-ink-100">
              {essay.meta}
            </div>
          </a>
        ))}
      </Grid>
    </Container>
  </Section>

  <div class="hairline max-w-[1440px] mx-auto my-16"></div>

  <!-- CONCEPT LIBRARY CROSS-LINK -->
  <Section id="reference">
    <Container>
      <div class="max-w-2xl mx-auto text-center py-8">
        <div class="font-mono text-[0.6875rem] font-bold uppercase tracking-[0.1em] text-ink-500 mb-6">REFERENCIA</div>
        <h2 class="font-display font-bold text-ink-900 mt-4 mb-6 leading-[1.15] tracking-[-0.02em]"
            style="font-size: clamp(1.5rem, 3vw, 2.25rem);">
          ¿Necesitas una definición en lugar de una opinión?
        </h2>
        <p class="font-body text-[1rem] leading-[1.7] text-ink-700 mb-8">
          La <a href="/es/concepts" class="text-signal font-semibold hover:text-ink-900 underline decoration-signal/30 underline-offset-4 transition-colors">biblioteca de conceptos</a> es donde coloco el material de referencia — definiciones, comparaciones de proveedores y patrones arquitectónicos. Actualmente con más de 50 entradas sobre arquitectura, ingeniería de datos, BI y analítica, e IA agéntica.
        </p>
        <a href="/es/concepts" class="font-mono text-[0.6875rem] font-bold uppercase tracking-[0.1em] text-ink-900 hover:text-signal transition-colors inline-flex items-center gap-2">
          Explorar la biblioteca de conceptos <span aria-hidden="true">&rarr;</span>
        </a>
      </div>
    </Container>
  </Section>

  <Section id="closing" background="ink">
    <Container>
      <div class="py-24 text-center max-w-4xl mx-auto">
        <h2 class="font-display font-black text-paper-50 mb-12 leading-[1.08] tracking-[-0.03em]"
            style="font-size: clamp(2rem, 4vw, 3rem);">
          <span class="block text-ink-300 font-medium text-[0.8em] mb-4">Si algo de aquí te resulta útil — dímelo.</span>
          <span class="block">Si algo está mal — dímelo también.</span>
        </h2>
        <div class="flex flex-col sm:flex-row items-center justify-center gap-6 font-mono text-[0.6875rem] font-bold uppercase tracking-[0.1em]">
          <a href="mailto:yoann.leny@gmail.com" class="bg-signal text-white px-8 py-4 rounded-xl hover:bg-signal/90 hover:-translate-y-1 hover:shadow-[0_8px_24px_rgba(99,102,241,0.25)] transition-all duration-300">Enviar un correo directo &rarr;</a>
        </div>
      </div>
    </Container>
  </Section>
</Layout>

<script>
  // Simple client-side filtering
  const buttons = document.querySelectorAll('.filter-btn');
  const cards = document.querySelectorAll('.insight-card');

  buttons.forEach(btn => {
    btn.addEventListener('click', () => {
      // Update active button state
      buttons.forEach(b => {
        b.classList.remove('text-ink-1000', 'border-b', 'border-ink-1000');
        b.classList.add('text-ink-500');
      });
      btn.classList.add('text-ink-1000', 'border-b', 'border-ink-1000');
      btn.classList.remove('text-ink-500');

      const filterValue = btn.getAttribute('data-filter');

      // Filter cards
      cards.forEach((card: any) => {
        if (filterValue === 'all') {
          card.style.display = 'flex';
        } else {
          const cluster = card.getAttribute('data-cluster');
          if (cluster === filterValue) {
            card.style.display = 'flex';
          } else {
            card.style.display = 'none';
          }
        }
      });
    });
  });
</script>
