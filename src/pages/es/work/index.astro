---
import Layout from '../../../layouts/Layout.astro';
import Container from '../../../components/layout/Container.astro';
import Section from '../../../components/layout/Section.astro';
import Grid from '../../../components/layout/Grid.astro';
import Eyebrow from '../../../components/primitives/Eyebrow.astro';
import Heading from '../../../components/primitives/Heading.astro';
import AsymmetricCard from '../../../components/sections/AsymmetricCard.astro';

const filters = [
  { key: "all", display: "TODOS" },
  { key: "data platforms", display: "PLATAFORMAS DE DATOS" },
  { key: "agentic ai", display: "IA AGÉNTICA" },
  { key: "operating model", display: "MODELO OPERATIVO" },
  { key: "executive", display: "EJECUTIVO" }
];
---

<Layout title="Casos de Estudio — Yoann Leny" description="Trabajo seleccionado: tracker de habilidades multiagente, stack de medallón corporativo, capa semántica lista para IA, modelo de escala global de DataOps. Resultados, decisiones y qué haría diferente.">
  
  <Section id="header">
    <Container>
      <div class="pt-24 pb-8">
        <Eyebrow text="RÉCORD DE TRABAJO" />
        <h1 class="font-display font-black text-ink-900 mt-4 mb-6 leading-[1.08] tracking-[-0.03em]"
            style="font-size: clamp(2.5rem, 5vw, 4rem);">
          <span class="block">Trabajos de producción seleccionados.</span>
          <span class="block text-signal">Cada entrada es un sistema en servicio.</span>
        </h1>
        <p class="font-body text-[1.125rem] leading-[1.75] text-ink-700 max-w-[55ch]">
          Una pequeña selección de proyectos donde las decisiones de arquitectura, el modelo operativo y los resultados reales se pueden presentar de manera abierta. Ejemplos anonimizados están disponibles a solicitud para proyectos bajo acuerdo de confidencialidad (NDA).
        </p>
      </div>
    </Container>
  </Section>

  <Section id="gallery">
    <Container>
      <!-- Filter Row -->
      <div class="mb-16 border-b border-ink-100 pb-4 overflow-x-auto">
        <div class="flex gap-8 font-mono text-[length:var(--t-meta-size)] uppercase tracking-[var(--t-meta-letter)] min-w-max" id="work-filters">
          {filters.map((filter, i) => (
            <button 
              class={`filter-btn transition-colors py-3 cursor-pointer ${i === 0 ? 'text-ink-1000 border-b border-ink-1000' : 'text-ink-500 hover:text-ink-1000'}`}
              data-filter={filter.key}
            >
              {filter.display}
            </button>
          ))}
        </div>
      </div>

      <!-- Case Studies Gallery -->
      <div id="projects-grid">
        <Grid columns={12} gap="loose">
          <div class="project-wrapper col-span-12 md:col-span-5 flex" data-categories="agentic ai, operating model">
            <AsymmetricCard
              size="tall"
              pattern="agents"
              tag="2025 · CORPORATIVO · 18 MESES"
              title="Tracker de habilidades multiagente"
              description="Un sistema jerárquico de agentes que mantiene un gráfico de habilidades en vivo para más de 40 consultores, recomendando asignaciones de personal, detectando brechas de conocimiento y dando a la dirección un reporte semanal de disponibilidad (bench)."
              metrics={[
                { value: "+15%", label: "utilización" },
                { value: "-22%", label: "tiempo de espera" },
                { value: "3", label: "regiones" }
              ]}
              href="/es/work/multi-agent-skill-tracker"
              categories="agentic ai, operating model"
            />
          </div>

          <div class="project-wrapper col-span-12 md:col-span-7 flex" data-categories="data platforms, operating model">
            <AsymmetricCard
              size="wide"
              pattern="layers"
              tag="2024 · GLOBAL · 12 MESES"
              title="Stack de Medallón Corporativo"
              description="Un lakehouse de bronce–plata–oro implementado en tres regiones con una capa semántica gobernada. Analítica, ML y flujos de trabajo de agentes ahora leen desde una única fuente de verdad."
              metrics={[
                { value: "+$13M", label: "impacto en ingresos" },
                { value: "9 meses", label: "payback" },
                { value: "0", label: "desviaciones de KPI" }
              ]}
              href="/es/work/enterprise-medallion-stack"
              categories="data platforms, operating model"
            />
          </div>

          <div class="project-wrapper col-span-12 md:col-span-5 flex" data-categories="data platforms, agentic ai">
            <AsymmetricCard
              size="square"
              pattern="semantic"
              tag="2024 · MEDIANA EMPRESA · 6 MESES"
              title="Capa Semántica Lista para IA"
              description="Una capa de métricas rediseñada específicamente para el consumo de LLMs y agentes de IA, eliminando la alucinación de KPIs y estandarizando cómo la IA analiza el negocio."
              metrics={[
                { value: "0", label: "desviaciones de KPI" },
                { value: "47", label: "métricas conformes" },
                { value: "4", label: "sistemas LLM" }
              ]}
              href="/es/work/ai-ready-semantic-layer"
              categories="data platforms, agentic ai"
            />
          </div>

          <div class="project-wrapper col-span-12 md:col-span-7 flex" data-categories="operating model, executive">
            <AsymmetricCard
              size="wide"
              pattern="org"
              tag="2023 · GLOBAL · 24 MESES"
              title="Modelo de Escala DataOps Global"
              description="Modelo operativo para una función de datos de 40 personas en tres regiones: diseño de pods, división de roles, ritos de trabajo y una capa de observabilidad interna para la salud de las entregas."
              metrics={[
                { value: "40+", label: "expertos" },
                { value: "3", label: "regiones" },
                { value: "4 T", label: "a estabilidad" }
              ]}
              href="/es/work/global-data-ops-scaling-model"
              categories="operating model, executive"
            />
          </div>
        </Grid>
      </div>
    </Container>
  </Section>

  <Section id="closing" background="ink">
    <Container>
      <div class="py-24 text-center max-w-4xl mx-auto">
        <h2 class="font-display font-black text-paper-50 mb-12 leading-[1.08] tracking-[-0.03em]"
            style="font-size: clamp(2rem, 4vw, 3rem);">
          <span class="block">El trabajo en producción es la única prueba que importa.</span>
        </h2>
        <div class="flex flex-col sm:flex-row items-center justify-center gap-6 font-mono text-[0.6875rem] font-bold uppercase tracking-[0.1em]">
          <a href="/es/contact" class="bg-signal text-white px-8 py-4 rounded-xl hover:bg-signal/90 hover:-translate-y-1 hover:shadow-[0_8px_24px_rgba(99,102,241,0.25)] transition-all duration-300">Iniciar conversación &rarr;</a>
          <a href="/es/about" class="text-paper-50 hover:text-signal transition-colors pb-1 border-b-2 border-transparent hover:border-signal">Ver mi enfoque</a>
        </div>
      </div>
    </Container>
  </Section>
</Layout>

<script>
  // Client-side filtering with a soft fade — re-initialized after view transitions.
  function initWorkFilters() {
    const buttons = document.querySelectorAll<HTMLButtonElement>('.filter-btn');
    const projects = document.querySelectorAll<HTMLElement>('.project-wrapper');
    if (buttons.length === 0) return;

    projects.forEach((p) => {
      p.style.transition = 'opacity 240ms cubic-bezier(0.16, 1, 0.3, 1), transform 240ms cubic-bezier(0.16, 1, 0.3, 1)';
    });

    buttons.forEach((btn) => {
      btn.addEventListener('click', () => {
        buttons.forEach((b) => {
          b.classList.remove('text-ink-1000', 'border-b', 'border-ink-1000');
          b.classList.add('text-ink-500');
        });
        btn.classList.add('text-ink-1000', 'border-b', 'border-ink-1000');
        btn.classList.remove('text-ink-500');

        const filterValue = btn.getAttribute('data-filter');

        projects.forEach((project) => {
          const categories = project.getAttribute('data-categories') || '';
          const show = filterValue === 'all' || categories.includes(filterValue || '');

          if (show) {
            project.style.display = 'flex';
            requestAnimationFrame(() => {
              project.style.opacity = '1';
              project.style.transform = 'none';
            });
          } else {
            project.style.opacity = '0';
            project.style.transform = 'scale(0.98)';
            setTimeout(() => {
              if (project.style.opacity === '0') project.style.display = 'none';
            }, 240);
          }
        });
      });
    });
  }

  initWorkFilters();
  document.addEventListener('astro:page-load', initWorkFilters);
</script>
