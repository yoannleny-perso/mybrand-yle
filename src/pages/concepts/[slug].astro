---
import { getCollection } from 'astro:content';
import ConceptDetail from '../../components/pages/ConceptDetail.astro';

export async function getStaticPaths() {
  const concepts = await getCollection('concepts');
  return concepts.map((entry) => ({ params: { slug: entry.data.slug || entry.id }, props: { entry } }));
}
const { entry } = Astro.props;
---
<ConceptDetail locale="en" entry={entry} />
