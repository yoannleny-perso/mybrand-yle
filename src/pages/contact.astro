---
import Layout from '../layouts/Layout.astro';
import Container from '../components/layout/Container.astro';
import Section from '../components/layout/Section.astro';
import Grid from '../components/layout/Grid.astro';
import Eyebrow from '../components/primitives/Eyebrow.astro';
import Heading from '../components/primitives/Heading.astro';
import { EnvelopeSimple, LinkedinLogo, CalendarBlank } from '@phosphor-icons/react';
---

<Layout title="Contact — Yoann Leny" description="Three ways to engage: architect-in-residence, executive advisory, diagnostic and rebuild plan. Direct contact and current availability.">
  
  <Section id="header">
    <Container>
      <div class="pt-24 pb-16">
        <Eyebrow text="CONTACT" />
        <h1 class="font-display font-black text-ink-900 mt-4 mb-6 leading-[1.08] tracking-[-0.03em]"
            style="font-size: clamp(2.5rem, 5vw, 4rem);">
          The fastest way is direct.
        </h1>
        <p class="font-body text-[1.125rem] leading-[1.75] text-ink-700 max-w-[55ch]">
          Three paths below — pick whichever fits the conversation you want to have. I read every message myself.
        </p>
        <p class="font-body text-[1rem] leading-[1.7] text-ink-700 max-w-[55ch] mt-4">
          <span class="font-semibold text-ink-900">Hiring?</span> I am currently exploring VP / Head of Data &amp; AI leadership roles — the short version is on the <a href="/hire" class="text-signal font-semibold underline decoration-signal/30 underline-offset-4 hover:text-ink-900 transition-colors">hiring page</a>.
        </p>
      </div>
    </Container>
  </Section>

  <Section id="paths">
    <Container>
      <Grid columns={12}>
        <div class="col-span-12 md:col-span-4 flex flex-col gap-6 p-8 border border-indigo-100 bg-[var(--surface-indigo)] rounded-[20px] shadow-sm hover:shadow-[0_8px_32px_rgba(99,102,241,0.15)] transition-all duration-300 hover:-translate-y-1">
          <EnvelopeSimple size={24} weight="regular" className="text-signal" />
          <div class="flex flex-col gap-2">
            <div class="font-mono text-[0.6875rem] font-bold uppercase tracking-[0.1em] text-signal">DIRECT EMAIL</div>
            <h3 class="font-display font-bold text-[1.25rem] leading-snug">
              <a href="mailto:yoann.leny@gmail.com" class="hover:text-signal transition-colors text-ink-900 break-all">yoann.leny@gmail.com</a>
            </h3>
          </div>
          <p class="font-body text-[0.9375rem] leading-[1.7] text-ink-700">
            For introductions, project briefs, and longer messages. Best for senior conversations.
          </p>
        </div>

        <div class="col-span-12 md:col-span-4 flex flex-col gap-6 p-8 border border-blue-100 bg-[var(--surface-blue)] rounded-[20px] shadow-sm hover:shadow-[0_8px_32px_rgba(59,130,246,0.15)] transition-all duration-300 hover:-translate-y-1 mt-6 md:mt-0">
          <LinkedinLogo size={24} weight="regular" className="text-blue-600" />
          <div class="flex flex-col gap-2">
            <div class="font-mono text-[0.6875rem] font-bold uppercase tracking-[0.1em] text-blue-600">LINKEDIN</div>
            <h3 class="font-display font-bold text-[1.125rem] leading-snug">
              <a href="https://www.linkedin.com/in/yoann-leny-10144b37/" target="_blank" rel="noopener noreferrer" class="hover:text-blue-600 transition-colors text-ink-900">Yoann Leny on LinkedIn</a>
            </h3>
          </div>
          <p class="font-body text-[0.9375rem] leading-[1.7] text-ink-700">
            For peers, recruiters, and networking. Lower priority than email.
          </p>
        </div>

        <div class="col-span-12 md:col-span-4 flex flex-col gap-6 p-8 border border-emerald-100 bg-[var(--surface-green)] rounded-[20px] shadow-sm hover:shadow-[0_8px_32px_rgba(16,185,129,0.15)] transition-all duration-300 hover:-translate-y-1 mt-6 md:mt-0">
          <CalendarBlank size={24} weight="regular" className="text-emerald-600" />
          <div class="flex flex-col gap-2">
            <div class="font-mono text-[0.6875rem] font-bold uppercase tracking-[0.1em] text-emerald-600">30-MINUTE CALL</div>
            <h3 class="font-display font-bold text-[1.25rem] leading-snug">
              <a href="mailto:yoann.leny@gmail.com?subject=30-minute%20call%20request" class="hover:text-emerald-600 transition-colors text-ink-900">Request a slot</a>
            </h3>
          </div>
          <p class="font-body text-[0.9375rem] leading-[1.7] text-ink-700">
            A pre-screened slot for serious project conversations. Use the email path first if it's a longer brief.
          </p>
        </div>
      </Grid>
    </Container>
  </Section>

  <Section id="what-to-include">
    <Container>
      <div class="max-w-[70ch] mx-auto py-16">
        <Eyebrow text="IF WE'RE LIKELY TO WORK TOGETHER" />
        <div class="font-body text-[1rem] leading-[1.7] text-ink-900 space-y-6 mt-6">
          <p>A useful first message usually contains four things:</p>
          <ol class="list-decimal pl-5 space-y-3 text-ink-700 marker:text-ink-300 marker:font-mono">
            <li>Where the company is today — stage, size, sector.</li>
            <li>What you've already tried.</li>
            <li>The decision you're trying to make, not the symptom.</li>
            <li>The horizon — when does this need to be working.</li>
          </ol>
          <p>Three sentences each is more than enough. Most of the conversation happens after we talk.</p>
        </div>
      </div>
    </Container>
  </Section>

  <Section id="expectation">
    <Container>
      <div class="max-w-[60ch] mx-auto pb-16">
        <p class="font-body text-[length:var(--t-body-s-size)] leading-[var(--t-body-s-line)] text-ink-500 italic">
          I read messages within 24 hours, Monday to Friday. I respond to most within 48. If I can't help, I'll usually say so quickly and try to point you toward someone who can.
        </p>
      </div>
    </Container>
  </Section>

  <div class="hairline max-w-[1440px] mx-auto"></div>

  <Section id="closing">
    <Container>
      <div class="py-24 text-center max-w-2xl mx-auto flex flex-col items-center">
        <Heading level={2} as="h2" class="font-light mb-16 italic text-[length:var(--t-display-m-size)]">
          <span class="block">Quiet conversations.</span>
          <span class="block">Better systems.</span>
        </Heading>
        
        <div class="w-24 h-24 rounded-full overflow-hidden border border-ink-100 shadow-card mb-6">
          <img src="/images/portrait.jpeg" alt="Yoann Leny" class="w-full h-full object-cover grayscale contrast-[1.05]" style="object-position: 50% 22%;" loading="lazy" />
        </div>
        <div class="font-display italic text-2xl text-ink-700 mb-12">
          — Yoann
        </div>
        
        <div class="font-mono text-[length:var(--t-meta-size)] uppercase tracking-[var(--t-meta-letter)] text-ink-500">
          BORDEAUX, FR · GMT+1 · LANGUAGES: EN, FR
        </div>
      </div>
    </Container>
  </Section>
</Layout>
