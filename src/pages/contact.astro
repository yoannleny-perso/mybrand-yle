---
import Layout from '../layouts/Layout.astro';
import Container from '../components/layout/Container.astro';
import Section from '../components/layout/Section.astro';
import Grid from '../components/layout/Grid.astro';
import Eyebrow from '../components/primitives/Eyebrow.astro';
import Heading from '../components/primitives/Heading.astro';
import { EnvelopeSimple, LinkedinLogo, CalendarBlank } from '@phosphor-icons/react';
---

<Layout title="Contact — Yoann Leny" description="Three ways to engage: architect-in-residence, executive advisory, diagnostic and rebuild plan. Direct contact and current availability.">
  
  <Section id="header">
    <Container>
      <div class="pt-24 pb-16">
        <Eyebrow text="CONTACT" />
        <Heading level={2} as="h1" class="mb-6 italic">
          The fastest way is direct.
        </Heading>
        <p class="font-body text-[length:var(--t-body-l-size)] leading-[var(--t-body-l-line)] text-ink-700 max-w-[60ch]">
          Three paths below — pick whichever fits the conversation you want to have. I read every message myself.
        </p>
      </div>
    </Container>
  </Section>

  <Section id="paths">
    <Container>
      <Grid columns={12} gap="loose">
        <div class="col-span-12 md:col-span-4 p-8 border border-ink-100 bg-paper-0 shadow-[var(--shadow-card)] rounded-[var(--radius-card)] hover:shadow-hover transition-all duration-300 hover:-translate-y-1">
          <EnvelopeSimple size={24} weight="regular" className="mb-6 text-ink-1000" />
          <div class="font-mono text-[length:var(--t-meta-size)] uppercase tracking-[var(--t-meta-letter)] text-ink-500 mb-2">DIRECT EMAIL</div>
          <Heading level={4} as="h3" serif={false} class="mb-4">
            <a href="mailto:yoann.leny@gmail.com" class="hover:text-signal transition-colors text-ink-900 font-semibold break-all">yoann.leny@gmail.com</a>
          </Heading>
          <p class="font-body text-[length:var(--t-body-s-size)] leading-[var(--t-body-s-line)] text-ink-700">
            For introductions, project briefs, and longer messages. Best for senior conversations.
          </p>
        </div>

        <div class="col-span-12 md:col-span-4 p-8 border border-ink-100 bg-paper-0 shadow-[var(--shadow-card)] rounded-[var(--radius-card)] hover:shadow-hover transition-all duration-300 hover:-translate-y-1">
          <LinkedinLogo size={24} weight="regular" className="mb-6 text-ink-1000" />
          <div class="font-mono text-[length:var(--t-meta-size)] uppercase tracking-[var(--t-meta-letter)] text-ink-500 mb-2">LINKEDIN</div>
          <Heading level={4} as="h3" serif={false} class="mb-4">
            <a href="https://www.linkedin.com/in/yoann-leny-10144b37/" target="_blank" rel="noopener noreferrer" class="hover:text-signal transition-colors text-ink-900 font-semibold break-all">linkedin.com/in/yoann-leny</a>
          </Heading>
          <p class="font-body text-[length:var(--t-body-s-size)] leading-[var(--t-body-s-line)] text-ink-700">
            For peers, recruiters, and networking. Lower priority than email.
          </p>
        </div>

        <div class="col-span-12 md:col-span-4 p-8 border border-ink-100 bg-paper-0 shadow-[var(--shadow-card)] rounded-[var(--radius-card)] hover:shadow-hover transition-all duration-300 hover:-translate-y-1">
          <CalendarBlank size={24} weight="regular" className="mb-6 text-ink-1000" />
          <div class="font-mono text-[length:var(--t-meta-size)] uppercase tracking-[var(--t-meta-letter)] text-ink-500 mb-2">30-MINUTE CALL</div>
          <Heading level={4} as="h3" serif={false} class="mb-4">
            <a href="#" class="hover:text-signal transition-colors text-ink-900 font-semibold">Book directly</a>
          </Heading>
          <p class="font-body text-[length:var(--t-body-s-size)] leading-[var(--t-body-s-line)] text-ink-700">
            A pre-screened slot for serious project conversations. Use the email path first if it's a longer brief.
          </p>
        </div>
      </Grid>
    </Container>
  </Section>

  <Section id="what-to-include">
    <Container>
      <div class="max-w-[60ch] mx-auto py-16">
        <Eyebrow text="IF WE'RE LIKELY TO WORK TOGETHER" />
        <div class="font-body text-[length:var(--t-body-size)] leading-[var(--t-body-line)] text-ink-1000 space-y-6">
          <p>A useful first message usually contains four things:</p>
          <ol class="list-decimal pl-5 space-y-2 text-ink-700">
            <li>Where the company is today — stage, size, sector.</li>
            <li>What you've already tried.</li>
            <li>The decision you're trying to make, not the symptom.</li>
            <li>The horizon — when does this need to be working.</li>
          </ol>
          <p>Three sentences each is more than enough. Most of the conversation happens after we talk.</p>
        </div>
      </div>
    </Container>
  </Section>

  <Section id="expectation">
    <Container>
      <div class="max-w-[60ch] mx-auto pb-16">
        <p class="font-body text-[length:var(--t-body-s-size)] leading-[var(--t-body-s-line)] text-ink-500 italic">
          I read messages within 24 hours, Monday to Friday. I respond to most within 48. If I can't help, I'll usually say so quickly and try to point you toward someone who can.
        </p>
      </div>
    </Container>
  </Section>

  <div class="hairline max-w-[1440px] mx-auto"></div>

  <Section id="closing">
    <Container>
      <div class="py-24 text-center max-w-2xl mx-auto flex flex-col items-center">
        <Heading level={2} as="h2" class="font-light mb-16 italic text-[length:var(--t-display-m-size)]">
          <span class="block">Quiet conversations.</span>
          <span class="block">Better systems.</span>
        </Heading>
        
        <div class="w-32 h-32 bg-ink-100 rounded-full mb-6 relative overflow-hidden grayscale">
          {/* Portrait Placeholder */}
          <div class="absolute inset-0 bg-ink-300 opacity-20"></div>
          <div class="absolute inset-0 bg-[url('data:image/svg+xml;base64,PHN2ZyB4bWxucz0iaHR0cDovL3d3dy53My5vcmcvMjAwMC9zdmciIHdpZHRoPSI0IiBoZWlnaHQ9IjQiPjxyZWN0IHdpZHRoPSI0IiBoZWlnaHQ9IjQiIGZpbGw9IiMwMDAiIGZpbGwtb3BhY2l0eT0iMC4wNCIvPjwvc3ZnPg==')] mix-blend-overlay"></div>
        </div>
        
        <div class="font-display italic text-2xl text-ink-700 mb-12">
          — Yoann
        </div>
        
        <div class="font-mono text-[length:var(--t-meta-size)] uppercase tracking-[var(--t-meta-letter)] text-ink-500">
          BORDEAUX, FR · GMT+1 · LANGUAGES: EN, FR
        </div>
      </div>
    </Container>
  </Section>
</Layout>
