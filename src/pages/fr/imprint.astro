---
import Layout from '../../layouts/Layout.astro';
import Container from '../../components/layout/Container.astro';
import Section from '../../components/layout/Section.astro';
import Eyebrow from '../../components/primitives/Eyebrow.astro';
---

<Layout title="Mentions légales — Yoann Leny" description="Mentions légales de yoannleny.com.">
  <Section id="imprint">
    <Container size="narrow">
      <div class="pt-24 pb-16 max-w-[70ch]">
        <Eyebrow text="MENTIONS LÉGALES" />
        <h1 class="font-display font-black text-ink-900 mt-4 mb-10 leading-[1.08] tracking-[-0.03em]"
            style="font-size: clamp(2rem, 4vw, 3rem);">
          Mentions légales.
        </h1>
        <div class="font-body text-[1.0625rem] leading-[1.75] text-ink-700 space-y-6">
          <p><strong class="text-ink-900">Éditeur.</strong> Yoann Leny, Bordeaux, France.</p>
          <p><strong class="text-ink-900">Contact.</strong> <a href="mailto:yoann.leny@gmail.com" class="text-signal underline decoration-signal/30 underline-offset-4 hover:text-ink-900 transition-colors">yoann.leny@gmail.com</a></p>
          <p><strong class="text-ink-900">Contenu.</strong> Tout le contenu de ce site — essais, entrées de la bibliothèque de concepts, études de cas — est rédigé et maintenu par Yoann Leny, sauf mention contraire. Les opinions n'engagent que moi.</p>
          <p><strong class="text-ink-900">Marques.</strong> Les noms de produits et d'entreprises cités (Databricks, Snowflake, dbt et autres) sont des marques de leurs propriétaires respectifs, référencées à des fins d'identification uniquement.</p>
        </div>
      </div>
    </Container>
  </Section>
</Layout>
