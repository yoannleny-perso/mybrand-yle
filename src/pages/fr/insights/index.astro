---
import Layout from '../../../layouts/Layout.astro';
import Container from '../../../components/layout/Container.astro';
import Section from '../../../components/layout/Section.astro';
import Grid from '../../../components/layout/Grid.astro';
import Eyebrow from '../../../components/primitives/Eyebrow.astro';
import Heading from '../../../components/primitives/Heading.astro';

const filters = [
  { key: "all", display: "TOUS" },
  { key: "AGENTIC AI", display: "IA AGENTIQUE" },
  { key: "DATA ARCHITECTURE", display: "ARCHITECTURE DE DONNÉES" },
  { key: "DATA ENGINEERING", display: "INGÉNIERIE DE DONNÉES" },
  { key: "BI & ANALYTICS", display: "BI & DÉCISIONNEL" },
  { key: "OPERATING MODEL", display: "MODÈLE OPÉRATIONNEL" },
  { key: "EXECUTIVE", display: "EXÉCUTIF" }
];

const essays = [
  {
    cluster: "AGENTIC AI",
    title: "Pour des garde-fous déterministes",
    dek: "La moitié ennuyeuse de la conception d'agents d'IA qui décide si la moitié magique sera un jour mise en production.",
    meta: "9 MIN · MARS 2026",
    href: "/fr/insights/the-case-for-deterministic-guardrails"
  },
  {
    cluster: "DATA ARCHITECTURE",
    title: "Lakehouse, warehouse, mesh — ce qui change réellement pour l'entreprise",
    dek: "Un arbre de décision concis, pas un débat théologique.",
    meta: "11 MIN · FÉVRIER 2026",
    href: "/fr/insights/lakehouse-warehouse-mesh"
  },
  {
    cluster: "OPERATING MODEL",
    title: "Organiser les équipes pour des opérations agentiques",
    dek: "Quand les agents d'IA s'occupent de l'exécution, votre organigramme est faux par défaut.",
    meta: "13 MIN · FÉVRIER 2026",
    href: "/fr/insights/designing-teams-for-agentic-operations"
  },
  {
    cluster: "BI & ANALYTICS",
    title: "La couche sémantique est la nouvelle API de données",
    dek: "Pourquoi vos indicateurs (KPI) ont besoin d'un contrat avant que vos agents ne les lisent.",
    meta: "8 MIN · JANVIER 2026",
    href: "/fr/insights/the-semantic-layer-is-the-new-data-api"
  },
  {
    cluster: "EXECUTIVE",
    title: "Dix chiffres qui devraient figurer sur le tableau de bord de chaque PDG",
    dek: "Et les quarante qui ne le devraient pas.",
    meta: "7 MIN · JANVIER 2026",
    href: "/fr/insights/ten-numbers-ceo-dashboard"
  },
  {
    cluster: "DATA ENGINEERING",
    title: "La demi-vie d'un stack de données est plus courte que vous ne le pensez",
    dek: "Les choix d'architecture faits aujourd'hui ont un horizon de quatre ans, pas de dix.",
    meta: "10 MIN · DÉCEMBRE 2025",
    href: "/fr/insights/half-life-of-data-stack"
  },
  {
    cluster: "AGENTIC AI",
    title: "Les appels d'outils ne sont pas des fonctionnalités. Les outils sont des produits.",
    dek: "Traiter les outils comme des produits fait la différence entre une démonstration astucieuse et un système gouvernable.",
    meta: "9 MIN · DÉCEMBRE 2025",
    href: "/fr/insights/tools-are-products"
  },
  {
    cluster: "OPERATING MODEL",
    title: "La donnée en tant que produit, trois ans plus tard",
    dek: "Ce qui a fonctionné, ce qui a échoué et ce que la littérature spécialisée comprend toujours de travers.",
    meta: "12 MIN · NOVEMBRE 2025",
    href: "/fr/insights/data-as-a-product-three-years-on"
  }
];
---

<Layout title="Analyses & Essais — Yoann Leny" description="Essais sur l'architecture des données, l'IA agentique et le modèle opérationnel sous-jacent. Mis à jour régulièrement.">
  
  <Section id="header">
    <Container>
      <div class="pt-24 pb-16">
        <Eyebrow text="ANALYSES & ESSAIS" />
        <h1 class="font-display font-black text-ink-900 mt-4 mb-6 leading-[1.08] tracking-[-0.03em]"
            style="font-size: clamp(2.5rem, 5vw, 4rem);">
          L'écriture est ma façon de penser.
        </h1>
        <p class="font-body text-[1.125rem] leading-[1.75] text-ink-700 max-w-[55ch]">
          Essais sur les questions déterminantes pour la réussite des initiatives données et IA : modèles opérationnels, choix d'architecture et systèmes organisationnels qui les unissent. Pour des ressources de référence sur des concepts précis, consultez la <a href="/fr/concepts" class="text-signal underline decoration-signal/30 underline-offset-4 hover:text-ink-900 transition-colors">bibliothèque de concepts</a>.
        </p>
      </div>
    </Container>
  </Section>

  <!-- FEATURED ESSAY -->
  <Section id="featured">
    <Container>
      <a href="/fr/insights/why-most-agent-demos-collapse-in-production" class="group block relative overflow-hidden bg-ink-900 rounded-[20px] mb-16 p-10 md:p-16 hover:bg-ink-1000 transition-colors duration-400 shadow-sm hover:shadow-[0_16px_40px_rgba(0,0,0,0.2)]">
                <svg viewBox="0 0 400 300" fill="none" aria-hidden="true"
             class="absolute top-0 right-0 h-full w-auto opacity-50 pointer-events-none hidden md:block">
          <g class="drift">
            <circle cx="300" cy="60" r="5" stroke="#4B5563" stroke-width="1" />
            <circle cx="360" cy="130" r="7" stroke="#4B5563" stroke-width="1" />
            <circle cx="250" cy="150" r="4" stroke="#4B5563" stroke-width="1" />
            <circle cx="320" cy="230" r="6" stroke="#4B5563" stroke-width="1" />
            <circle cx="210" cy="250" r="4" stroke="#4B5563" stroke-width="1" />
            <circle cx="150" cy="90" r="3" stroke="#4B5563" stroke-width="1" />
          </g>
          <path d="M305 64 L355 124" stroke="#6366F1" stroke-width="1" class="flow-line" />
          <path d="M354 136 L256 148" stroke="#4B5563" stroke-width="1" class="flow-line" />
          <path d="M253 154 L316 225" stroke="#6366F1" stroke-width="1" class="flow-line" />
          <path d="M314 232 L215 248" stroke="#4B5563" stroke-width="1" class="flow-line" />
          <path d="M247 147 L155 93" stroke="#4B5563" stroke-width="1" class="flow-line" />
          <path d="M297 63 L154 88" stroke="#6366F1" stroke-width="1" class="flow-line" />
        </svg>
        <div class="relative z-10">
          <div class="font-mono text-[0.6875rem] font-bold uppercase tracking-[0.1em] text-signal mb-8 flex items-center gap-4">
            <span class="w-8 h-[2px] bg-signal inline-block"></span>
            À LA UNE · IA AGENTIQUE
          </div>
          <h2 class="font-display font-bold text-white text-[2rem] leading-[1.15] mb-6 max-w-3xl group-hover:text-signal transition-colors">
            Pourquoi la plupart des démonstrations d'agents s'effondrent en production.
          </h2>
          <p class="font-body text-[1.125rem] leading-[1.75] text-ink-300 max-w-2xl mb-12">
            Les systèmes probabilistes peuvent être construits en un week-end. Les systèmes gouvernables prennent un un. C'est dans cet écart que la plupart des initiatives d'IA échouent silencieusement.
          </p>
          <div class="font-mono text-[0.6875rem] font-bold uppercase tracking-[0.1em] text-ink-500 border-t border-ink-800 pt-6 flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4">
            <span>14 MIN DE LECTURE · DERNIÈRE RÉVISION EN MARS 2026</span>
            <span class="text-signal flex items-center gap-2 group-hover:gap-3 transition-all">Lire l'essai <span aria-hidden="true">&rarr;</span></span>
          </div>
        </div>
      </a>
    </Container>
  </Section>

  <!-- ESSAY GRID -->
  <Section id="essays">
    <Container>
      <!-- Filter Row -->
      <div class="mb-16 border-b border-ink-100 pb-4 overflow-x-auto">
        <div class="flex gap-8 font-mono text-[length:var(--t-meta-size)] uppercase tracking-[var(--t-meta-letter)] min-w-max" id="insight-filters">
          {filters.map((filter, i) => (
            <button 
              class={`filter-btn transition-colors py-3 cursor-pointer ${i === 0 ? 'text-ink-1000 border-b border-ink-1000' : 'text-ink-500 hover:text-ink-1000'}`}
              data-filter={filter.key}
            >
              {filter.display}
            </button>
          ))}
        </div>
      </div>

      <Grid columns={12} gap="loose">
        {essays.map(essay => (
          <a href={essay.href} data-cluster={essay.cluster} class="insight-card group col-span-12 md:col-span-6 lg:col-span-4 flex flex-col justify-between p-8 border border-ink-100 bg-paper-0 rounded-[var(--radius-sm)] shadow-[var(--shadow-card)] hover:-translate-y-1 hover:shadow-hover transition-all duration-300 min-h-[300px]">
            <div>
              <div class="font-mono text-[length:var(--t-meta-size)] uppercase tracking-[var(--t-meta-letter)] text-ink-500 mb-6">
                {essay.cluster}
              </div>
              <h3 class="font-display font-semibold text-[1.375rem] leading-[1.3] tracking-[-0.01em] text-ink-1000 mb-4 group-hover:text-signal transition-colors duration-200">
                {essay.title}
              </h3>
              <p class="font-body text-[length:var(--t-body-s-size)] leading-[var(--t-body-s-line)] text-ink-700">
                {essay.dek}
              </p>
            </div>
            <div class="font-mono text-[length:var(--t-meta-size)] uppercase tracking-[var(--t-meta-letter)] text-ink-500 mt-8 pt-4 border-t border-ink-100">
              {essay.meta}
            </div>
          </a>
        ))}
      </Grid>
    </Container>
  </Section>

  <div class="hairline max-w-[1440px] mx-auto my-16"></div>

  <!-- CONCEPT LIBRARY CROSS-LINK -->
  <Section id="reference">
    <Container>
      <div class="max-w-2xl mx-auto text-center py-8">
        <div class="font-mono text-[0.6875rem] font-bold uppercase tracking-[0.1em] text-ink-500 mb-6">RÉFÉRENCE</div>
        <h2 class="font-display font-bold text-ink-900 mt-4 mb-6 leading-[1.15] tracking-[-0.02em]"
            style="font-size: clamp(1.5rem, 3vw, 2.25rem);">
          Besoin d'une définition plutôt que d'une opinion ?
        </h2>
        <p class="font-body text-[1rem] leading-[1.7] text-ink-700 mb-8">
          La <a href="/fr/concepts" class="text-signal font-semibold hover:text-ink-900 underline decoration-signal/30 underline-offset-4 transition-colors">bibliothèque de concepts</a> regroupe le matériel de référence — définitions, comparaisons d'outils et modèles d'architecture. Plus de 50 fiches couvrant l'architecture des données, l'ingénierie des données, la BI et l'IA agentique.
        </p>
        <a href="/fr/concepts" class="font-mono text-[0.6875rem] font-bold uppercase tracking-[0.1em] text-ink-900 hover:text-signal transition-colors inline-flex items-center gap-2">
          Parcourir la bibliothèque de concepts <span aria-hidden="true">&rarr;</span>
        </a>
      </div>
    </Container>
  </Section>

  <Section id="closing" background="ink">
    <Container>
      <div class="py-24 text-center max-w-4xl mx-auto">
        <h2 class="font-display font-black text-paper-50 mb-12 leading-[1.08] tracking-[-0.03em]"
            style="font-size: clamp(2rem, 4vw, 3rem);">
          <span class="block text-ink-300 font-medium text-[0.8em] mb-4">Si un contenu vous est utile — faites-le moi savoir.</span>
          <span class="block">Si quelque chose est erroné — dites-le moi aussi.</span>
        </h2>
        <div class="flex flex-col sm:flex-row items-center justify-center gap-6 font-mono text-[0.6875rem] font-bold uppercase tracking-[0.1em]">
          <a href="mailto:yoann.leny@gmail.com" class="bg-signal text-white px-8 py-4 rounded-xl hover:bg-signal/90 hover:-translate-y-1 hover:shadow-[0_8px_24px_rgba(99,102,241,0.25)] transition-all duration-300">M'envoyer un email direct &rarr;</a>
        </div>
      </div>
    </Container>
  </Section>
</Layout>

<script>
  // Simple client-side filtering
  const buttons = document.querySelectorAll('.filter-btn');
  const cards = document.querySelectorAll('.insight-card');

  buttons.forEach(btn => {
    btn.addEventListener('click', () => {
      // Update active button state
      buttons.forEach(b => {
        b.classList.remove('text-ink-1000', 'border-b', 'border-ink-1000');
        b.classList.add('text-ink-500');
      });
      btn.classList.add('text-ink-1000', 'border-b', 'border-ink-1000');
      btn.classList.remove('text-ink-500');

      const filterValue = btn.getAttribute('data-filter');

      // Filter cards
      cards.forEach((card: any) => {
        if (filterValue === 'all') {
          card.style.display = 'flex';
        } else {
          const cluster = card.getAttribute('data-cluster');
          if (cluster === filterValue) {
            card.style.display = 'flex';
          } else {
            card.style.display = 'none';
          }
        }
      });
    });
  });
</script>
