---
import Layout from '../../layouts/Layout.astro';
import Container from '../../components/layout/Container.astro';
import Section from '../../components/layout/Section.astro';
import Grid from '../../components/layout/Grid.astro';
import Eyebrow from '../../components/primitives/Eyebrow.astro';
import Heading from '../../components/primitives/Heading.astro';
import MetricBlock from '../../components/primitives/MetricBlock.astro';
import Hero from '../../components/sections/Hero.tsx';
import CapabilityList from '../../components/sections/CapabilityList.tsx';
import AsymmetricCard from '../../components/sections/AsymmetricCard.astro';
import TestimonialCrossfade from '../../components/sections/TestimonialCrossfade.tsx';
import OsBlueprint from '../../components/visuals/OsBlueprint.astro';

const heroHeadline = [
  "Bâtir",
  "des Systèmes d'Exploitation IA",
  "pour les Organisations Modernes."
];

const capabilities = [
  {
    number: "01",
    title: "Architecture d'IA Agentique",
    summary: "Systèmes multi-agents dotés de garde-fous déterministes et de pistes d'audit.",
    slug: "agentic-ai-architecture"
  },
  {
    number: "02",
    title: "Plateformes de Données & Sémantiques",
    summary: "Lakehouses Medallion surmontés d'une couche sémantique gouvernée.",
    slug: "data-platforms"
  },
  {
    number: "03",
    title: "Opérations Stratégiques des Données",
    summary: "La donnée traitée comme un produit avec contrats, SLA et lignage.",
    slug: "strategic-data-ops"
  },
  {
    number: "04",
    title: "Orchestration d'Équipe",
    summary: "Conception de pôles, rôles et rituels s'adaptant à plus de 40 experts.",
    slug: "team-orchestration"
  },
  {
    number: "05",
    title: "Activation Exécutive",
    summary: "Transformer les questions de leadership en décisions opérationnelles observables.",
    slug: "executive-enablement"
  }
];

const testimonials = [
  {
    quote: "\"Yoann est ce dirigeant rare capable de se tenir au tableau blanc avec des ingénieurs le matin, et devant le comité de direction l'après-midi — tout en faisant avancer les deux réunions.\"",
    attribution: "PDG, Cabinet de conseil mondial"
  },
  {
    quote: "\"Il n'a pas seulement modernisé notre infrastructure de données. Il nous a fourni un modèle opérationnel que le prochain CTO héritera sans avoir à le redessiner.\"",
    attribution: "Directeur des Données, Groupe industriel"
  },
  {
    quote: "\"Ce qu'il appelle 'retenue', nous l'appelons 'enfin voir le signal'. Yoann supprime plus qu'il n'ajoute, et c'est exactement ce dont les équipes de direction ont besoin.\"",
    attribution: "Associé, Cabinet de conseil en stratégie"
  }
];
---

<Layout title="Yoann Leny — Architecte d'Opérations de Données et d'IA Agentique" description="Yoann Leny conçoit des systèmes d'exploitation basés sur l'IA pour les organisations modernes.">
  <!-- SECTION 1 — HERO -->
  <Hero
    client:load
    headlineLines={heroHeadline}
    subheadline="J'aide les entreprises à transformer les données, l'IA et l'humain en un avantage opérationnel mesurable."
    eyebrow="Opérateur. Architecte. Bâtisseur."
    primaryCta={{ label: "Discutons", href: "/fr/contact" }}
    secondaryCta={{ label: "Voir les projets", href: "/fr/work" }}
    identity={{ name: "Yoann Leny", line: "VP Data & IA · Bordeaux, FR", href: "/fr/about" }}
  />

  <!-- LE SYSTÈME D'EXPLOITATION, DESSINÉ -->
  <section class="scroll-reveal hidden sm:block pt-8 pb-16 md:pb-24">
    <Container>
      <OsBlueprint labels={{
        data: "FONDATION DE DONNÉES",
        semantic: "CONTRAT SÉMANTIQUE",
        agents: "EXÉCUTION AGENTIQUE",
        decisions: "DÉCISIONS",
        caption: "UN SYSTÈME · QUATRE COUCHES · CHAQUE COUCHE GOUVERNÉE"
      }} />
    </Container>
  </section>

  <div class="hairline max-w-[1440px] mx-auto"></div>

  <!-- SECTION 2 — ABOUT + METRICS -->
  <Section id="about">
    <Container>
      <div class="mb-10">
        <Eyebrow text="02 / 08 — APPROCHE" />
      </div>

      <Grid columns={12}>
        <div class="col-span-12 lg:col-span-6 flex flex-col gap-8 mb-16 lg:mb-0">
          <h2 class="font-display font-black text-ink-900 max-w-[14ch] leading-[1.08] tracking-[-0.03em]"
              style="font-size: clamp(2.25rem, 4.5vw, 3.75rem);">
            Je bâtis les systèmes<br />
            <span class="text-signal">qui font grandir les équipes.</span>
          </h2>

          <div class="flex flex-col gap-6 max-w-[55ch]">
            <p class="font-body text-[1.125rem] leading-[1.75] text-ink-700">
              J'ai passé la dernière décennie à l'intersection du data engineering, de l'architecture IA et des opérations exécutives — bâtissant les plateformes, les flux de travail agentiques et les structures d'équipe qui transforment le potentiel technique en marge cumulée.
            </p>
            <p class="font-body text-[1.125rem] leading-[1.75] text-ink-700">
              La plupart des organisations n'ont pas un problème d'outils. Elles ont un problème de <em class="text-ink-900 not-italic font-semibold">système d'exploitation</em>. Les outils sont faciles. C'est la manière dont les décisions, les données, les modèles et les personnes s'assemblent en un tout fonctionnel — c'est là que réside l'effet de levier.
            </p>
          </div>

          <a href="/fr/work"
             class="inline-flex items-center gap-2 font-mono text-[0.6875rem] font-bold uppercase tracking-[0.12em] text-ink-900 border-b-2 border-signal pb-1 w-fit hover:text-signal transition-colors duration-200">
            Voir comment ça fonctionne <span class="text-base">→</span>
          </a>
        </div>

        <div class="col-span-12 lg:col-span-5 lg:col-start-8 flex items-start lg:items-center">
          <div class="grid grid-cols-2 gap-x-4 gap-y-6 w-full">
            <MetricBlock label="Impact financier généré" value="13M$+" size="large" />
            <MetricBlock label="Experts orchestrés" value="40+" size="large" />
            <MetricBlock label="Régions dirigées" value="3" size="large" />
            <MetricBlock label="Hausse de productivité" value="+15%" size="large" />
          </div>
        </div>
      </Grid>
    </Container>
  </Section>

  <div class="hairline max-w-[1440px] mx-auto"></div>

  <!-- SECTION 3 — CAPABILITIES -->
  <Section id="capabilities">
    <Container>
      <div class="mb-12 max-w-3xl">
        <Eyebrow text="03 / 08 — COMPÉTENCES" />
        <h2 class="font-display font-black text-ink-900 mt-4 mb-5 leading-[1.1] tracking-[-0.025em]"
            style="font-size: clamp(2rem, 4vw, 3rem);">
          Voici comment je structure les organisations.
        </h2>
        <p class="font-body text-[1.125rem] leading-[1.7] text-ink-700 max-w-[52ch]">
          Cinq pratiques, une logique opérationnelle. Chaque ligne est un système que j'ai construit et exploité en production — pas une méthodologie théorique.
        </p>
      </div>
    </Container>
    
    <div class="max-w-[1440px] mx-auto">
      <CapabilityList client:visible capabilities={capabilities} basePath="/fr/capabilities" />
    </div>
  </Section>

  <div class="hairline max-w-[1440px] mx-auto"></div>

  <!-- SECTION 4 — SELECTED WORK -->
  <Section id="work">
    <Container>
      <div class="mb-12">
        <Eyebrow text="04 / 08 — PROJETS SÉLECTIONNÉS" />
        <h2 class="font-display font-black text-ink-900 mt-4 leading-[1.08] tracking-[-0.03em]"
            style="font-size: clamp(2rem, 4vw, 3rem);">
          <span class="block">Travail en production.</span>
          <span class="block text-ink-500 font-medium">Résultats mesurés.</span>
        </h2>
      </div>

      <Grid columns={12} gap="loose">
        <AsymmetricCard
          size="tall"
          pattern="agents"
          tag="2025 · ENTREPRISE · 18 MOIS"
          title="Suivi des compétences multi-agents"
          description="Un système agentique hiérarchique qui maintient un graphe de compétences en direct pour plus de 40 consultants, recommande le personnel et signale chaque semaine les besoins de recrutement à la direction."
          metrics={[
            { value: "+15%", label: "utilisation" },
            { value: "-22%", label: "temps de banc" },
            { value: "3", label: "régions" }
          ]}
          href="/fr/work/multi-agent-skill-tracker"
        />

        <AsymmetricCard
          size="wide"
          pattern="layers"
          tag="2024 · MONDIAL · 12 MOIS"
          title="Architecture Medallion d'Entreprise"
          description="Une architecture de lakehouse bronze-argent-or déployée dans trois régions, avec une couche sémantique gouvernée alimentant les analyses, le ML et les flux d'agents à partir d'une source unique de vérité."
          metrics={[
            { value: "13M$+", label: "impact revenu" },
            { value: "9 mois", label: "de retour" },
            { value: "0", label: "dérive de KPI" }
          ]}
          href="/fr/work/enterprise-medallion-stack"
        />

        <AsymmetricCard
          size="square"
          pattern="semantic"
          tag="2024 · PME / ETI · 6 MOIS"
          title="Couche Sémantique prête pour l'IA"
          description="Une couche de définition de métriques conçue spécifiquement pour la consommation par les LLM et les agents, éliminant les dérives de KPI et standardisant la façon dont l'IA interroge l'entreprise."
          metrics={[
            { value: "0", label: "dérive de KPI" },
            { value: "47", label: "métriques conformes" },
            { value: "4", label: "systèmes LLM" }
          ]}
          href="/fr/work/ai-ready-semantic-layer"
        />

        <AsymmetricCard
          size="wide"
          pattern="org"
          tag="2023 · MONDIAL · 24 MOIS"
          title="Modèle de mise à l'échelle Global Data Ops"
          description="Un modèle d'exploitation pour une équipe de données de 40 personnes répartie sur trois régions : conception de pôles, répartition des rôles, rituels et une couche d'observabilité interne personnalisée pour la santé de la livraison."
          metrics={[
            { value: "40+", label: "experts" },
            { value: "3", label: "régions" },
            { value: "4 T", label: "vers régime stable" }
          ]}
          href="/fr/work/global-data-ops-scaling-model"
        />
      </Grid>
      
      <div class="mt-16 text-right">
        <a href="/fr/work" class="font-mono text-[length:var(--t-meta-size)] uppercase tracking-[var(--t-meta-letter)] text-ink-1000 hover:text-ink-500 transition-colors">
          &rarr; Voir tous les projets
        </a>
      </div>
    </Container>
  </Section>

  <div class="hairline max-w-[1440px] mx-auto"></div>

  <!-- SECTION 5 — LEADERSHIP PHILOSOPHY -->
  <Section id="philosophy">
    <Container>
      <Eyebrow text="05 / 08 — PHILOSOPHIE" />

      <div class="max-w-[42ch] mx-auto text-center my-12 md:my-16">
        <p class="font-display font-semibold italic text-ink-900 leading-[1.35] tracking-[-0.02em]"
           style="font-size: clamp(1.25rem, 2.5vw, 1.875rem);">
          Les organisations modernes ne faillent pas par manque d'outils.<br />
          Elles faillent parce qu'elles manquent d'un système d'exploitation capable de transformer ces outils en décisions.
        </p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 md:gap-6">
        <div class="flex flex-col gap-4 bg-[var(--surface-indigo)] rounded-2xl p-8 border border-indigo-100">
          <div class="w-8 h-[3px] rounded-full bg-signal"></div>
          <h3 class="font-display font-bold text-[1.125rem] text-ink-900 leading-snug">La donnée est un produit, pas un service.</h3>
          <p class="font-body text-[0.9375rem] leading-relaxed text-ink-700">Propriétaires, contrats, SLA, politiques de dépréciation — comme tout produit digne d'être exploité.</p>
        </div>
        <div class="flex flex-col gap-4 bg-[var(--surface-blue)] rounded-2xl p-8 border border-blue-100">
          <div class="w-8 h-[3px] rounded-full bg-blue-500"></div>
          <h3 class="font-display font-bold text-[1.125rem] text-ink-900 leading-snug">L'IA doit élever les équipes au rang d'architectes.</h3>
          <p class="font-body text-[0.9375rem] leading-relaxed text-ink-700">Les agents gèrent l'exécution. Les humains définissent les règles que l'exécution doit respecter.</p>
        </div>
        <div class="flex flex-col gap-4 bg-[var(--surface-green)] rounded-2xl p-8 border border-emerald-100">
          <div class="w-8 h-[3px] rounded-full bg-emerald-500"></div>
          <h3 class="font-display font-bold text-[1.125rem] text-ink-900 leading-snug">La visibilité opérationnelle est un atout stratégique.</h3>
          <p class="font-body text-[0.9375rem] leading-relaxed text-ink-700">Si un dirigeant ne peut pas voir le système, il ne peut pas le gouverner.</p>
        </div>
        <div class="flex flex-col gap-4 bg-[var(--surface-purple)] rounded-2xl p-8 border border-purple-100">
          <div class="w-8 h-[3px] rounded-full bg-purple-500"></div>
          <h3 class="font-display font-bold text-[1.125rem] text-ink-900 leading-snug">Les systèmes étendent ce que le talent seul ne peut pas.</h3>
          <p class="font-body text-[0.9375rem] leading-relaxed text-ink-700">Le recrutement résout le débit pour un trimestre. Les systèmes le résolvent pour toujours.</p>
        </div>
      </div>
    </Container>
  </Section>

  <div class="hairline max-w-[1440px] mx-auto"></div>

  <!-- SECTION 6 — INSIGHTS / WRITING -->
  <Section id="insights">
    <Container>
      <div class="mb-10">
        <Eyebrow text="06 / 08 — RÉFLEXIONS" />
        <h2 class="font-display font-black text-ink-900 mt-4 mb-4 leading-[1.1] tracking-[-0.025em]"
            style="font-size: clamp(2rem, 4vw, 3rem);">L'écriture est ma façon de penser.</h2>
        <p class="font-body text-[1.125rem] leading-[1.7] text-ink-700 max-w-[52ch]">
          Essais et fiches conceptuelles sur l'architecture des données, l'IA agentique et les questions de modèle opérationnel qui déterminent leur succès.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-5">
        <a href="/fr/insights" class="group flex flex-col justify-between gap-6 p-8 rounded-2xl bg-[var(--surface-indigo)] border border-indigo-100 hover:shadow-[0_8px_32px_rgba(99,102,241,0.15)] hover:-translate-y-1 transition-all duration-300 min-h-[280px]">
          <div class="flex flex-col gap-4">
            <span class="font-mono text-[0.625rem] font-bold uppercase tracking-[0.12em] text-signal">IA Agentique · 5 min de lecture</span>
            <h3 class="font-display font-bold text-[1.125rem] text-ink-900 leading-snug group-hover:text-signal transition-colors">
              Pourquoi la plupart des démos d'agents s'effondrent en production
            </h3>
            <p class="font-body text-[0.875rem] leading-relaxed text-ink-700">L'écart entre un prototype de démonstration et un système gouvernable.</p>
          </div>
          <span class="font-mono text-[0.6875rem] uppercase tracking-[0.1em] text-ink-500">2026-T1 →</span>
        </a>

        <a href="/fr/insights" class="group flex flex-col justify-between gap-6 p-8 rounded-2xl bg-[var(--surface-blue)] border border-blue-100 hover:shadow-[0_8px_32px_rgba(59,130,246,0.15)] hover:-translate-y-1 transition-all duration-300 min-h-[280px]">
          <div class="flex flex-col gap-4">
            <span class="font-mono text-[0.625rem] font-bold uppercase tracking-[0.12em] text-blue-600">Architecture de Données · 8 min de lecture</span>
            <h3 class="font-display font-bold text-[1.125rem] text-ink-900 leading-snug group-hover:text-blue-600 transition-colors">
              L'architecture Medallion, décodée
            </h3>
            <p class="font-body text-[0.875rem] leading-relaxed text-ink-700">Pourquoi bronze, argent, or n'est pas qu'une simple convention de nommage.</p>
          </div>
          <span class="font-mono text-[0.6875rem] uppercase tracking-[0.1em] text-ink-500">2026-T1 →</span>
        </a>

        <a href="/fr/insights" class="group flex flex-col justify-between gap-6 p-8 rounded-2xl bg-[var(--surface-green)] border border-emerald-100 hover:shadow-[0_8px_32px_rgba(16,185,129,0.15)] hover:-translate-y-1 transition-all duration-300 min-h-[280px]">
          <div class="flex flex-col gap-4">
            <span class="font-mono text-[0.625rem] font-bold uppercase tracking-[0.12em] text-emerald-600">BI & Décisionnel · 6 min de lecture</span>
            <h3 class="font-display font-bold text-[1.125rem] text-ink-900 leading-snug group-hover:text-emerald-600 transition-colors">
              La couche sémantique est la nouvelle API de données
            </h3>
            <p class="font-body text-[0.875rem] leading-relaxed text-ink-700">Pourquoi vos indicateurs ont besoin d'un contrat avant d'être lus par des agents.</p>
          </div>
          <span class="font-mono text-[0.6875rem] uppercase tracking-[0.1em] text-ink-500">2026-T1 →</span>
        </a>
      </div>
      
      <div class="mt-8 flex justify-end">
        <a href="/fr/concepts"
           class="inline-flex items-center gap-2 font-mono text-[0.6875rem] font-bold uppercase tracking-[0.1em] text-ink-900 hover:text-signal transition-colors">
          Parcourir toute la bibliothèque de concepts (50+) →
        </a>
      </div>
    </Container>
  </Section>

  <div class="hairline max-w-[1440px] mx-auto"></div>

  <!-- SECTION 7 — TESTIMONIALS / PROOF -->
  <Section id="testimonials">
    <Container>
      <div class="mb-8">
        <Eyebrow text="07 / 08 — LEURS MOTS" />
      </div>
      
      <TestimonialCrossfade client:visible testimonials={testimonials} />
      
      <div class="mt-12 flex justify-center">
        <a href="/fr/contact"
           class="inline-flex items-center gap-2 font-mono text-[0.6875rem] font-bold uppercase tracking-[0.1em] text-ink-900 hover:text-signal transition-colors">
          Références disponibles sur demande →
        </a>
      </div>
    </Container>
  </Section>
</Layout>
